vesitamthoi/dataset_vesitamthoi_Page1.jpg	[{"transcription": "Chuong1", "points": [[413, 100], [537, 104], [536, 135], [412, 131]], "difficult": false}, {"transcription": "Sao tren troi(l)", "points": [[314, 147], [634, 151], [634, 191], [314, 188]], "difficult": false}, {"transcription": "个", "points": [[418, 220], [438, 220], [438, 248], [418, 248]], "difficult": false}, {"transcription": "O huóng Nam Bác trong khu phǒ co luon có mot vài con duòng tuong dǒi", "points": [[127, 270], [849, 272], [849, 300], [127, 298]], "difficult": false}, {"transcription": "heo lánh, dǎc biet là noi tàp trung các cira hàng tap hóa bán do kim khí, děn cá", "points": [[97, 307], [850, 306], [850, 333], [97, 334]], "difficult": false}, {"transcription": "ánh sáng cūng bùn xin chǎng buòn chiéu vào dáy.", "points": [[96, 340], [582, 341], [582, 371], [96, 370]], "difficult": false}, {"transcription": "Cò gái trè mǎc bo váy còng sò bó sát nguòi, di giày cao gót thán trong buróc", "points": [[128, 379], [850, 379], [850, 406], [128, 406]], "difficult": false}, {"transcription": "tùng buóc khó khǎn trèn via hè xi mǎng gáp ghenh. Vùra bàt cán giǎm phái mòt", "points": [[98, 414], [851, 414], [851, 440], [98, 440]], "difficult": false}, {"transcription": "hō nhò, nuóc bàn làp túrc bán lèn tung tóe làm dòi tǎt màu da gan nhur trong", "points": [[96, 447], [853, 448], [853, 475], [96, 474]], "difficult": false}, {"transcription": "suǒt bi nhuòm luòn thành chiěc quàn bó màu den. Cò rút tò khǎn giáy ra, vùra", "points": [[99, 483], [850, 483], [850, 507], [99, 507]], "difficult": false}, {"transcription": "lau vùra chyc khóc nhìn xung quanh, cuǒi cùng cǔng tháy tǎm bien hiéu nho", "points": [[98, 516], [851, 516], [851, 543], [98, 543]], "difficult": false}, {"transcription": "nhò ghi\"Dich vu gia dinh dǎc biet Báo Bien\"nàm giua hai cùra hàng dung cu", "points": [[97, 550], [850, 551], [850, 578], [97, 577]], "difficult": false}, {"transcription": "kim khi.", "points": [[95, 583], [181, 583], [181, 611], [95, 611]], "difficult": false}, {"transcription": "Vì viec tièu chuàn hóa bò mǎt thành phǒ khoàng thòi gian truóc, bien hieu", "points": [[126, 621], [850, 622], [850, 649], [126, 648]], "difficult": false}, {"transcription": "cùa các còng ty dich vu gia dinh děu doi thành něn dò chū vàng cō lón giǒng", "points": [[98, 655], [851, 657], [851, 685], [98, 683]], "difficult": false}, {"transcription": "hét vói các cùa hàng dung cu kim khí nèn thàt sy rǎt khó tim. Co gái khòng yén", "points": [[98, 693], [849, 693], [849, 716], [98, 716]], "difficult": false}, {"transcription": "tàm lám, lày dien thoai ra xác nhàn lai mòt lan nüra:\"Co Trurong dǎy a, cò có", "points": [[98, 724], [851, 724], [851, 751], [98, 751]], "difficult": false}, {"transcription": "chác là sǒ 82 khòng?\"", "points": [[97, 756], [305, 759], [305, 787], [97, 784]], "difficult": false}, {"transcription": "\"Dung mà, òng chi là mot nguòi dàu troc, cháu vào sē nhin thǎy ngay.\"", "points": [[130, 797], [765, 797], [765, 824], [130, 824]], "difficult": false}, {"transcription": "Trong phòng bat chiec dèn soi dot tòa ánh sáng lanh lēo, bèn tròng là chiěc", "points": [[126, 834], [851, 833], [851, 861], [126, 862]], "difficult": false}, {"transcription": "sofa và quay hàng toi màu cǔ nát. Mòt cái dàu troe lǒe bóng lòn ló ra tùr sau", "points": [[98, 871], [850, 871], [850, 895], [98, 895]], "difficult": false}, {"transcription": "quay hàng khiěn nguòi ta sg het hǒn.", "points": [[96, 905], [459, 901], [459, 929], [96, 933]], "difficult": false}, {"transcription": "Nguròi dàn òng vam vō deo sqi dày chuyěn vàng to cùng chiěc vòng tay hat", "points": [[124, 942], [851, 942], [851, 969], [124, 969]], "difficult": false}, {"transcription": "óc chó chính là òng chù dǎu troc mà co Truong nói. Thay có khách hàng tói,", "points": [[95, 977], [850, 977], [850, 1003], [95, 1003]], "difficult": false}, {"transcription": "òng ta làp túc dúng dày chào hòi:\"Chào cò,cò can phuc vu gì a?\"", "points": [[94, 1011], [731, 1009], [731, 1037], [94, 1039]], "difficult": false}, {"transcription": "Co gái dè dǎt lai gǎn, nhìn trái ngó phài cūng khòng thày bàng giá dàu, chì", "points": [[123, 1048], [852, 1047], [852, 1075], [123, 1076]], "difficult": false}, {"transcription": "tháy tò giǎy phép kinh doanh ǒ vàng nàm trong khung kính tam chúng minh", "points": [[92, 1083], [853, 1082], [853, 1112], [92, 1113]], "difficult": false}, {"transcription": "cho tính hgp pháp cúa noi này.", "points": [[92, 1119], [399, 1121], [399, 1148], [92, 1146]], "difficult": false}, {"transcription": "\"Nghe nói..chǒ anh có dich vu vé sī tr nhàn phài khòng a?\"", "points": [[122, 1156], [712, 1154], [712, 1184], [122, 1186]], "difficult": false}, {"transcription": "***", "points": [[458, 1194], [490, 1194], [490, 1213], [458, 1213]], "difficult": false}, {"transcription": "Dang là giò tan hoc, truóc cōng truròng mam non vo cùng ǒn ào nhǒn nháo.", "points": [[120, 1234], [850, 1232], [850, 1259], [120, 1262]], "difficult": false}, {"transcription": "Nhūng yi phu huynh di dón con, nhūng dúa tré nò dùa duǒi bát, tiěng nguòi", "points": [[90, 1269], [849, 1266], [849, 1294], [90, 1296]], "difficult": false}, {"transcription": "bán hàng rong, bán xién nuóng oang oang chào hàng là quang cánh dǎe thù", "points": [[88, 1302], [850, 1300], [850, 1331], [88, 1333]], "difficult": false}, {"transcription": "3", "points": [[463, 1374], [480, 1374], [480, 1395], [463, 1395]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page2.jpg	[{"transcription": "ve aī ta.m thot", "points": [[452, 63], [585, 63], [585, 87], [452, 87]], "difficult": false}, {"transcription": "cùa khu dàn cur này.Chi tiěc khòng nhièu nguòi thuóng thúrc dugc dièu dó,", "points": [[152, 108], [893, 108], [893, 132], [152, 132]], "difficult": false}, {"transcription": "hiēn nhièn bà cò trèn tǎng bèn phía dǒi dien cǔng khòng nàm trong danh sách", "points": [[149, 137], [895, 139], [895, 168], [149, 167]], "difficult": false}, {"transcription": "ay. Bà ta day cùra sǒ, thò cō ra quát:\"Chay am chayi kháp phǒ, lón lèn chi có", "points": [[150, 172], [896, 171], [896, 201], [150, 202]], "difficult": false}, {"transcription": "nuóc lam ǎn xin!\"", "points": [[150, 209], [321, 207], [321, 231], [150, 233]], "difficult": false}, {"transcription": "\"Bà mói phài di ǎn xin ay!\" Cau nhóc béo tròn trùng tryc khòng chiu thua,", "points": [[182, 243], [896, 245], [896, 272], [182, 270]], "difficult": false}, {"transcription": "nháy nhót trèn chiěc ghě cày nǎm cai co vói bà ta.Thé nhung nguòi nhó mà", "points": [[153, 280], [895, 280], [895, 304], [153, 304]], "difficult": false}, {"transcription": "trong tài lón, chiěc ghě nǎm bàng nha khòng chiu nǒi，rác mot tiěng gāy luòn", "points": [[151, 312], [896, 311], [896, 341], [151, 342]], "difficult": false}, {"transcription": "chàn ghě.", "points": [[150, 343], [249, 345], [248, 377], [149, 374]], "difficult": false}, {"transcription": "\"Oi tròi oi!\" May vi phu huynh thay thě giàt minh keu len. Nhóc màp chua", "points": [[180, 380], [896, 383], [896, 413], [180, 410]], "difficult": false}, {"transcription": "kip dàp mǎt xuǒng dat dā dugc mòt cánh tay vūng vàng òm lǎy.", "points": [[154, 421], [752, 421], [752, 444], [154, 444]], "difficult": false}, {"transcription": "Dó là mòt thanh nièn curc ky dep trai, mǎc áo phòng tráng và quàn the thao", "points": [[183, 454], [896, 454], [896, 481], [183, 481]], "difficult": false}, {"transcription": "sach sē,trén nguròi deo chiěc tap de màu xanh pastel tròng khá buǒn curòi, cūng", "points": [[154, 489], [896, 489], [896, 516], [154, 516]], "difficult": false}, {"transcription": "chính là Trác Thǎn-giáo vièn nam duy nhǎt trong truròng mǎm non này.", "points": [[154, 521], [838, 523], [838, 550], [154, 548]], "difficult": false}, {"transcription": "Dien thoai di dong trong túi tap dě chot vang lèn, Trác Than kep nhóc màp", "points": [[182, 558], [895, 559], [895, 586], [182, 585]], "difficult": false}, {"transcription": "vào durói cánh tay,bam nhàn cuòc goi:\"A lò,Chu béo day à...Em á? Em dang", "points": [[154, 592], [897, 593], [897, 620], [154, 619]], "difficult": false}, {"transcription": "xùr ly mot thàng nhóc màp. Dùa chúr nó giǒng anh thàt dǎy, chi thiěu mǒi cái", "points": [[154, 627], [897, 624], [897, 651], [154, 654]], "difficult": false}, {"transcription": "dau troc nūra thoi.\"", "points": [[155, 662], [334, 660], [334, 684], [155, 687]], "difficult": false}, {"transcription": "Vùra nói anh vùra giao nhóc màp cho nguòi bà beo béo tói dón cháu, thuàn", "points": [[182, 697], [895, 694], [895, 721], [182, 723]], "difficult": false}, {"transcription": "tay vò mái tóc bát úp bù xù cùa nó mòt cái.", "points": [[153, 733], [555, 728], [555, 755], [153, 760]], "difficult": false}, {"transcription": "\"Bay giò á? Khòng thành van dě, doi chút, em děn ngay day.\"", "points": [[183, 767], [758, 764], [758, 794], [183, 797]], "difficult": false}, {"transcription": "Anh còi tap de ra, cat dièn thoai vào túi quàn, cuòi tít mát nhìn vě phía cò giáo", "points": [[183, 805], [896, 804], [896, 831], [183, 832]], "difficult": false}, {"transcription": "dung bèn canh. Khi mǎc tap dě,nguòi dàn òng cuòi nhech mép này tròng có vé rat", "points": [[154, 840], [896, 838], [896, 866], [154, 868]], "difficult": false}, {"transcription": "vò hai, nhung còi tap dě ra ty dung lai có cám giác luru manh khó tà.", "points": [[154, 877], [759, 873], [759, 897], [154, 901]], "difficult": false}, {"transcription": "\"Anh có viec thì cúr di truóc di, cūng chi còn mǎy bé nüra thòi, detòi trà là duroc.\"", "points": [[183, 912], [896, 909], [896, 936], [183, 939]], "difficult": false}, {"transcription": "Co giáo dò bùng mǎt, khòng doi anh cǎt lòi dā chú dòng òm vièc vào minh.", "points": [[154, 948], [831, 944], [831, 970], [154, 975]], "difficult": false}, {"transcription": "Cam on nguòi dǒng nghiep tǒt bung xong, Trác Than quay vě phía khu dǒ", "points": [[180, 983], [898, 979], [898, 1009], [180, 1012]], "difficult": false}, {"transcription": "choi, búng tay cái tách:\"Mòng Mòng,di thòi!\"", "points": [[153, 1019], [590, 1015], [590, 1043], [153, 1047]], "difficult": false}, {"transcription": "Nghe tháy tiéng Trác Than goi, cau bé dang ngǒi lac lōng mot minh trèn", "points": [[182, 1056], [900, 1054], [900, 1081], [182, 1083]], "difficult": false}, {"transcription": "chiec xích du làp túc ngoan ngoān nhày xuǒng dat. Trác Thǎn khoác mot bēn", "points": [[152, 1088], [901, 1087], [901, 1118], [152, 1119]], "difficult": false}, {"transcription": "quai cúa chiěc ba lò màu den lèn vai, dát tay càu bé di ra khói truòng mǎm non.", "points": [[154, 1125], [900, 1123], [900, 1151], [154, 1153]], "difficult": false}, {"transcription": "\"Cau oi, cáu lai phai di vác gach a?\" Mòng Mòng ngang dau nhin anh, hien", "points": [[183, 1160], [900, 1159], [900, 1190], [183, 1191]], "difficult": false}, {"transcription": "nhien dày khòng phái lan dau tièn anh vě sóm thě này.", "points": [[154, 1195], [670, 1198], [670, 1225], [154, 1222]], "difficult": false}, {"transcription": "\"U, cháu tói chō càu Phuong ngǒi mot lúc truróc nhé, càu sē tói dón cháu", "points": [[185, 1229], [901, 1232], [901, 1262], [185, 1258]], "difficult": false}, {"transcription": "sau.\"Trác Thǎn cúi dau, thay thàng bé vùra di vùra thò hōn hen bèn xách nó vác", "points": [[155, 1266], [900, 1265], [900, 1292], [155, 1293]], "difficult": false}, {"transcription": "luòn lèn vai.", "points": [[157, 1301], [275, 1301], [275, 1326], [157, 1326]], "difficult": false}, {"transcription": "4", "points": [[512, 1363], [530, 1363], [530, 1383], [512, 1383]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page3.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[386, 59], [563, 59], [563, 83], [386, 83]], "difficult": false}, {"transcription": "Mong Mòng voi òm lǎy dau càu minh, gáng gurong ngoi ving trén vai anh,", "points": [[123, 101], [855, 105], [855, 135], [123, 130]], "difficult": false}, {"transcription": "thò dài nhu òng cu non: \"Cau khòng the báo truóc dugc a? Benh tim cúa cháu", "points": [[93, 135], [855, 139], [855, 166], [93, 163]], "difficult": false}, {"transcription": "dēn phát tác vì càu mat thoi.\"", "points": [[94, 170], [387, 168], [387, 195], [94, 197]], "difficult": false}, {"transcription": "\"Ha ha. Càu luyen gan giúp cháu de khòng thúr gi doa dugc cháu nūa, dě bě", "points": [[122, 204], [857, 205], [857, 235], [122, 234]], "difficult": false}, {"transcription": "phòng tránh benh tim phát tác còn gì.\"", "points": [[95, 242], [476, 242], [476, 269], [95, 269]], "difficult": false}, {"transcription": "Càu ban nhò khòng dù sure phàn kháng lai òng càu ngang nguroc này,chi có", "points": [[121, 275], [857, 278], [857, 308], [121, 305]], "difficult": false}, {"transcription": "thē ra surc tron trǎng mát luròm anh.", "points": [[95, 312], [445, 312], [445, 336], [95, 336]], "difficult": false}, {"transcription": "Hai nguòi thong thà di xuyèn qua mot con duròng tói truóe cira Cuc Canh", "points": [[121, 347], [856, 349], [856, 377], [121, 375]], "difficult": false}, {"transcription": "sát thành phǒ. Tam bàng hiéu něn xanh lam chūr tráng trong vò cùng nói bát,", "points": [[93, 381], [854, 383], [854, 410], [93, 408]], "difficult": false}, {"transcription": "tràn day hoi thò chính nghia\"Vi nhàn dàn phue vy',nhin qua cūng biet day la", "points": [[94, 414], [856, 416], [856, 443], [94, 441]], "difficult": false}, {"transcription": "mòt noi an toàn de guri gám tré con.", "points": [[94, 449], [444, 451], [444, 474], [94, 472]], "difficult": false}, {"transcription": "Trác Thǎn dǎt thàng cháu nhà minh xuǒng, dá nhe vào cái mòng nhò cúa", "points": [[120, 481], [856, 485], [856, 515], [120, 511]], "difficult": false}, {"transcription": "thàng bé, ra hièu cho nó mau di vào trong.", "points": [[93, 516], [511, 520], [511, 548], [93, 544]], "difficult": false}, {"transcription": "Cau ban nhò phùi quan, cúi gàm mǎt di vào bèn trong gǎp ngay mot nguòi", "points": [[121, 553], [854, 555], [854, 585], [121, 583]], "difficult": false}, {"transcription": "mǎc cành phuc:\"Chú cánh sát oi, cháu di lac ròi a.\"", "points": [[92, 588], [602, 585], [602, 616], [92, 619]], "difficult": false}, {"transcription": "Lúc này òng càu vò luong tàm de cháu\"di lac\" da huyt sáo vang lùmg ngoǎt", "points": [[120, 621], [855, 625], [855, 655], [120, 651]], "difficult": false}, {"transcription": "sang khúc rě, vùa thǎm děm tói nǎm da nhán dugc cuòc goi cùa cành sát:", "points": [[92, 657], [854, 656], [854, 686], [92, 687]], "difficult": false}, {"transcription": "\"Vàng, tòi là càu nó. Oi chao, ngai quá di mat dǒng chí cành sát a. Bày giò tòi", "points": [[93, 689], [854, 692], [854, 719], [93, 716]], "difficult": false}, {"transcription": "dang trèn duròng cao tǒc chay vě dày a, phien anh tròng chùng cháu nó giúp tòi", "points": [[91, 720], [855, 722], [855, 756], [91, 754]], "difficult": false}, {"transcription": "mot lúc, tòi sē làp túrc..\"", "points": [[91, 758], [335, 755], [335, 783], [91, 786]], "difficult": false}, {"transcription": "Anh còn chura nói xong, dau dày bèn kia da truyěn tói tieng gào rú:\"Trác", "points": [[121, 792], [855, 795], [855, 823], [121, 820]], "difficult": false}, {"transcription": "Than, anh doi dó cho tòi!\"", "points": [[92, 828], [351, 827], [351, 852], [92, 853]], "difficult": false}, {"transcription": "Cau Trác dura dien thoai ra xa mot chút, ngoáy lǒ tai bàng ngón út rǒi thàng", "points": [[119, 861], [854, 864], [854, 894], [119, 891]], "difficult": false}, {"transcription": "thùmg cúp luòn dien thoai. Mòt tay anh dút túi quàn, mot tay khoác dày ba lò", "points": [[92, 900], [852, 900], [852, 924], [92, 924]], "difficult": false}, {"transcription": "len vai, di thǎng vě phía con duòng tàp trung cùra hàng dung cu kim khí kia.", "points": [[91, 932], [836, 932], [836, 959], [91, 959]], "difficult": false}, {"transcription": "***", "points": [[458, 967], [491, 967], [491, 986], [458, 986]], "difficult": false}, {"transcription": "Co gái ngǒi trèn chiěc ghe chàn cao duy nhǎt trong cira hàng, nhìn hai úng", "points": [[120, 1002], [853, 1004], [853, 1034], [120, 1032]], "difficult": false}, {"transcription": "cùr vién cho vi trí vè sī trén ghě sofa: Mòt nguòi dàn òng cuòng tráng vói vè", "points": [[88, 1037], [852, 1038], [852, 1065], [88, 1064]], "difficult": false}, {"transcription": "mǎt hung hān, nguòi dinh day dǎu mō; mot tèn luru manh dang búng hrōi dao,", "points": [[86, 1069], [853, 1070], [853, 1101], [86, 1100]], "difficult": false}, {"transcription": "ánh mát o hò.", "points": [[87, 1104], [228, 1104], [228, 1131], [87, 1131]], "difficult": false}, {"transcription": "\"A.. ong chú Chu này, tòi bi ban trai cǔ quáy ray nèn muǒn tim mòt nguòi", "points": [[116, 1138], [853, 1140], [853, 1170], [116, 1168]], "difficult": false}, {"transcription": "dua dón minh di làm thòi, chúr khòng phái muǒn tháo khóp tay chàn anh ta dàu.\"", "points": [[85, 1173], [853, 1172], [853, 1202], [85, 1203]], "difficult": false}, {"transcription": "Quá nhién noi này khòng phái còng ty vè sī dúng dán gì cho cam. Có khi", "points": [[115, 1211], [853, 1208], [853, 1239], [115, 1242]], "difficult": false}, {"transcription": "nào là dang xā hoi den nhán tièn dě diet trùr tai hoa cho nguòi ta khòng nhi?", "points": [[85, 1246], [851, 1244], [851, 1270], [85, 1272]], "difficult": false}, {"transcription": "Thay òng chú dàu troc kia hoi nhíu mày, cò gái càng cǎng thǎng hon, cǎm túi", "points": [[85, 1276], [851, 1275], [851, 1306], [85, 1307]], "difficult": false}, {"transcription": "cúa minh lén dinh ra vě.", "points": [[88, 1312], [331, 1312], [331, 1336], [88, 1336]], "difficult": false}, {"transcription": "5", "points": [[462, 1369], [483, 1369], [483, 1393], [462, 1393]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page4.jpg	[{"transcription": "ve sī tam thoi", "points": [[462, 62], [594, 62], [594, 86], [462, 86]], "difficult": false}, {"transcription": "\"Có còng vièc gì vay?\" Mot giong nói trong treo em tai pha chút bieng nhác", "points": [[197, 107], [890, 107], [890, 134], [197, 134]], "difficult": false}, {"transcription": "vang lèn ngoài cùra hàng. Cò gái ngang dau nhin, nguòi kia giong nhu mōt tia", "points": [[167, 142], [889, 139], [889, 166], [167, 168]], "difficult": false}, {"transcription": "náng roi nham vào dày, chiěu sáng cà cùra hàng àm u cǔ ky này.", "points": [[168, 173], [752, 174], [752, 201], [168, 200]], "difficult": false}, {"transcription": "Co khách vùra dom nhǎc nguòi lèn da vòi ngǒi xuǒng lai.", "points": [[198, 211], [715, 211], [715, 235], [198, 235]], "difficult": false}, {"transcription": "\"Anh Than!\" Nguòi dàn òng curòng tráng và tèn luru manh ngǒi trèn ghě", "points": [[199, 245], [892, 245], [892, 272], [199, 272]], "difficult": false}, {"transcription": "sofa làp túc dúng dày chào hòi.", "points": [[170, 281], [459, 279], [459, 304], [170, 306]], "difficult": false}, {"transcription": "\"Hai nguòi cūng ò dày à?\" Trác Thǎn dáp mot tiěng, ném ba lò trèn vai", "points": [[198, 314], [891, 312], [891, 339], [198, 341]], "difficult": false}, {"transcription": "xuǒng sofa, thuàn tay cam cǒc trà Thiet Quan Am mà òng chù Chu vira pha lèn", "points": [[167, 346], [891, 343], [891, 374], [167, 377]], "difficult": false}, {"transcription": "tu ing uc hět sach.", "points": [[170, 383], [346, 381], [346, 405], [170, 408]], "difficult": false}, {"transcription": "Ong chú béo dàu troc trùng mát nhìn anh mòt cái rǒi giói thiéu vói cò gái", "points": [[198, 416], [891, 415], [891, 441], [198, 442]], "difficult": false}, {"transcription": "ngoi trén ghe chàn cao:\"Dày là quàn át chù bài cúa chúng tòi. Neu cò thay hai", "points": [[169, 448], [893, 444], [893, 475], [169, 479]], "difficult": false}, {"transcription": "nguòi này khòng on, chi bàng thùr càn nhác den càu ay xem sao?\"", "points": [[169, 483], [766, 477], [766, 505], [169, 511]], "difficult": false}, {"transcription": "\"Anh ay cǔng là vè sī à? Nhung nhin anh ay.\"Co gái nhin nguòi dàn òng", "points": [[200, 516], [893, 517], [893, 544], [200, 543]], "difficult": false}, {"transcription": "cao gay sach sē dó bàng ánh mát khòng thē tin nǒi. Nói anh ǎy là sinh vien", "points": [[170, 549], [893, 546], [893, 576], [170, 579]], "difficult": false}, {"transcription": "dai hoc còn có nguòi tin ay chú, sao có thě là vé sī rièng durgc, lai còn là Át", "points": [[172, 583], [892, 580], [892, 607], [172, 610]], "difficult": false}, {"transcription": "chù bài co á?", "points": [[172, 617], [295, 615], [295, 639], [172, 641]], "difficult": false}, {"transcription": "Nhin vè mǎt cua cò gái kia, Trác Thǎn làp túc hieu ra vǎn dě. Anh tùng gǎp", "points": [[197, 649], [892, 650], [892, 680], [197, 679]], "difficult": false}, {"transcription": "rat nhiěu khách hàng nhu vày nèn cǔng khòng dě y, dǎt chiěc cǒc chi còn lai", "points": [[170, 685], [893, 683], [893, 709], [170, 711]], "difficult": false}, {"transcription": "lá trà cia òng chù Chu xuǒng anh bào:\"Nhin khòng giǒng vé sī mà giǒng dǎc", "points": [[170, 717], [891, 716], [891, 743], [170, 744]], "difficult": false}, {"transcription": "còng hon dúng khòng? Quà thrc chǎng giǎu gì cò, truóc dày tòi da tirng làm", "points": [[171, 751], [891, 748], [891, 775], [171, 778]], "difficult": false}, {"transcription": "vièc ò Co quan Tinh báo Trung uong.\"", "points": [[173, 786], [520, 786], [520, 810], [173, 810]], "difficult": false}, {"transcription": "Khòng hieu sao giong dièu lanh lùng thoài mái ay lai khiěn nguòi ta tin", "points": [[197, 818], [895, 818], [895, 848], [197, 848]], "difficult": false}, {"transcription": "turòng la thuòng, cò gái nghe mà ngay cà nguòi.", "points": [[170, 854], [606, 853], [606, 880], [170, 881]], "difficult": false}, {"transcription": "\"Ding có bǒc phét nūra,ǎn nói dàng hoàng di.\" Ong chù Chu xoa cái dau", "points": [[198, 889], [894, 888], [894, 915], [198, 916]], "difficult": false}, {"transcription": "bóng luǒng cǔa mình, càm thày sóm muōn gì cǔng bi dám dǒn mat này choc", "points": [[169, 923], [896, 924], [896, 951], [169, 950]], "difficult": false}, {"transcription": "cho giàn tói múrc troc thém lóp nūra mat thòi:\"Là the này cò Ly a, càu ay turong", "points": [[169, 955], [896, 959], [896, 986], [169, 981]], "difficult": false}, {"transcription": "doi dǎc biet. Các nhièm vu truóc dày cùa càu ay chua bao giò that bai， giá cūng", "points": [[169, 988], [896, 992], [896, 1018], [169, 1015]], "difficult": false}, {"transcription": "là cao nhat. Něu cò chi cǎn tim mòt nguòi dura dón di lam, tòi de nghi hay la...\"", "points": [[166, 1021], [895, 1020], [895, 1050], [166, 1051]], "difficult": false}, {"transcription": "\"Bao nhieu tien?\" Co Ly cát dut y do muǒn tiep thi cho hai nguròi ngoi trèn", "points": [[196, 1057], [895, 1061], [895, 1088], [196, 1084]], "difficult": false}, {"transcription": "ghě sofa cùa òng chù, hòi thàng giá cà.", "points": [[170, 1093], [522, 1093], [522, 1120], [170, 1120]], "difficult": false}, {"transcription": "\"Duong nhièn vǎn rè hon các còng ty vé sī chính quy khác rǎt nhieu.\" Chu", "points": [[197, 1126], [897, 1130], [897, 1158], [197, 1154]], "difficult": false}, {"transcription": "béo vàn vé chuōi hat óc chó trèn tay minh,\"Mòt ngày bǒn nghin, bào vé toàn", "points": [[167, 1158], [897, 1163], [897, 1193], [167, 1188]], "difficult": false}, {"transcription": "dièn trong tám tiěng dǒng hǒ, tuong duong vói mòt tieng chi mat nǎm trǎm!\"", "points": [[169, 1195], [892, 1197], [892, 1224], [169, 1222]], "difficult": false}, {"transcription": "Nghe thay múrc giá này, sác mǎt co gái thay doi lièn tuc, luōng lu nhin Trác", "points": [[194, 1231], [897, 1234], [897, 1261], [194, 1257]], "difficult": false}, {"transcription": "Than mot lúc làu roi mói ngai ngùng nói:\"Có the thuè hai tieng mot ngày durgc", "points": [[165, 1260], [898, 1268], [898, 1297], [165, 1290]], "difficult": false}, {"transcription": "khòng, chi thuè lúc di làm và tan tǎm thòi, dùng truróc mòt tuǎn da.\"", "points": [[164, 1295], [797, 1298], [797, 1328], [164, 1325]], "difficult": false}, {"transcription": "6", "points": [[520, 1366], [537, 1366], [537, 1387], [520, 1387]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page5.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[387, 59], [563, 59], [563, 80], [387, 80]], "difficult": false}, {"transcription": "Giong nói càng vě sau càng nhò, cuoi cùng lí nhí nhur tiěng muǒi keu.", "points": [[122, 100], [800, 102], [800, 129], [122, 127]], "difficult": false}, {"transcription": "Bau khòng khí tinh lǎng vài giày, TrácThan ngoi trèn tay vin ghě sofa thuàn", "points": [[121, 133], [856, 137], [856, 163], [121, 160]], "difficult": false}, {"transcription": "tay cuóp lay con dao cua\"tén luu manh\" denghich:\"Duroc thòi,mòt tuàn bay", "points": [[93, 165], [857, 167], [857, 197], [93, 195]], "difficult": false}, {"transcription": "nghìn, khách hàng mói nèn tòi giàm giá cho cò, nǎm nghìn thòi là duoc.\"", "points": [[94, 200], [807, 200], [807, 227], [94, 227]], "difficult": false}, {"transcription": "Co gái ming rō ngang dau lèn:\"OK!\"", "points": [[122, 233], [499, 232], [499, 260], [122, 261]], "difficult": false}, {"transcription": "Trong lúc trà tièn dǎt coc và dǎng ky, Trác Than trò chuyen vói cò gái rǒi", "points": [[121, 268], [855, 269], [855, 297], [121, 296]], "difficult": false}, {"transcription": "mói biet duroc dai khái ngon ngành càu chuyèn.", "points": [[93, 301], [564, 303], [564, 330], [93, 328]], "difficult": false}, {"transcription": "Co gái này tèn là Ly Dinh, mòt nhàn vien làm viéc vǎn phòng, có gā ban trai", "points": [[123, 337], [857, 337], [857, 364], [123, 364]], "difficult": false}, {"transcription": "vò cùng cǒ chàp vùra chia tay tùr hai tuǎn truróc. Ban dau anh ta còn làm am lèn", "points": [[95, 370], [856, 370], [856, 394], [95, 394]], "difficult": false}, {"transcription": "dòi sǒng dòi chet,nhung vì thái dò cùa cò gái quá curong quyet nèn nguròi này", "points": [[93, 400], [855, 403], [855, 429], [93, 425]], "difficult": false}, {"transcription": "bát dau dién cuǒng deo bám, di làm thì chǎn duòng, tan làm thi bám duòi. May", "points": [[93, 431], [856, 433], [856, 460], [93, 458]], "difficult": false}, {"transcription": "ngày gǎn dày anh ta còn quá dáng hon, ngǒi chò ò bai dō xe dòi lèn xe cò ày", "points": [[94, 464], [856, 464], [856, 494], [94, 494]], "difficult": false}, {"transcription": "cho bàng duroc, thàm chí còn ra tay dánh cò ǎy nūa.", "points": [[95, 498], [598, 498], [598, 522], [95, 522]], "difficult": false}, {"transcription": "Ly Dinh vò cùng so hai, nhumg khòng có nhieu tiěn thuè vè sī chuyèn nghièp.", "points": [[121, 529], [856, 531], [856, 561], [121, 559]], "difficult": false}, {"transcription": "Nghe nói ò dày có dich vu gia dinh dǎc bièt mà dàn thuòng cūng thué duroc", "points": [[93, 560], [857, 563], [857, 593], [93, 590]], "difficult": false}, {"transcription": "nèn cò mói dēn dē thùr vàn may.", "points": [[93, 595], [415, 597], [415, 624], [93, 622]], "difficult": false}, {"transcription": "\"Cái loai khǒn nan dó cúr tàn cho mot trán là yén chuyen.\" Nguòi dàn òng", "points": [[121, 626], [858, 629], [858, 660], [121, 657]], "difficult": false}, {"transcription": "vam vō nguòi day dau máy cuòi nhao, thuàn tay rút lǎy mòt dieu thuoc tùr òng", "points": [[92, 661], [858, 662], [858, 692], [92, 691]], "difficult": false}, {"transcription": "chù, hat hàm vói Trác Thǎn rǒi sài buóc ròi khòi cùra hàng.", "points": [[92, 692], [669, 694], [669, 723], [92, 721]], "difficult": false}, {"transcription": "\"Anh béo, anh Thǎn, em cǔng di dày a.\" Tèn luru manh cuòi hi hì, chuǒn", "points": [[122, 727], [858, 727], [858, 757], [122, 757]], "difficult": false}, {"transcription": "nhanh nhur mot con gió.", "points": [[92, 760], [334, 762], [334, 789], [92, 787]], "difficult": false}, {"transcription": "Ly Dinh trom nhin theo bóng lumg hai nguòi ho, tò mò hòi Trác Than:\"Tai", "points": [[121, 796], [858, 795], [858, 823], [121, 824]], "difficult": false}, {"transcription": "sao anh lai là nguòi dátnhat a?\"", "points": [[92, 830], [412, 829], [412, 854], [92, 855]], "difficult": false}, {"transcription": "\"Cái này mà còn phai hòi a?\" TrácThan day hop dǒng tói truóc mǎt khách", "points": [[121, 863], [860, 862], [860, 890], [121, 891]], "difficult": false}, {"transcription": "hàng, dua cho có ay caybút,\"Bòi vì toi dep trai chúr sao.\"", "points": [[91, 896], [658, 892], [658, 922], [91, 926]], "difficult": false}, {"transcription": "Bàn tay dang kí tèn run lèn khien nét cuoi cùng cùa chūr\"Dinh\"kéo dài ra.", "points": [[120, 931], [856, 930], [856, 957], [120, 958]], "difficult": false}, {"transcription": "\"Vày... có the bát dau tùr hòm nay duoc khòng?\"Ly Dinh òm túi xách, che di", "points": [[122, 966], [861, 966], [861, 992], [122, 992]], "difficult": false}, {"transcription": "vet bùn trèn tat,\"Toi trōn vièc tói dày nèn còn phài vě còng ty chǎm còng nūra.\"", "points": [[90, 996], [838, 995], [838, 1025], [90, 1026]], "difficult": false}, {"transcription": "\"Có duoc khòng?\" Ong chù Chu khòng trá lòi ngay mà nhìn sang Trác Than", "points": [[122, 1033], [846, 1033], [846, 1060], [122, 1060]], "difficult": false}, {"transcription": "Trác Than xách chiec ba lò den trèn ghe sofa deo lèn vai, vǒ nhe mǎy cái:", "points": [[120, 1069], [860, 1069], [860, 1096], [120, 1096]], "difficult": false}, {"transcription": "\"Dugc chúr sao khong, tòi mang thur này theo rǒi.\"", "points": [[92, 1102], [587, 1102], [587, 1129], [92, 1129]], "difficult": false}, {"transcription": "Cuoi cùng trái tim cǎng thàng cúa Ly Dinh cǔng durgc thá lòng. Khòng hō là", "points": [[119, 1138], [861, 1136], [861, 1163], [119, 1165]], "difficult": false}, {"transcription": "vè sī At chù bài,còn mang theo cà dung cu chuyén nghiép nūra. Nghe có vé rát", "points": [[89, 1171], [861, 1169], [861, 1196], [89, 1198]], "difficult": false}, {"transcription": "ngǎu, khòng biet là còn nhi khúc hay dao gap.", "points": [[88, 1203], [550, 1202], [550, 1232], [88, 1233]], "difficult": false}, {"transcription": "Còng ty cùa cò nàm ò mòt khu thuong mai cách day may tram xe, hai nguròi", "points": [[120, 1240], [862, 1238], [862, 1264], [120, 1267]], "difficult": false}, {"transcription": "ngoi xe buyt dúng giò cao diem buōi tǒi. Chiěc xe buyt lón dang nǒi toa,ít chǒ", "points": [[88, 1273], [862, 1268], [862, 1298], [88, 1302]], "difficult": false}, {"transcription": "ngǒi nhiěu chǒ dúng hèt nhu tàu dièn ngam, nguòi nguòi chen chúc trong", "points": [[88, 1305], [864, 1306], [864, 1336], [88, 1335]], "difficult": false}, {"transcription": "7", "points": [[469, 1368], [487, 1368], [487, 1388], [469, 1388]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page6.jpg	[{"transcription": "ve sī tam thāi", "points": [[475, 55], [617, 55], [617, 76], [475, 76]], "difficult": false}, {"transcription": "khoang xe nhu the muon chèn nhau bep di. Trác Than nhuòng Ly Dinh dúngò", "points": [[144, 97], [928, 98], [928, 125], [144, 124]], "difficult": false}, {"transcription": "noi gǎn turòng, còn minh thì chǒng mot tay vào vách xe,ngǎn chǎn tǎt cá nhūng", "points": [[144, 133], [927, 132], [927, 158], [144, 159]], "difficult": false}, {"transcription": "nguòi chen chúc và mày bàn tay dàm dè ò phía sau.", "points": [[142, 166], [672, 165], [672, 192], [142, 193]], "difficult": false}, {"transcription": "\"Cam on anh.\" Hai nguròi dúng gǎn tói nǒi Ly Dinh có thengini dugc mùi", "points": [[174, 200], [928, 200], [928, 230], [174, 230]], "difficult": false}, {"transcription": "huong xà phòng thom mát trén nguòi anh, khien cò khòng khòi dò mǎt.", "points": [[141, 237], [865, 234], [865, 261], [141, 264]], "difficult": false}, {"transcription": "\"Cam on gì chúr, day là tièu chuan phuc vu mà.\" Trác Than khòng nhin", "points": [[172, 273], [927, 271], [927, 298], [172, 300]], "difficult": false}, {"transcription": "cò,ánh mát lo dāng dò xét dám nguòi xung quanh, dě phòng có ké khá nghi", "points": [[140, 308], [927, 305], [927, 332], [140, 335]], "difficult": false}, {"transcription": "tói gǎn.", "points": [[137, 340], [227, 340], [227, 376], [137, 376]], "difficult": false}, {"transcription": "***", "points": [[520, 376], [553, 376], [553, 395], [520, 395]], "difficult": false}, {"transcription": "Cong ty Ly Dinh nàm trong mòt tòa vǎn phòng cao cap, noi giao thoa giura", "points": [[169, 417], [928, 413], [928, 440], [169, 443]], "difficult": false}, {"transcription": "khu vuòn uom doanh nghièp còng nghé cao và pho tài chính, cūng là noi toa", "points": [[137, 451], [928, 447], [928, 473], [137, 477]], "difficult": false}, {"transcription": "lac cùa vò sǒ còng ty dich vu Internet và còng ty tài chính. Bèn ngoài tòa nhà", "points": [[136, 485], [928, 480], [928, 508], [136, 513]], "difficult": false}, {"transcription": "duoc bao tron bòi lóp kính màu vàng sàm, sành chính ròng lón nguy nga tráng", "points": [[138, 516], [928, 516], [928, 543], [138, 543]], "difficult": false}, {"transcription": "lè, dàu dàu cǔng the hièn dày là noi tǎc dat tǎc vàng.", "points": [[135, 552], [675, 551], [675, 579], [135, 580]], "difficult": false}, {"transcription": "\"Co làm vièc ò còng ty nào?\" Trác Thǎn thuàn tay rút lay mot tò bàn dǒ ò", "points": [[165, 589], [930, 584], [930, 614], [165, 619]], "difficult": false}, {"transcription": "quay lě tàn, theo Ly Dinh di vào thang máy.", "points": [[132, 625], [585, 621], [585, 652], [132, 656]], "difficult": false}, {"transcription": "\"Cong ty Ban do Tièu Diem.\" Nhác tói tén cong ty, Ly Dinh khòng nén", "points": [[162, 660], [929, 656], [929, 687], [162, 691]], "difficult": false}, {"transcription": "noi ny cròi. Ban do Tieu Diem la mot ung dung trèn dien thoai di dòng dugc", "points": [[127, 695], [930, 688], [930, 722], [127, 728]], "difficult": false}, {"transcription": "ra mát vào ba nǎm truróc. Nhò tính nǎng uu vièt và nhieu diem khác biet vói", "points": [[130, 732], [928, 725], [928, 753], [130, 760]], "difficult": false}, {"transcription": "nhūng bàn dǒ khác mà nó da nhanh chóng thinh hành kháp toàn quǒc, hièn già", "points": [[131, 767], [928, 762], [928, 789], [131, 794]], "difficult": false}, {"transcription": "là bàn do gǎn nhu ai cūng sùr dung.", "points": [[130, 802], [494, 803], [494, 830], [130, 829]], "difficult": false}, {"transcription": "\"Cong ty on áp day.\" Trác Than gap tò bàn do chi dǎn lai rǒi cat vào túi, dua", "points": [[162, 837], [930, 834], [930, 865], [162, 868]], "difficult": false}, {"transcription": "tay ân tang 23.", "points": [[132, 876], [281, 872], [282, 902], [133, 907]], "difficult": false}, {"transcription": "Ly Dinh còn chura kip hòi tai sao anh biet sǒ tang thì da có mot nhóm nguòi", "points": [[162, 912], [929, 909], [929, 939], [162, 942]], "difficult": false}, {"transcription": "àp vào thang máy. Dù là giò tan làm nhung rat nhieu còng ty còn phài tǎng ca", "points": [[133, 949], [929, 944], [929, 974], [133, 980]], "difficult": false}, {"transcription": "buōi tǒi. Dám nhàn vièn làm còng ǎn lurong vǎt và chi có thē xuǒng duói ǎn vōi", "points": [[133, 983], [928, 979], [928, 1008], [133, 1011]], "difficult": false}, {"transcription": "ǎn vàng būa com rǒi quay vě vi trí làm viéc.", "points": [[135, 1020], [579, 1019], [579, 1046], [135, 1047]], "difficult": false}, {"transcription": "Trong thang máy, Trác Than mǎc áo phòng guan the thao, nhin vò cùng nōi", "points": [[165, 1056], [929, 1053], [929, 1083], [165, 1086]], "difficult": false}, {"transcription": "bàt giūra cà dám nguòi hau het děu mǎc do Tay di giày da, nhumg chǎng ai nghī", "points": [[135, 1091], [930, 1089], [930, 1120], [135, 1122]], "difficult": false}, {"transcription": "anh là nhàn vièn giao hàng. Anh Thǎn nhìn dòi bàng núra con mát này tròng", "points": [[137, 1126], [930, 1126], [930, 1156], [137, 1156]], "difficult": false}, {"transcription": "giǒng CEO ǎn mǎc thoài mái cúa mot cong ty dich vu Internet hon.", "points": [[137, 1164], [810, 1162], [810, 1190], [137, 1192]], "difficult": false}, {"transcription": "Cong ty Tieu Diem chiem tron cà tǎng 23, cách trang hoàng cūng hoàn toàn", "points": [[170, 1201], [928, 1201], [928, 1228], [170, 1228]], "difficult": false}, {"transcription": "khác vói nhūng tǎng khác, buóc ra khòi thang máy còn cǎn di qua mòt cánh", "points": [[140, 1236], [929, 1236], [929, 1263], [140, 1263]], "difficult": false}, {"transcription": "cira thùy tinh quét vàn tay nūra rǒi mói vào dugc. Trong lúc chò khách hàng", "points": [[140, 1268], [930, 1272], [930, 1301], [140, 1298]], "difficult": false}, {"transcription": "vào chǎm còng, Trác Than ngǒi ò cira thang máy thuróng thúrc něn gach lát nhà", "points": [[141, 1302], [930, 1304], [930, 1338], [141, 1336]], "difficult": false}, {"transcription": "8", "points": [[520, 1378], [537, 1378], [537, 1402], [520, 1402]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page7.jpg	[{"transcription": "Luc Da Tnien Hac", "points": [[395, 53], [572, 51], [572, 73], [395, 75]], "difficult": false}, {"transcription": "có hinh tròi sao dac biet. Dá cám thach màu xanh thǎm khám nhūng dǒm sáng", "points": [[99, 96], [867, 96], [867, 123], [99, 123]], "difficult": false}, {"transcription": "rai rác, ket hop vói giày dán tuòng mǎt tròi moc và mǎt trǎng lǎn tao nén hinh", "points": [[99, 131], [866, 128], [866, 154], [99, 157]], "difficult": false}, {"transcription": "anh turomg phan rǎt thú vi.", "points": [[101, 166], [364, 166], [364, 190], [101, 190]], "difficult": false}, {"transcription": "Lsi thoát hiēm duroe bao tron trong cánh cira thùy tinh, khong hè hǔru nghi", "points": [[126, 199], [867, 199], [867, 229], [126, 229]], "difficult": false}, {"transcription": "voi nhūng nguòi qua duòng khóng thě vào cong ty.", "points": [[98, 234], [614, 237], [614, 265], [98, 262]], "difficult": false}, {"transcription": "Hinh nhu cǒng ty còn chua tan làm, anh dgi māi mói có mot nguòi dàn òng", "points": [[127, 271], [868, 274], [868, 301], [127, 298]], "difficult": false}, {"transcription": "trè tuòi di ra. Ao so mi durge là phàng phiu tiep màu vói nèn gach tròi sao xanh", "points": [[96, 305], [868, 306], [868, 336], [96, 335]], "difficult": false}, {"transcription": "tham, áo vest chat luong cao vát tren cánh tay.", "points": [[99, 340], [560, 343], [560, 371], [99, 368]], "difficult": false}, {"transcription": "\"Tong Giám doc Cao!\" Ly Dinh vQi vàng chay ra ngoài,rut rè chào hói,", "points": [[130, 378], [868, 378], [868, 408], [130, 408]], "difficult": false}, {"transcription": "duòng nhu khòng ngò nguòi dàn òng này vǎn chua vě.", "points": [[99, 415], [648, 415], [648, 441], [99, 441]], "difficult": false}, {"transcription": "\"ù.\"Nguòi dàn òng tre tuoi hò hūng dáp rǒi di thàng vào thang máy, cháng", "points": [[128, 447], [869, 450], [869, 481], [128, 478]], "difficult": false}, {"transcription": "buòn nhin Ly Dinh mot cái.", "points": [[99, 487], [376, 487], [376, 511], [99, 511]], "difficult": false}, {"transcription": "Trác Than dang dinh vào theo thi bi Ly Dinh túm lay. Anh bat giác nhin qua", "points": [[131, 525], [868, 525], [868, 549], [131, 549]], "difficult": false}, {"transcription": "khe hò thang máy dang dóng lai:\"Có sep dep trai vày mà cò cǔng sg di cùng", "points": [[97, 556], [871, 558], [871, 588], [97, 586]], "difficult": false}, {"transcription": "thang máy vói càu ta à?\"", "points": [[99, 595], [349, 590], [349, 617], [99, 622]], "difficult": false}, {"transcription": "\"Nguòi ta là trai dep lám tien hàng that giá that day, bong hoa cao sang lanh", "points": [[128, 628], [870, 627], [870, 657], [128, 658]], "difficult": false}, {"transcription": "lùng dó tòi khòng vói tói nǒi dàu. Cúr luon lò truóc mǎt anh ày chi tō bi máng", "points": [[97, 663], [870, 661], [870, 692], [97, 694]], "difficult": false}, {"transcription": "thòi chúr có gì tot dep.\" Ly Dinh lác dàu nhu trǒng bòi, kien trì dqi chuyěn", "points": [[100, 699], [868, 699], [868, 725], [100, 725]], "difficult": false}, {"transcription": "thang máy tiěp theo.", "points": [[99, 734], [308, 734], [308, 761], [99, 761]], "difficult": false}, {"transcription": "Bai dō xe cúa tòa nhà nàm ò tǎng ham sǒ mòt. Càm nhàn duroc khách hàng", "points": [[126, 767], [871, 769], [871, 799], [126, 797]], "difficult": false}, {"transcription": "cua minh bát dau cǎng thàng ngay khi buóc chàn vào bai dǒ xe,Trác Than ra", "points": [[98, 805], [870, 803], [870, 830], [98, 832]], "difficult": false}, {"transcription": "hièu cho cò di sau minh:\"Dura chia khóa xe cho tòi.\"", "points": [[97, 840], [622, 836], [622, 863], [97, 867]], "difficult": false}, {"transcription": "Tim dugc chiec xe second-hand màu tráng cúa Ly Dinh, Trác Than an khóa", "points": [[128, 877], [870, 875], [870, 902], [128, 904]], "difficult": false}, {"transcription": "dieu khien tùr xa, vuon tay mò cira xe, ngǎn Ly Dinh lai ngay khi cò chuan bi", "points": [[97, 913], [870, 910], [870, 937], [97, 940]], "difficult": false}, {"transcription": "buóc tói.", "points": [[96, 949], [190, 949], [190, 974], [96, 974]], "difficult": false}, {"transcription": "\"Thàng này là ai?\" Mot nguòi dàn òng dòt ngòt nhay ra tùr sau duòi xe, chi", "points": [[128, 985], [872, 980], [872, 1010], [128, 1014]], "difficult": false}, {"transcription": "vào Trác Thǎn mà lón tiéng chàt van. Gàn xanh trèn cǒ go lèn, tròng gā nhur", "points": [[97, 1020], [871, 1017], [871, 1044], [97, 1047]], "difficult": false}, {"transcription": "the sē lao tói cán nguòi ta bat cúr lúc nào,\"Mói có mày ngày thòi mà cò da tim", "points": [[96, 1056], [871, 1051], [871, 1078], [96, 1083]], "difficult": false}, {"transcription": "thàng khác rǒi à?\"", "points": [[97, 1091], [282, 1089], [282, 1117], [97, 1119]], "difficult": false}, {"transcription": "Trác Than cǎp tǒc khóa xe lai, lùi may buróc dúrng chán truróc mǎt Ly Dinh,", "points": [[126, 1126], [870, 1123], [870, 1153], [126, 1156]], "difficult": false}, {"transcription": "quan sát gā dàn òng kia tùr trèn xuǒng duói, chép mièng nói:\"Day là ban trai", "points": [[96, 1165], [872, 1158], [872, 1188], [96, 1195]], "difficult": false}, {"transcription": "cū cúa co à? Mát tráng dā, rō cái tuóng dàm dè.\"", "points": [[97, 1199], [582, 1196], [582, 1223], [97, 1226]], "difficult": false}, {"transcription": "\"Me kiep thàng này.\"Gā ban trai cǔ vǒn dā tron sáp nút cá mát làp túrc bi", "points": [[128, 1234], [871, 1230], [871, 1259], [128, 1264]], "difficult": false}, {"transcription": "choc giàn, vó lày vièn gach dinh dàp vō dàu cái tèn èo lá mǒm mièng day mùi", "points": [[97, 1270], [871, 1263], [871, 1293], [97, 1299]], "difficult": false}, {"transcription": "thuǒc súng này.", "points": [[98, 1304], [261, 1308], [261, 1335], [98, 1332]], "difficult": false}, {"transcription": "9", "points": [[477, 1364], [498, 1364], [498, 1388], [477, 1388]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page8.jpg	[{"transcription": "ve sī tam tho1", "points": [[449, 52], [582, 52], [582, 73], [449, 73]], "difficult": false}, {"transcription": "Khòng phài vè sī deu dǎt an toàn lèn hàng dàu à? Sao còn có kieu choc túrc", "points": [[173, 94], [894, 91], [894, 121], [173, 124]], "difficult": false}, {"transcription": "doi phurong thě này chúr? Ly Dinh sg tói múc hét toánglen, òm dàu tránh sang", "points": [[144, 128], [896, 125], [896, 154], [144, 157]], "difficult": false}, {"transcription": "mòt bèn.", "points": [[142, 162], [235, 159], [236, 191], [143, 194]], "difficult": false}, {"transcription": "Trác Than nghièng nguòi né dòn tǎn còng khòng hě có bài bàn dó, thò tay", "points": [[173, 197], [893, 194], [893, 221], [173, 224]], "difficult": false}, {"transcription": "vào trong ba lò lǎy ra mot thú làm Ly Dinh và gā ban trai cǔ deu dúng hình tai", "points": [[146, 232], [895, 227], [895, 254], [146, 259]], "difficult": false}, {"transcription": "tran. Khòng phài là còn nhi khúc, cūng chǎng phài dao gǎp, mà là mōt binh oxy", "points": [[145, 264], [896, 259], [896, 289], [145, 294]], "difficult": false}, {"transcription": "dang cam tay dài bàng cà cánh tay!", "points": [[148, 299], [477, 294], [477, 322], [148, 327]], "difficult": false}, {"transcription": "Ngài vé sī diem tīnh chup vào mǎt hít sàu mǎy hoi: \"Ngai quá, nguròi hoi", "points": [[173, 332], [896, 326], [896, 357], [173, 363]], "difficult": false}, {"transcription": "yěu, thiěu oxy.\"", "points": [[145, 368], [302, 364], [302, 395], [145, 399]], "difficult": false}, {"transcription": "Thuè mòt tèn lúc nào cūng mang theo binh oxy, cir chǒc chǒc thiěu oxy", "points": [[174, 400], [897, 398], [897, 427], [174, 429]], "difficult": false}, {"transcription": "lai phài loi ra hít de làm ve sī u? Ga ban trai cǔ gǎn nhu bàt cròi thành tieng", "points": [[145, 433], [898, 428], [898, 462], [145, 466]], "difficult": false}, {"transcription": "khòng doi Trác Than hít xong da phang thàng mòt gach vě phía khuòn mǎt", "points": [[147, 469], [898, 464], [898, 491], [147, 496]], "difficult": false}, {"transcription": "dien traicua anh.", "points": [[148, 503], [312, 501], [312, 526], [148, 528]], "difficult": false}, {"transcription": "Trác Than gō binh oxy ra rǒi ném lai vào ba lò vói mòt tǒc dò gan nhu khòng", "points": [[172, 534], [899, 531], [899, 564], [172, 567]], "difficult": false}, {"transcription": "thē nhin thay rō. Anh siět chǎt cō tay dǒi phurong bàng mòt tay, thc hièn cú", "points": [[145, 572], [897, 566], [897, 593], [145, 599]], "difficult": false}, {"transcription": "quǎng nguòi qua vai chóp nhoáng nén dǒi phurong xuǒng dat hét nhur quǎng", "points": [[146, 605], [898, 600], [898, 631], [146, 636]], "difficult": false}, {"transcription": "mōt cái bao tài.", "points": [[144, 640], [291, 637], [291, 664], [144, 668]], "difficult": false}, {"transcription": "\"1", "points": [[175, 679], [190, 679], [190, 693], [175, 693]], "difficult": false}, {"transcription": "n", "points": [[206, 675], [221, 678], [218, 691], [203, 688]], "difficult": false}, {"transcription": "Dó hoàn toàn khòng phài dòng tác mà con nguòi binh thuòng có thě", "points": [[172, 711], [902, 705], [902, 735], [172, 740]], "difficult": false}, {"transcription": "làm duoc.", "points": [[144, 747], [249, 747], [249, 775], [144, 775]], "difficult": false}, {"transcription": "Ly Dinh há hoc miéng, khòng thǒt nōi nura chū.", "points": [[172, 783], [616, 778], [616, 808], [172, 813]], "difficult": false}, {"transcription": "Tōng Giám dǒc Cao dúng cách dó hai hàng xe cūng sūng sò chúng kien", "points": [[173, 820], [901, 815], [901, 843], [173, 848]], "difficult": false}, {"transcription": "toàn bò quá trinh.", "points": [[143, 854], [313, 851], [313, 882], [143, 885]], "difficult": false}, {"transcription": "10", "points": [[491, 1361], [524, 1361], [524, 1391], [491, 1391]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page9.jpg	[{"transcription": "Chuong 2", "points": [[419, 102], [549, 102], [549, 133], [419, 133]], "difficult": false}, {"transcription": "Sao tren troi (2)", "points": [[317, 149], [645, 149], [645, 190], [317, 190]], "difficult": false}, {"transcription": "√", "points": [[429, 226], [441, 226], [441, 242], [429, 242]], "difficult": false}, {"transcription": "Tat cà diēn ra quá nhanh, tói khi bui bǎm bǒc lèn lai lǎng xuǒng něn dàt lan", "points": [[123, 266], [869, 270], [869, 300], [123, 296]], "difficult": false}, {"transcription": "nūa, nguòi bi quǎng ngā kia còn chua kip hét tiēng nào.", "points": [[96, 302], [648, 305], [648, 332], [96, 329]], "difficult": false}, {"transcription": "Sau lung có tieng buóc chan tói gan rat nhanh, Trác Than quay dau lai, thay", "points": [[124, 338], [867, 340], [867, 368], [124, 366]], "difficult": false}, {"transcription": "vi Tong Giám dǒc Tieu Cao kia da ding cách anh ba buóc.", "points": [[96, 371], [676, 373], [676, 401], [96, 399]], "difficult": false}, {"transcription": "\"Anh..\"Hán nhìn chàm chàm vào Trác Than bàng dòi mát den láy, chi thǒt", "points": [[127, 408], [868, 408], [868, 434], [127, 434]], "difficult": false}, {"transcription": "ra dugc mòt chūr duy nhat roi tát ngóm, tra nhu giot nuóc sòi bán lèn nhung", "points": [[95, 438], [869, 441], [869, 471], [95, 468]], "difficult": false}, {"transcription": "lai tan dan trong khòng khí lanh lēo.", "points": [[95, 475], [460, 476], [460, 503], [95, 502]], "difficult": false}, {"transcription": "Ban nāy ò cira thang máy chi nhin thoáng qua nèn khòng thǎy rō, bay giò", "points": [[127, 512], [869, 512], [869, 539], [127, 539]], "difficult": false}, {"transcription": "dúng gǎn Trác Thǎn mói phát hièn nguòi dàn òng dep trai lám tiěn này có", "points": [[97, 544], [869, 542], [869, 572], [97, 574]], "difficult": false}, {"transcription": "guong mǎt tré trung mot cách quá dáng, chi tǎm ngoài hai muroi là cùng. Vì", "points": [[97, 580], [869, 576], [869, 604], [97, 608]], "difficult": false}, {"transcription": "khí chǎt chín chán diěm dam cùa hán nèn mói khien nguòi ta xem nhe tuōi tác.", "points": [[99, 613], [868, 613], [868, 637], [99, 637]], "difficult": false}, {"transcription": "\"Ai oi!\" Cuoi cùng gā dàn òng vǎn dang bi Trác Thǎn siět cō tay cǔng gào", "points": [[128, 644], [868, 646], [868, 676], [128, 674]], "difficult": false}, {"transcription": "len, cát ngang ánh mǎt khó hieu giūra hai nguòi.", "points": [[99, 681], [573, 681], [573, 707], [99, 707]], "difficult": false}, {"transcription": "Trác Thǎn xách gā lēn nhu xách mot con gà, quay sang hòi Ly Dinh vǎn", "points": [[127, 716], [869, 714], [869, 744], [127, 746]], "difficult": false}, {"transcription": "dang run ray:\"Anh ta tèn gi?\"", "points": [[97, 751], [400, 748], [400, 779], [97, 782]], "difficult": false}, {"transcription": "\"Vuong Cánh Hang…\"", "points": [[129, 786], [361, 786], [361, 817], [129, 817]], "difficult": false}, {"transcription": "\"Vuong Cánh Hàng dúng khòng?\"Trác Thǎn dùng mu bàn tay tát vào mǎt", "points": [[128, 821], [872, 820], [872, 851], [128, 852]], "difficult": false}, {"transcription": "gā,\"Chia tay rǒi thì ngoan ngoān cút di, theo duòi nguòi ta làm gì? Sau này", "points": [[94, 856], [873, 853], [873, 887], [94, 890]], "difficult": false}, {"transcription": "khòng cho phép anh xuat hien trong pham vi nǎm trǎm mét quanh cò ay, neu", "points": [[97, 891], [871, 888], [871, 918], [97, 921]], "difficult": false}, {"transcription": "khòng tòi gǎp làn nào là sě dánh lǎn ǎy.\" Dut lòi, Trác Thǎn quǎng gā xuǒng", "points": [[96, 923], [873, 922], [873, 953], [96, 954]], "difficult": false}, {"transcription": "dat, tèn hèn nhát kia co rúm nguòi lai khòng dám nhúc nhích.", "points": [[98, 960], [713, 956], [713, 982], [98, 987]], "difficult": false}, {"transcription": "Tong Giám doc Cao dō Ly Dinh da sq den nhūn chàn dày, hòi cò có chuyèn gì.", "points": [[128, 993], [872, 991], [872, 1022], [128, 1024]], "difficult": false}, {"transcription": "Co láp báp giài thích so qua mōt lrot, lo láng nhìn vě phía tèn ban trai cǔ", "points": [[129, 1032], [872, 1028], [872, 1055], [129, 1059]], "difficult": false}, {"transcription": "tròng nhur the chet roi kia:\"Anh ta khòng sao chú?\"", "points": [[99, 1067], [609, 1062], [609, 1089], [99, 1094]], "difficult": false}, {"transcription": "\"Khong sao, cùng lám chi bi gāy xurong cut thoi.\" Trác Thǎn quang ba lo len", "points": [[129, 1102], [873, 1097], [873, 1127], [129, 1132]], "difficult": false}, {"transcription": "vai, ǎn dièu khien mò khóa xe làn nūra.", "points": [[98, 1138], [486, 1135], [486, 1162], [98, 1165]], "difficult": false}, {"transcription": "\"Ha?\" Gāy xurong cut mà chi là\"cùng lám\" thòi sao? Ly Dinh lo láng tói", "points": [[128, 1172], [873, 1168], [873, 1198], [128, 1202]], "difficult": false}, {"transcription": "múrc giàm chàn, khòng biět có nèn báo cành sát hay khòng. Chuyèn bám duòi", "points": [[97, 1207], [874, 1202], [874, 1232], [97, 1237]], "difficult": false}, {"transcription": "có báo cành sát cūng chàng ích loi gì， cành sát khòng xùr ly nǒi máy tèn vò lai", "points": [[98, 1241], [873, 1239], [873, 1266], [98, 1269]], "difficult": false}, {"transcription": "kieu này, nhung bày giò Trác Thǎn dánh nguròi ta mat rǒi， něu bi gay xurong", "points": [[97, 1272], [874, 1272], [874, 1302], [97, 1302]], "difficult": false}, {"transcription": "that sē phai chiu trách nhiem mat.", "points": [[98, 1307], [440, 1305], [440, 1332], [98, 1334]], "difficult": false}, {"transcription": "11", "points": [[469, 1363], [501, 1363], [501, 1389], [469, 1389]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page10.jpg	[{"transcription": "ve aī tam tho", "points": [[453, 50], [588, 47], [588, 71], [453, 74]], "difficult": false}, {"transcription": "\"Hai nguòi di truoe di, o day cú de toi xùr ly.\" Tong Giám dǒc Cao liée nhin", "points": [[183, 93], [890, 90], [890, 121], [183, 124]], "difficult": false}, {"transcription": "Trác Than da mò cura xe, ra hieu cho Ly Dinh ve nhà truóc.", "points": [[154, 132], [700, 127], [700, 151], [154, 156]], "difficult": false}, {"transcription": "Trác Thǎn nhin càu Cao diēn trai cao quy kia vói vè hoi bát ngò, khě cám", "points": [[181, 165], [890, 161], [890, 188], [181, 192]], "difficult": false}, {"transcription": "on mot cau.", "points": [[152, 201], [269, 199], [269, 227], [152, 229]], "difficult": false}, {"transcription": "\"TongGiám dǒc Cao..\"Ly Dinh cam dong suyt khóc vi khong ngò sěp tóng", "points": [[183, 235], [892, 233], [892, 263], [183, 265]], "difficult": false}, {"transcription": "lai giúp dō minh, thě nèn suǒt doc duòng di，, anh vé sī cháng nhūng bi ép nghe", "points": [[154, 270], [892, 266], [892, 296], [154, 300]], "difficult": false}, {"transcription": "\"bài ca tán duong Tong Giám dǒc Cao\"mà còn dugc rira tai bàng tát cá nhūng", "points": [[156, 303], [892, 302], [892, 330], [156, 331]], "difficult": false}, {"transcription": "chuyen nèn biet và khòng nèn biet nüra.", "points": [[157, 340], [523, 338], [523, 363], [157, 365]], "difficult": false}, {"transcription": "Anh sěp trè tuōi dó tèn là Cao Vū Senh, mot cóng tùr nhà giàu hàng thát", "points": [[185, 374], [892, 373], [892, 400], [185, 401]], "difficult": false}, {"transcription": "giá thàt, giàu cái kiěu nhà có may quǎng mò ay. Thě nhung anh chàng này lai", "points": [[154, 408], [892, 402], [892, 435], [154, 440]], "difficult": false}, {"transcription": "khòng muǒn nhàn mòt xu nào tùr bǒ minh, hai muoi tuoi gày dyng lèn Bán do", "points": [[155, 442], [891, 439], [891, 466], [155, 469]], "difficult": false}, {"transcription": "Tieu Diem tùr hai bàn tay tráng. Muon lòi cùa Ly Dinh de nói thi la:\"Dep trai", "points": [[156, 476], [892, 473], [892, 500], [156, 503]], "difficult": false}, {"transcription": "tói murc nguòi và thǎn děu phài cǎm phǎn, thòng minh tói múc tròi cūng phái", "points": [[155, 510], [892, 508], [892, 535], [155, 537]], "difficult": false}, {"transcription": "ghen ti, sur tǒn tai cúa anh ay chính là dě si nhuc nhūng nguòi ban dòng trang", "points": [[155, 543], [893, 542], [893, 572], [155, 573]], "difficult": false}, {"transcription": "lúra xoàng xīnh khòng có chí tiěn thú.\"", "points": [[156, 580], [510, 578], [510, 602], [156, 604]], "difficult": false}, {"transcription": "Trác Than lón hon anh Cao kia tàn mǎy tuoi mà còn dang phài vàt lòn kiem", "points": [[183, 614], [891, 612], [891, 640], [183, 642]], "difficult": false}, {"transcription": "ǎn qua ngày, tur dung cám giác nhu bi trúng mòt vièn dan.", "points": [[154, 651], [697, 648], [697, 674], [154, 677]], "difficult": false}, {"transcription": "\"Chi gái oi, lái xe phài nhin duròng di chú, lái lèn cày bày giò.\" Vé sī Trác", "points": [[184, 685], [891, 683], [891, 710], [184, 712]], "difficult": false}, {"transcription": "khòng the khòng nhác nhò vi khách hàng dang hung phǎn quá dò cúa minh.", "points": [[154, 719], [875, 716], [875, 744], [154, 747]], "difficult": false}, {"transcription": "\"Binh thuòng vé sī nhà nguòi ta deu phài lái xe chú?\" Ly Dinh dánh tay lái,", "points": [[185, 754], [889, 751], [889, 781], [185, 784]], "difficult": false}, {"transcription": "liěc nhìn Trác Than dang ngǒi ngà ngón trèn ghě phu nhu òng kěnh.", "points": [[153, 788], [786, 787], [786, 817], [153, 818]], "difficult": false}, {"transcription": "\"Toi vùra dánh nhau xong co the' yěu ót lám.\" Trác Than thàn nhien khòng", "points": [[184, 827], [893, 825], [893, 852], [184, 854]], "difficult": false}, {"transcription": "biěn sác mǎt, vùra nói vùra mò cia sō xe de khòng khí trong lành iua vào. Mǎt", "points": [[152, 861], [893, 857], [893, 887], [152, 891]], "difficult": false}, {"transcription": "tròi dā ngà vě Tay， phù mōt vǎng sáng vàng am áp lèn chiěc cǎu vrgt nhìn xa", "points": [[153, 896], [893, 892], [893, 922], [153, 926]], "difficult": false}, {"transcription": "xa khòng thǎy dugc dau bèn kia. Thành phǒ bàn ròn tùr tùr chìm vào bóng tǒi", "points": [[151, 930], [890, 926], [890, 956], [151, 960]], "difficult": false}, {"transcription": "nhūng ngon dèn duòng nhur các chú dom dóm sáng dan lèn vǎn khòng the lǎp", "points": [[154, 965], [890, 963], [890, 990], [154, 992]], "difficult": false}, {"transcription": "day cách biet giura mǎt tròi và ánh sao dèm. Canh vàt truróc mát dan trò nèn mo", "points": [[154, 999], [892, 996], [892, 1023], [154, 1026]], "difficult": false}, {"transcription": "hǒ, khòng thǎy rō duoc nūra.", "points": [[152, 1033], [420, 1035], [420, 1062], [152, 1060]], "difficult": false}, {"transcription": "Hien nhién Ly Dinh chǎng hě tin vào lòi giài thích khòng mǎy chàn thành", "points": [[183, 1073], [890, 1073], [890, 1097], [183, 1097]], "difficult": false}, {"transcription": "này. Di het cǎu vuot,co rě vào mòt con duòng khác:\"Ban dǎu òng chù cua các", "points": [[152, 1106], [892, 1106], [892, 1133], [152, 1133]], "difficult": false}, {"transcription": "anh nói anh là quàn At chú bài tòi còn khòng tin, giò thì tòi phuc rǒi. Sao anh", "points": [[154, 1142], [890, 1142], [890, 1166], [154, 1166]], "difficult": false}, {"transcription": "dinh the nhi? Vuong Cánh Hàng cǔng phai děn bay muoi lǎm kilogam, vày mà", "points": [[151, 1172], [891, 1175], [891, 1205], [151, 1202]], "difficult": false}, {"transcription": "anh chi dùng mot tay da vàt ngā durgc anh ta, het nhur xách thò con ay. Co mà", "points": [[150, 1207], [892, 1209], [892, 1239], [150, 1237]], "difficult": false}, {"transcription": "tai sao anh lai phai hít oxy?\"", "points": [[151, 1241], [416, 1245], [416, 1272], [151, 1268]], "difficult": false}, {"transcription": "Quá nhieu càu hói,vè sī At chù bài tùr chǒi trà lòi, xuǒngxe di theo Ly Dinh", "points": [[179, 1276], [894, 1281], [894, 1311], [179, 1306]], "difficult": false}, {"transcription": "vào khu nhà mà cò thuè tro.", "points": [[153, 1309], [415, 1316], [415, 1342], [153, 1336]], "difficult": false}, {"transcription": "12", "points": [[502, 1371], [537, 1371], [537, 1400], [502, 1400]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page11.jpg	[{"transcription": "Lue Da Thien Hac", "points": [[390, 56], [569, 53], [569, 77], [390, 80]], "difficult": false}, {"transcription": "Trèn khumg cura sǎt tao hinh vòng cung có treo bǒn cho\"TháiTrangTan", "points": [[130, 102], [861, 102], [861, 126], [130, 126]], "difficult": false}, {"transcription": "Thành\" làm bàng tòn dā tróe son. O chǒt báo vè có mot òng lao dang ngoi òm", "points": [[98, 134], [863, 133], [863, 159], [98, 160]], "difficult": false}, {"transcription": "radio gàt gù, chàng thèm quan tàm vào cira là nguòi, là ma hay dong vàt, thám", "points": [[98, 169], [863, 166], [863, 193], [98, 196]], "difficult": false}, {"transcription": "nhuan tur turòng lón\"Vo vi nhi tri\".", "points": [[97, 202], [449, 201], [449, 228], [97, 229]], "difficult": false}, {"transcription": "Trác Than biet khu dàn cu này. Truóc dày ho o mòt thòn nòi do tèn Thái", "points": [[126, 238], [864, 237], [864, 264], [126, 265]], "difficult": false}, {"transcription": "Trang, máy nǎm truóc bi giài tòa rǒi dèn bù xày dng khu dinh cu mói lǎy", "points": [[98, 274], [863, 273], [863, 300], [98, 301]], "difficult": false}, {"transcription": "tèn là Thái Trang Tan Thành. Có lòi don ràng ò dày toàn nhūng cǎn ho dě sup", "points": [[97, 307], [863, 308], [863, 335], [97, 334]], "difficult": false}, {"transcription": "là dang còng trinh kém chat luong, ǒn ào suǒt mòt thòi gian dài khiěn cho giá", "points": [[95, 341], [864, 340], [864, 370], [95, 371]], "difficult": false}, {"transcription": "thuè nhà ré bàng mòt phan ba nhūng khu vuc xung quanh.", "points": [[97, 376], [679, 377], [679, 404], [97, 403]], "difficult": false}, {"transcription": "Trongkhu dàn cu khòng có còng trinh xanh hóa gì may, něn xi mǎng ké", "points": [[128, 416], [863, 416], [863, 439], [128, 439]], "difficult": false}, {"transcription": "ò vuòng ván, lū trè con cǎm theo ván trurgt vùra chay vùra kèuí ói trong sàn", "points": [[98, 449], [861, 449], [861, 473], [98, 473]], "difficult": false}, {"transcription": "Nhùng tòa nhà cu dàn thò so to lón nhur mòt nguòi trung nien màp map, bèn", "points": [[96, 482], [864, 481], [864, 508], [96, 509]], "difficult": false}, {"transcription": "trong chia làm bǒn khu nhò, khòng thòng vói nhau.", "points": [[99, 519], [608, 519], [608, 543], [99, 543]], "difficult": false}, {"transcription": "Khu mà Ly Dinh ò chi có mòt chiěc thang máy, mot tǎng có ba ho. Trong", "points": [[126, 552], [864, 554], [864, 581], [126, 579]], "difficult": false}, {"transcription": "thang máy chat dǒng mǎy tǎm ván gō dính dày xi mǎng, xung quanh dán chi", "points": [[97, 589], [863, 588], [863, 615], [97, 616]], "difficult": false}, {"transcription": "chít nhing tò quàng cáo rat chuóng mát. Hoàn cành sǒng thě này hoàn toàn", "points": [[98, 623], [864, 622], [864, 649], [98, 650]], "difficult": false}, {"transcription": "khác xa vói vǎn phòng rurc rō lóa mát cùa ban ngày.", "points": [[96, 656], [608, 658], [608, 686], [96, 684]], "difficult": false}, {"transcription": "\"Còò tang muòi tám mà khòng sg à?\" Trác Than nhin bàng phím bǎm màu", "points": [[128, 693], [864, 694], [864, 720], [128, 719]], "difficult": false}, {"transcription": "dò troi， phòng ǒc ò dày sáp dǎt rǎt vò tō chúc, còn khòng viět tang 18 thành", "points": [[96, 727], [864, 726], [864, 756], [96, 757]], "difficult": false}, {"transcription": "tang 17A nhu thói quen cùa nhūng khu nhà thòng thuòng khác.", "points": [[97, 764], [733, 763], [733, 790], [97, 791]], "difficult": false}, {"transcription": "\"van on, giá thuè cùa tang muòi tám ré nhat.\" Ly Dinh ngai ngùng cuòi nói.", "points": [[127, 797], [864, 801], [864, 831], [127, 827]], "difficult": false}, {"transcription": "Trác Than gàt dàu thau hieu ngay. Vi phài chǎm chút và giū vé ngoài sáng", "points": [[125, 834], [866, 839], [866, 870], [125, 865]], "difficult": false}, {"transcription": "sua nén hǎu hět mqi chi tiéu cùa mot sǒ còng nhàn vièn ò thành thi děu dǒ vào", "points": [[95, 873], [866, 872], [866, 902], [95, 903]], "difficult": false}, {"transcription": "ǎn mǎc và xe cò di lai， còn ǎn vói ò thì chi tam bo qua ngày thòi.", "points": [[96, 909], [727, 908], [727, 935], [96, 936]], "difficult": false}, {"transcription": "Cira thang máy mò ra ò tang muòi tám, tiěng nhac dinh tai nhúéc óc nhu", "points": [[125, 944], [868, 945], [868, 976], [125, 975]], "difficult": false}, {"transcription": "sóng thàn láp kín lǒ tai anh.", "points": [[97, 983], [375, 979], [375, 1006], [97, 1010]], "difficult": false}, {"transcription": "\"ó, múa quàng truòng³ ò trong nhà luòn à?\" Ra khòi thang máy là mòt", "points": [[126, 1017], [869, 1017], [869, 1047], [126, 1047]], "difficult": false}, {"transcription": "hành lang thǎng nǒi liěn ba hò gia dinh, phía cuǒi hành lang có mòt cira sō nhò", "points": [[94, 1054], [868, 1053], [868, 1080], [94, 1081]], "difficult": false}, {"transcription": "thòng gió. Ly Dinh tro ò cǎn phòng bén canh cira sǒ, còn tiěng ǒn ào phát ra tùr", "points": [[96, 1090], [868, 1088], [868, 1115], [96, 1117]], "difficult": false}, {"transcription": "cǎn ho nàm ò giūra, kě bèn phòng co. Trác Than thuàn tay gō cǒc cǒc vào cúra,", "points": [[96, 1123], [867, 1122], [867, 1152], [96, 1153]], "difficult": false}, {"transcription": "nguòi bén trong còn bàn cuòi nói, chǎng ai nghe thay gì.", "points": [[96, 1160], [655, 1157], [655, 1187], [96, 1190]], "difficult": false}, {"transcription": "1 无为而治：Vo vi nhitri xuát phát tù Dao Dúc Kinh, có nghīa là mqi thú thuān theo ty nhien, khōng cànphài có", "points": [[95, 1214], [868, 1215], [868, 1239], [95, 1238]], "difficult": false}, {"transcription": "hành vi tác dōng gi， là tu tuòng chính tri và thái dō dói nhān xù thé cùa Dao gia thòi cǒ dai.", "points": [[93, 1237], [720, 1236], [720, 1260], [93, 1261]], "difficult": false}, {"transcription": "2Nguòi Trung Quòe quan niem con gái két hòn lúc 18 tuói sě phài gánh dù\"18 kiép nan\".", "points": [[94, 1258], [712, 1258], [712, 1280], [94, 1280]], "difficult": false}, {"transcription": "Múa quáng trròng: là mōt mōn lón nhát trong hè thóng nghē thuàt vǔ dao cúa Trung Quóc. Múa quàng tnuòng", "points": [[93, 1276], [868, 1278], [868, 1302], [93, 1300]], "difficult": false}, {"transcription": "két hgp tinh giái trí và bièu diēn, dùng hinh thúre bièu diēn dǎc thù, thoài mái dè thè hiēn nqi dung, chú yèu là múa", "points": [[94, 1297], [867, 1298], [867, 1322], [94, 1321]], "difficult": false}, {"transcription": "tàp thé. Có thè hièu nó nhu dang múa dàn vǔ, thuòng phǒ bién trong lúra tuǒi trung lǎo niēn.", "points": [[96, 1320], [722, 1320], [722, 1340], [96, 1340]], "difficult": false}, {"transcription": "13", "points": [[464, 1365], [501, 1368], [498, 1397], [462, 1394]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page12.jpg	[{"transcription": "ve sī tam thoi", "points": [[462, 57], [599, 53], [600, 76], [463, 81]], "difficult": false}, {"transcription": "Ly Dinh nhún vai:\"Hàng xóm là mot bà co, trong nhà tu tàp cá dǒng nguòn,", "points": [[179, 101], [903, 97], [903, 126], [179, 131]], "difficult": false}, {"transcription": "ngày nào cūng on ào, khòng biét là dánh bài hay nháy nhót. Trróc dày tói còn", "points": [[149, 136], [905, 127], [905, 158], [149, 167]], "difficult": false}, {"transcription": "càm thǎy phièn, nhung bay giò lai càm thǎy rát yèn tàm.\"", "points": [[150, 172], [698, 163], [698, 190], [150, 198]], "difficult": false}, {"transcription": "Bi kè dièn chǎn duòng bao ngày tròi nèn giò nghe thǎy tiéng òn ào cúa nhà", "points": [[179, 207], [904, 198], [904, 225], [179, 234]], "difficult": false}, {"transcription": "hàng xóm cūng càm thày thàn thiét.", "points": [[150, 242], [499, 236], [499, 263], [150, 269]], "difficult": false}, {"transcription": "Trác Than cǎm chia khóa mò cúra phòng, bat hét dèn duǒc trong nhà len", "points": [[181, 275], [905, 268], [905, 294], [181, 301]], "difficult": false}, {"transcription": "kiem tra mòt luot, khòng phát hièn có gi bat thuòng mói quay lung ra vě:", "points": [[150, 308], [904, 301], [904, 329], [150, 336]], "difficult": false}, {"transcription": "\"Sáng mai tòi tói dón cò di làm.\"", "points": [[153, 344], [472, 338], [472, 365], [153, 371]], "difficult": false}, {"transcription": "\"Anh lái xe vě di, hàng tháng còng ty chúng tòi dèu có the thanh toán mòt", "points": [[182, 376], [907, 369], [907, 398], [182, 406]], "difficult": false}, {"transcription": "khoàn tien xǎng xe nhat dinh.\" Ly Dinh dua chia khóa cho anh.", "points": [[151, 411], [752, 402], [752, 430], [151, 439]], "difficult": false}, {"transcription": "\"Khòng cǎn dàu, nhà tòi khòng có chō dō.\"", "points": [[184, 448], [591, 438], [591, 466], [184, 476]], "difficult": false}, {"transcription": "Ra khòi hành lang, ngoài tròi da tǒi hàn, khu chung cu này khòng có dèn", "points": [[182, 481], [908, 475], [908, 503], [182, 509]], "difficult": false}, {"transcription": "duòng mqi nguòi děu nhò vào ánh dèn hát tùr ngoài duòng lón mói miěn", "points": [[153, 516], [907, 507], [907, 534], [153, 543]], "difficult": false}, {"transcription": "curōng thay duroc löi di. Trác Than lǎy chiec dèn pin cam tay tùr trong ba lò ra,", "points": [[153, 550], [908, 542], [908, 569], [153, 577]], "difficult": false}, {"transcription": "chieu sáng mot khoáng phía truróc, vùra di vùra dùng dièn thoai dǎt xe.", "points": [[153, 582], [815, 576], [815, 603], [153, 609]], "difficult": false}, {"transcription": "Nhanh chóng có nguròi nhàn don, mòt chiěc Toyota màu den ò ngay gan", "points": [[182, 618], [906, 612], [906, 639], [182, 645]], "difficult": false}, {"transcription": "day, chác anh di bò ra den duròng cái thì xe cūng tói. Trác Than nhét dien thoai", "points": [[153, 651], [907, 642], [907, 672], [153, 681]], "difficult": false}, {"transcription": "vào túi quǎn, ra khòi khu chung cu dó mói cǎt dèn pin di. Trèn con phǒ nhò", "points": [[153, 686], [908, 677], [908, 704], [153, 713]], "difficult": false}, {"transcription": "bèn ngoài dang có phièn chg dèm, dèn duoc sáng trurng. Xuyèn qua con phǒ", "points": [[151, 719], [908, 711], [908, 738], [151, 745]], "difficult": false}, {"transcription": "nhó ay, duròng lai tǒi dan, anh vùra di vùra děm buóc thi thay mot chiěc xe màu", "points": [[152, 751], [908, 744], [908, 772], [152, 779]], "difficult": false}, {"transcription": "den cham rāi dirng lai.", "points": [[152, 786], [367, 784], [367, 811], [152, 813]], "difficult": false}, {"transcription": "Trác Than mò cra xe, ngǒi vào ghe phu:\"Bác tài, toi dǎt xe day.Cho toi den", "points": [[178, 821], [909, 814], [909, 842], [178, 849]], "difficult": false}, {"transcription": "khu tàp the gia dinh cúa nhàn vièn Cuc Canh sát vói.\"", "points": [[151, 856], [668, 850], [668, 877], [151, 883]], "difficult": false}, {"transcription": "Tùr xa Cao Vū Senh da nhin thay Trác Than dang di bo nèn bat giác lái cham", "points": [[177, 892], [910, 888], [910, 914], [177, 918]], "difficult": false}, {"transcription": "lai. Nào ngò tèn này lai mò luòn cira xe ngǒi vào, còn tu giác thát dày an toàn", "points": [[150, 927], [911, 924], [911, 951], [150, 954]], "difficult": false}, {"transcription": "nūra chúr. Cao Vū Sènh kinh ngac nhin logo sieu xe to dùng gán trèn dau muixe", "points": [[149, 961], [912, 957], [912, 983], [149, 988]], "difficult": false}, {"transcription": "minh, dòi cánh thièn súr gǎn nhur che làp cá kính chán gió, the nào mà tèn này", "points": [[149, 993], [911, 991], [911, 1018], [149, 1020]], "difficult": false}, {"transcription": "lai có the nghī nó là taxi cong nghē dugc chúr nhi?", "points": [[149, 1028], [623, 1026], [623, 1053], [149, 1055]], "difficult": false}, {"transcription": "Dǎt mōt chén trà bēn ao nuóc, ngò dàu cá chép tur nhay vào.", "points": [[177, 1066], [749, 1063], [749, 1090], [177, 1093]], "difficult": false}, {"transcription": "Hán láng lǎng nhǎn chan ga,\"Phien anh doc lai sǒ dièn thoai a.\"", "points": [[176, 1101], [791, 1099], [791, 1129], [176, 1131]], "difficult": false}, {"transcription": "De kiem tra doi chiěu thòng tin cúa khách hàng nèn thinh thoàng tài xe còng", "points": [[175, 1136], [913, 1138], [913, 1168], [175, 1166]], "difficult": false}, {"transcription": "nghe cǔng sē yeu cǎu báo duòi sǒ dien thoai.", "points": [[147, 1174], [574, 1172], [574, 1202], [147, 1204]], "difficult": false}, {"transcription": "\"ò.\"Trác Than vùa an nút goi di, dièn thoai còn dang de bèn tai. Lúc goi", "points": [[176, 1207], [911, 1211], [911, 1241], [176, 1237]], "difficult": false}, {"transcription": "dién thoai, con nguòi ta thuròng sē phán úng vói thě giói bèn ngoài khá chàm", "points": [[150, 1246], [912, 1246], [912, 1272], [150, 1272]], "difficult": false}, {"transcription": "chap, nèn anh thuán miéng doc luòn cá day sǒ dien thoai cúa minh ra. Dúng", "points": [[150, 1280], [912, 1280], [912, 1307], [150, 1307]], "difficult": false}, {"transcription": "lúc này dàu dày bèn kia cǔng nhac máy,\"A lò, hai nguòi da vě nhà chua?\"", "points": [[147, 1310], [871, 1308], [871, 1341], [147, 1343]], "difficult": false}, {"transcription": "14", "points": [[502, 1377], [539, 1377], [539, 1403], [502, 1403]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page13.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[388, 57], [564, 57], [564, 78], [388, 78]], "difficult": false}, {"transcription": "\"Hoi thira, giò là mǎy giò rǒi!\" Dau bèn kia truyěn tói mot giong gát gòng", "points": [[131, 99], [795, 101], [795, 128], [131, 126]], "difficult": false}, {"transcription": "\"OK, vày giò anh vě thàng nhà luòn.\" Trác Than cúp dièn thoai truóc khi", "points": [[130, 135], [858, 135], [858, 161], [130, 161]], "difficult": false}, {"transcription": "dǒi phurong kip nói thém gì. Bǎy giò anh mói phát hièn ghě cùa chiěc xe này", "points": [[101, 169], [857, 169], [857, 196], [101, 196]], "difficult": false}, {"transcription": "ngòi thoài mái la thuòng, tò mò khòng biět dày là dòng xe nào cùa Toyota,", "points": [[101, 203], [857, 202], [857, 229], [101, 230]], "difficult": false}, {"transcription": "dang dinh hòi bác tài thì dièn thoai lai vang lèn, là mòt day so la.", "points": [[103, 237], [727, 237], [727, 261], [103, 261]], "difficult": false}, {"transcription": "\"Xin chào, có phài anhTrác khòng a? Toi dā tóni rǒi, anh dang ò dàu dày a?\"", "points": [[132, 269], [805, 268], [805, 298], [132, 299]], "difficult": false}, {"transcription": "\"\"Lái xe thuc su vān dang dúng bèn duòng doi anh, vày thì chiec xe này", "points": [[125, 303], [860, 307], [860, 337], [125, 333]], "difficult": false}, {"transcription": ".", "points": [[143, 322], [162, 322], [162, 333], [143, 333]], "difficult": false}, {"transcription": "là sao? Trác Than chot noi hět da gà, lanh lùng nhin sang nguòi dang ngǒi ò", "points": [[102, 340], [860, 341], [860, 368], [102, 367]], "difficult": false}, {"transcription": "bèn ghě lái.", "points": [[101, 373], [219, 373], [219, 404], [101, 404]], "difficult": false}, {"transcription": "Xe da di ra duròng lón,chiěc xe doi dièn chura tát dèn pha,ánh sáng chói mát", "points": [[130, 409], [859, 409], [859, 435], [130, 435]], "difficult": false}, {"transcription": "chieu tói vùra vǎn soi rō guong mǎt góc canh dien trai cùa Cao Vū Sènh,làm noi", "points": [[103, 442], [858, 442], [858, 469], [103, 469]], "difficult": false}, {"transcription": "bàt doi mát sàu hon nguòi thuòng cúa hán.", "points": [[102, 475], [521, 474], [521, 501], [102, 502]], "difficult": false}, {"transcription": "\"Tong Giám doc Cao?\" Trác Than càng kinh ngac hon,\"Sao lai là càu?\"", "points": [[129, 509], [823, 508], [823, 538], [129, 539]], "difficult": false}, {"transcription": "\".\" Cao Vū Senh quay dau nhin anh,\"Tòi dang dō xe ven duròng thì tr", "points": [[132, 544], [860, 548], [860, 576], [132, 572]], "difficult": false}, {"transcription": "dung anh mò cira xe buóc vào. Khòng sao, vùa hay cūng tièn duòng.", "points": [[103, 579], [773, 582], [773, 610], [103, 607]], "difficult": false}, {"transcription": "Trác Than khē nhuóng mày.", "points": [[130, 614], [409, 618], [409, 644], [130, 640]], "difficult": false}, {"transcription": "\"Anh.. là ban trai cùa Ly Dinh à?\" Cao Vū Senh thong thà hòi, giong nói", "points": [[132, 650], [859, 654], [859, 681], [132, 677]], "difficult": false}, {"transcription": "mang mot nhip dieu dǎc biet,khien nguòi nghe càm thay rǎt thoài mái.", "points": [[103, 687], [792, 686], [792, 712], [103, 713]], "difficult": false}, {"transcription": "Thì ra là the!", "points": [[128, 718], [259, 721], [259, 748], [128, 746]], "difficult": false}, {"transcription": "Trác Thǎn chǒng tay lèn, nghièng dǎu quan sát vi nhàn tài cúa xā hòi này.", "points": [[128, 754], [860, 756], [860, 786], [128, 784]], "difficult": false}, {"transcription": "Vùra nghe truyěn thuyět vě nguòi ta suǒt cà chǎng duòng dài, giò lai dugc gǎp", "points": [[101, 786], [862, 788], [862, 822], [101, 820]], "difficult": false}, {"transcription": "ngay nhàn vàt chính, dúngla ky dieu thàt. Anh biet ngay mà, làm sao tr dung", "points": [[101, 822], [864, 822], [864, 855], [101, 855]], "difficult": false}, {"transcription": "ong chù lai tot bung giài quyět hàu quà cho anh nhur vày duroc, thì ra là kich", "points": [[101, 859], [862, 857], [862, 884], [101, 886]], "difficult": false}, {"transcription": "bàn\"sěp tōng dòc tài yèu tham cò thur ky\" quen thuòc. Chác vi lo cho Ly Dinh", "points": [[101, 892], [862, 890], [862, 917], [101, 919]], "difficult": false}, {"transcription": "nèn lúc nāy hǎn mói xuat hièn ò con phǒ ban thiu hǒn loan kia chǎng?", "points": [[103, 927], [783, 927], [783, 951], [103, 951]], "difficult": false}, {"transcription": "Vè sī khòng chuyen cūng phài có dao dúrc nghě nghièp, tuyèt doi khòng thě", "points": [[130, 963], [863, 960], [863, 986], [130, 990]], "difficult": false}, {"transcription": "gày ra hieu lam vě mǎt tinh cám cho khách hàng cúa minh duoc. Trác Than", "points": [[102, 997], [863, 991], [863, 1019], [102, 1024]], "difficult": false}, {"transcription": "vòivàng giài thích:\"Khòng phai, tòi là vè sī mà có ay thuè, thu phí theo ngày.\"", "points": [[102, 1029], [861, 1027], [861, 1054], [102, 1056]], "difficult": false}, {"transcription": "\"vè sī.\" Cao Vū Sènh nhò giong lǎp lai tùr này rǒi khòng nói thēm gì nüa,", "points": [[131, 1065], [861, 1065], [861, 1092], [131, 1092]], "difficult": false}, {"transcription": "dura Trác Than tói gan khu tàp the gia dinh cua anh. Dàng truóc còn có mot con", "points": [[101, 1099], [863, 1098], [863, 1125], [101, 1126]], "difficult": false}, {"transcription": "duòng nhó khòng tièn di xe vào, Trác Than bào hán dǒ xe ven duòng rǒi ty mò", "points": [[101, 1133], [864, 1130], [864, 1160], [101, 1163]], "difficult": false}, {"transcription": "cira chuan bi buóc xuǒng.", "points": [[101, 1167], [355, 1170], [355, 1197], [101, 1194]], "difficult": false}, {"transcription": "\"Nay, dqi da!\" Cao Vū Senh nhur chot nhó ra dièu gì nèn goi anh lai, nhung", "points": [[129, 1203], [864, 1202], [864, 1232], [129, 1233]], "difficult": false}, {"transcription": "khi Trác Than quay dau thì hán lai hoi láp báp,\"Anh.. bao nhièu tièn mot ngày?\"", "points": [[98, 1236], [859, 1235], [859, 1264], [98, 1266]], "difficult": false}, {"transcription": "\"Ha?\" Cau hòi dot ngot này khien Trác Than bat cuòi. Anh ghé sát lai gan,", "points": [[129, 1273], [861, 1272], [861, 1300], [129, 1301]], "difficult": false}, {"transcription": "nhò giong nói,\"Tōng Giám dǒc Cao, tòi là vé sī dúmg dán mà.\"", "points": [[99, 1307], [716, 1304], [716, 1334], [99, 1337]], "difficult": false}, {"transcription": "15", "points": [[462, 1365], [499, 1365], [499, 1393], [462, 1393]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page14.jpg	[{"transcription": "Chuong3", "points": [[471, 104], [595, 100], [596, 132], [472, 136]], "difficult": false}, {"transcription": "Sao trentroi (3)", "points": [[372, 154], [684, 151], [684, 192], [372, 194]], "difficult": false}, {"transcription": "Cao Vū Sènh nghèt ra, khòng hiéu chuyén này thì có lièn quan gì tói viée", "points": [[192, 276], [899, 273], [899, 304], [192, 307]], "difficult": false}, {"transcription": "dúrng dǎán hay khòng.", "points": [[165, 314], [370, 314], [370, 342], [165, 342]], "difficult": false}, {"transcription": "\"Ha ha ha..\"Trác Than khong nhin noi bat cuòi thành tieng, tre con dě choc", "points": [[192, 348], [900, 345], [900, 375], [192, 378]], "difficult": false}, {"transcription": "thàt day. Anh nháy xuǒng xe vǎy tay vě phía sau, di thǎng vě huóng quán bán", "points": [[164, 386], [898, 382], [898, 409], [164, 414]], "difficult": false}, {"transcription": "do kho, khong ngoanh dau lai.", "points": [[164, 421], [455, 419], [455, 446], [164, 447]], "difficult": false}, {"transcription": "Khu tàp thě cǔ này vǎn giū nép sǒng hàng xóm thán thiět tùr thě ky truróc.", "points": [[192, 457], [896, 453], [896, 480], [192, 484]], "difficult": false}, {"transcription": "Dèm dàu ha ròn ràng děn la, mòt dāy quán nhò ven duòng sáng rurc ánh dèn", "points": [[164, 492], [897, 488], [897, 515], [164, 519]], "difficult": false}, {"transcription": "vàng ǎm áp, dám thièu thàn và nguròi di duòng qua lai chào hòi lǎn nhau", "points": [[164, 526], [899, 521], [899, 551], [164, 556]], "difficult": false}, {"transcription": "quanh ánh dèn.", "points": [[165, 564], [314, 558], [315, 586], [166, 592]], "difficult": false}, {"transcription": "\"Ong chù, cho mòt hòp co vit.\"", "points": [[194, 597], [486, 595], [486, 625], [194, 627]], "difficult": false}, {"transcription": "\"ǒke. Cau lai choc giàn Phuong So Duong à?\"Ong chú quán do kho có vè", "points": [[193, 630], [900, 629], [900, 663], [193, 664]], "difficult": false}, {"transcription": "rat quen thàn vói Trác Than, nhanh nhen dóng gói cho anh mot phan cǒ vit cay.", "points": [[165, 670], [897, 667], [897, 694], [165, 698]], "difficult": false}, {"transcription": "\"Dau, gita duròng cáu ay goi dien cho tòi khóc lóc goi'anh oi' nén tòi mói", "points": [[193, 706], [897, 701], [897, 731], [193, 735]], "difficult": false}, {"transcription": "mua cho day chú.\"", "points": [[163, 743], [343, 739], [343, 767], [163, 770]], "difficult": false}, {"transcription": "Trác Than nhàn lày hòp cǒ vit, quay dau lai, thay chiěc sièu xe bóng loáng kia", "points": [[191, 778], [896, 774], [896, 802], [191, 806]], "difficult": false}, {"transcription": "vǎn dǒ nguyèn tai chō. Chot nhó ra quèn chua cám on càu ban dep traigiàu có da", "points": [[164, 814], [897, 809], [897, 836], [164, 841]], "difficult": false}, {"transcription": "cho di nhò xe,anh làp túc chòp ngay lǎy mōt phǎn cō vit khác trèn tay òng chù.", "points": [[163, 849], [874, 844], [874, 872], [163, 877]], "difficult": false}, {"transcription": "\"Tam biet.\"", "points": [[189, 885], [306, 883], [306, 915], [189, 917]], "difficult": false}, {"transcription": "Tu dung bi dúi mot hòp dǒ kho lanh ngát vào tay, Cao Vū Sènh khē nhíu", "points": [[189, 924], [897, 919], [897, 949], [189, 954]], "difficult": false}, {"transcription": "mày nhin theo nguòi dàn òng da quay lung vě phía minh, phóng khoáng phat", "points": [[162, 961], [898, 956], [898, 983], [162, 989]], "difficult": false}, {"transcription": "tay di xa dan.", "points": [[160, 995], [292, 990], [293, 1021], [161, 1026]], "difficult": false}, {"transcription": "\"Siri, mày nói xem, lièu tính cách cúa con nguòi ta có thay doi khòng?\"", "points": [[191, 1029], [854, 1027], [854, 1058], [191, 1060]], "difficult": false}, {"transcription": "Man hinh di dòng dǎt trèn giá do sáng lén, xuàt hièn giao dièn dǒi thoai vói", "points": [[189, 1069], [897, 1067], [897, 1094], [189, 1096]], "difficult": false}, {"transcription": "AI dien thoai. Giong nói dien tùr phát ra tùng chūr rō ràng:\"Duong nhièn roi", "points": [[161, 1104], [896, 1102], [896, 1129], [161, 1131]], "difficult": false}, {"transcription": "thwa ngài. Mōt khi tính cách dā dugc hinh thành thì tuong dòi òn dinh, nhung khōng", "points": [[160, 1138], [898, 1136], [898, 1166], [160, 1168]], "difficult": false}, {"transcription": "có nghīa là khòng thay dōi， mà có thé nhào nǎn bǒi dǎp. Nói theo góc dō trièt hoc thi tāt", "points": [[161, 1173], [897, 1170], [897, 1198], [161, 1201]], "difficult": false}, {"transcription": "ca sy vāt dèu dang trong quá trinh thay dòi và phát triēn.\"", "points": [[161, 1208], [662, 1206], [662, 1234], [161, 1236]], "difficult": false}, {"transcription": "Khu táp the gia dinh cúa nhán vien Cuc Cánh sát thành phǒ là mot khu tàp", "points": [[189, 1245], [897, 1246], [897, 1272], [189, 1271]], "difficult": false}, {"transcription": "the cū khong có thang máy. Trác Than sái buóc hai bàc mōt, khē khàng day cira", "points": [[160, 1276], [897, 1277], [897, 1307], [160, 1306]], "difficult": false}, {"transcription": "Artificial inteligence (vit tát la Al): trí thong minhnhan tao, hay trí tu nhan tao.", "points": [[162, 1319], [697, 1322], [697, 1349], [162, 1346]], "difficult": false}, {"transcription": "16", "points": [[509, 1374], [545, 1374], [545, 1403], [509, 1403]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page15.jpg	[{"transcription": "Lue Da Tnien Hac", "points": [[392, 60], [567, 60], [567, 81], [392, 81]], "difficult": false}, {"transcription": "ra. Chiēe giá quàn áo canh cùra có treo mòt bò cánh phuc, trong phòng khách", "points": [[96, 101], [862, 104], [862, 131], [96, 128]], "difficult": false}, {"transcription": "van còn sáng dèn, mòt nguòi dàn òng cǎt dàu dinh mǎc áo ba lǒ den dang ngǒi", "points": [[97, 132], [864, 136], [864, 165], [97, 162]], "difficult": false}, {"transcription": "xem mòt chong tài lièu dày bèn bàn ǎn. Dó chính là Phurong So Duong nguòi", "points": [[97, 167], [863, 171], [863, 198], [97, 194]], "difficult": false}, {"transcription": "anh em tren ho khau cua Trác Than.", "points": [[97, 202], [451, 203], [451, 230], [97, 229]], "difficult": false}, {"transcription": "\"Còn biet duòng vě co à, sao anh khòng chet ò ngoài luon di?\" Phuong So", "points": [[126, 237], [864, 241], [864, 271], [126, 267]], "difficult": false}, {"transcription": "Duong cham choc Trác Than, còn chang thèm ngang dau len.", "points": [[97, 273], [699, 275], [699, 303], [97, 301]], "difficult": false}, {"transcription": "\"Bòi vì chú da bàn lám ròi nèn anh mói khòng tǎng thèm gánh nǎng cho dāi", "points": [[126, 309], [863, 314], [863, 341], [126, 336]], "difficult": false}, {"transcription": "canh sát hinh sur các chú day.\" Trác Than nhìn sang phòng cúa cháu trai tháy", "points": [[96, 344], [863, 348], [863, 376], [96, 372]], "difficult": false}, {"transcription": "cira da dóng,hǎn là thàng bé ngù rǒi", "points": [[99, 383], [462, 383], [462, 407], [99, 407]], "difficult": false}, {"transcription": "\"Bòp!\" Vien giay trong tay canh sát Phuong dàp trúng dau vé sī Trác:\"Anh", "points": [[127, 416], [863, 419], [863, 446], [127, 444]], "difficult": false}, {"transcription": "bò Mòng Mong lai Cuc Canh sát roi chay mat mà còn dám to mòm thě a!\"", "points": [[94, 452], [820, 451], [820, 478], [94, 479]], "difficult": false}, {"transcription": "\"Tai anh khòng còn cách nào khác mà. Thòi nào, cǒ vit cùa chú day.\" Trác", "points": [[127, 487], [864, 490], [864, 517], [127, 514]], "difficult": false}, {"transcription": "Than chàng hě áy náy, dǎt hòp do ǎn lèn mǎt bàn rǒi quay lung di lày bia trong", "points": [[94, 520], [865, 525], [865, 556], [94, 551]], "difficult": false}, {"transcription": "tù lanh.", "points": [[94, 557], [175, 557], [175, 585], [94, 585]], "difficult": false}, {"transcription": "Phuong So Duong túrc trào máu hong:\"Co vit cua anh thì có!\"", "points": [[125, 593], [737, 592], [737, 622], [125, 623]], "difficult": false}, {"transcription": "\"Suyt, ding dánh thúrc Mong Mong.\"Trác Than ném hai lon bia cho Phuong", "points": [[125, 627], [866, 631], [866, 665], [125, 661]], "difficult": false}, {"transcription": "So Duong, sau dó lai di quanh bep mot vòng phát hien trong nǒi vǎn còn phan", "points": [[94, 666], [863, 668], [863, 695], [94, 693]], "difficult": false}, {"transcription": "com cho minh bèn hón hò xói mot bát.", "points": [[97, 702], [477, 702], [477, 726], [97, 726]], "difficult": false}, {"transcription": "Tùr nhò Phuong So Duong da thích ǎn co vit kho cay. Cúr mǒi lǎn choc", "points": [[122, 736], [863, 738], [863, 765], [122, 763]], "difficult": false}, {"transcription": "giàn Phuong So Duong là Trác Than děu mua co vit cho anh ta, lan nào", "points": [[94, 773], [864, 771], [864, 798], [94, 800]], "difficult": false}, {"transcription": "cūng hieu nghiem. Canh sát Phuong tring mát nhin cái tèn dang vùi dau", "points": [[95, 807], [863, 807], [863, 834], [95, 834]], "difficult": false}, {"transcription": "ǎn com, hung ton gǎm mot mieng cǒ vit, cúr nhu thē thúr trong tay minh là", "points": [[94, 842], [864, 842], [864, 869], [94, 869]], "difficult": false}, {"transcription": "co cùa Trác Than vay.", "points": [[93, 874], [321, 878], [321, 905], [93, 901]], "difficult": false}, {"transcription": "Trác Thǎn mò bia, cham lon vói nguòi anh em cúa minh, tò mò nhin lén tài", "points": [[121, 912], [864, 914], [864, 942], [121, 940]], "difficult": false}, {"transcription": "liéu trong tay anh ta:\"Dó là gì day?\"", "points": [[91, 950], [457, 950], [457, 977], [91, 977]], "difficult": false}, {"transcription": "\"ò thành Nam xày ra mòt vu án mang, dugc chuyěn tói Cuc thành phǒ", "points": [[121, 981], [866, 987], [866, 1017], [121, 1012]], "difficult": false}, {"transcription": "de diěu tra.\" Diěu tra án hinh su là chuyèn co mát, nèn dù là nguòi nhà thì", "points": [[90, 1018], [865, 1020], [865, 1050], [90, 1048]], "difficult": false}, {"transcription": "Phuong So Duong cǔng sē khòng nói quá nhieu vói anh. Và lai anh ta cūng biět", "points": [[90, 1055], [864, 1056], [864, 1083], [90, 1082]], "difficult": false}, {"transcription": "tèn ho Trác này chi hòi vu vo vày thòi, có nói chác gì anh dā nghe.", "points": [[90, 1089], [747, 1091], [747, 1119], [90, 1117]], "difficult": false}, {"transcription": "\"O\" Trác Thǎn cam mòt mieng cō vit lèn ǎn, nhin chàm chàm vào xoáy tóc", "points": [[120, 1123], [865, 1127], [865, 1157], [120, 1153]], "difficult": false}, {"transcription": "trèn dinh dau cánh sát Phurong mot lúc. Anh gō mòt ngón tay xuong mǎt bàn,", "points": [[90, 1163], [864, 1166], [864, 1193], [90, 1190]], "difficult": false}, {"transcription": "nghiém túc nói:\"Dèm qua bǒ báo mong cho anh day.\"", "points": [[91, 1200], [631, 1200], [631, 1227], [91, 1227]], "difficult": false}, {"transcription": "\"Báo gi?\" Phuong So Duong nguóc len nhin anh.", "points": [[121, 1235], [612, 1237], [612, 1264], [121, 1261]], "difficult": false}, {"transcription": "\"Nhò anh tim nguròi yèu cho chú.\"", "points": [[120, 1270], [466, 1273], [466, 1300], [120, 1298]], "difficult": false}, {"transcription": "\"Cút.\"", "points": [[118, 1306], [189, 1306], [189, 1336], [118, 1336]], "difficult": false}, {"transcription": "17", "points": [[460, 1362], [494, 1362], [494, 1392], [460, 1392]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page16.jpg	[{"transcription": "ve sī tam thā", "points": [[467, 53], [607, 51], [607, 75], [467, 77]], "difficult": false}, {"transcription": "Trác Than vot ngay vào bep rira bát trróc khi Phurong So Duong kip gio tay", "points": [[178, 95], [919, 95], [919, 128], [178, 128]], "difficult": false}, {"transcription": "lèn dánh minh.", "points": [[150, 133], [304, 133], [304, 159], [150, 159]], "difficult": false}, {"transcription": "Phurong So Durong khě day cái dàu dau buǒt, cám giác sóm muon gì minh", "points": [[180, 167], [917, 163], [917, 191], [180, 195]], "difficult": false}, {"transcription": "cūng chět yěu màt thòi. Khòng phài bi nhiem vu hình sy nǎng ně dè chét, mà", "points": [[150, 202], [917, 195], [917, 223], [150, 230]], "difficult": false}, {"transcription": "là bi cái tèn khon Trác Than này làm cho túrc chet.", "points": [[151, 237], [632, 231], [632, 255], [151, 261]], "difficult": false}, {"transcription": "\"Thàt day, anh khòng dùa dàu. Co Chu ò nhà doi dièn dā nói vói anh mǎy", "points": [[182, 270], [917, 264], [917, 291], [182, 297]], "difficult": false}, {"transcription": "lan rǒi. Chú dàu the bát chuóc anh dòc thàn cà dòi dugc.\" Trác Than vay nuróc", "points": [[151, 303], [917, 297], [917, 324], [151, 330]], "difficult": false}, {"transcription": "dinh trèn bàn tay bán cà vào mǎt Phuong So Duong.", "points": [[152, 337], [664, 336], [664, 363], [152, 364]], "difficult": false}, {"transcription": "\"Nhà chúng ta thě này, ding hai nguòi ta thì hon.\" Giot nuróc dính trén mi", "points": [[184, 372], [917, 366], [917, 395], [184, 401]], "difficult": false}, {"transcription": "mát Phuong So Duong map mé nhu muǒn roi xuōng, bau khòng khí bǒng trò", "points": [[152, 405], [917, 399], [917, 428], [152, 435]], "difficult": false}, {"transcription": "nèn the lurong la thuòng.", "points": [[153, 440], [396, 440], [396, 467], [153, 467]], "difficult": false}, {"transcription": "\"Cái gì mà hai nguòi ta hà? Hot boy cùa Cuc Canh sát thành phǒ, doi phó", "points": [[184, 473], [918, 466], [918, 497], [184, 504]], "difficult": false}, {"transcription": "tré trung cùa dòi hình sur, ai lǎy duoc chú thì mùrng còn chǎng kip ay chur. Va lai", "points": [[151, 507], [919, 500], [919, 530], [151, 537]], "difficult": false}, {"transcription": "cuói vě cūng có bát cò ǎy chǎm trè con dàu. Mòng Mòng cúr dě anh lo, sē khòng", "points": [[153, 541], [918, 535], [918, 562], [153, 568]], "difficult": false}, {"transcription": "làm lō chuyèn...\" Trác Than còn chua nói xong, nguòi anh em chǎng hě nghe", "points": [[153, 574], [917, 569], [917, 596], [153, 601]], "difficult": false}, {"transcription": "lot tai cúa anh da ding dày quay vě phòng, dóng cira dánh\"ram\" mot tiěng.", "points": [[153, 608], [903, 603], [903, 630], [153, 635]], "difficult": false}, {"transcription": "Trác Than xoa chóp mui ngǒi xuǒng bèn bàn, uǒng nǒt chǒ bia còn lai.", "points": [[182, 644], [863, 638], [863, 665], [182, 671]], "difficult": false}, {"transcription": "***", "points": [[512, 676], [544, 676], [544, 696], [512, 696]], "difficult": false}, {"transcription": "Khách hàng Ly Dinh sē xuat phát tói còng ty vào lúc tám giò sáng, chín già", "points": [[180, 717], [917, 710], [917, 737], [180, 743]], "difficult": false}, {"transcription": "truòng mǎu giáo vào hoc, thòi gian vùra dú. Sáng sóm ngày hòm sau, Trác Than", "points": [[150, 751], [918, 742], [918, 770], [150, 779]], "difficult": false}, {"transcription": "di chiěc xe dap dièn có thě gǎp gon tói Thái Trang Tan Thành dě dón nguròi.", "points": [[150, 784], [916, 777], [916, 804], [150, 811]], "difficult": false}, {"transcription": "Anh vira di vào sàn, dùng xe lai thì Ly Dinh cūng buóc ra khòi hành lang.", "points": [[149, 816], [873, 812], [873, 842], [149, 846]], "difficult": false}, {"transcription": "\"Anh di xe děn à, vày xe cùa anh phài xùr ly thěnào?\"Ly Dinh cǎm trong tay", "points": [[177, 850], [917, 849], [917, 880], [177, 881]], "difficult": false}, {"transcription": "chiěc túi xách và mot tò giǎy rǎt giong vói tò quáng cáo dǎt hàng ship.", "points": [[149, 888], [830, 885], [830, 912], [149, 915]], "difficult": false}, {"transcription": "Trác Thǎn chua kip tra lòi, mòt cái dǎu nho nhó da ló ra tùr ghe sau xe dap", "points": [[176, 923], [918, 919], [918, 949], [176, 953]], "difficult": false}, {"transcription": "dien. Càu bé tráng tréo dě dau dinh dang mò to dòi mát vò tòi nhìn vě phía co.", "points": [[149, 961], [918, 954], [918, 980], [149, 988]], "difficult": false}, {"transcription": "\"Sáng khòng ai dua nó di hoc nèn tòi dǎn nó theo, cò khòng ngai chúr.\" Trác", "points": [[177, 996], [921, 990], [921, 1018], [177, 1023]], "difficult": false}, {"transcription": "Than bě càu bé tùr yèn xe xuǒng, nhoay nhoáy gap chiec xe lai,bò vào trong cǒp", "points": [[148, 1028], [920, 1025], [920, 1056], [148, 1059]], "difficult": false}, {"transcription": "sau,\"Co dang cam gì the?\"", "points": [[149, 1066], [412, 1063], [412, 1090], [149, 1093]], "difficult": false}, {"transcription": "\"Khong sao,khong sao.\"Ly Dinh dua thur trong tay cho Trác Thǎn xem,\"Là", "points": [[177, 1099], [920, 1093], [920, 1126], [177, 1132]], "difficult": false}, {"transcription": "quàng cáo dán trèn tay nám cira, phài lǎy xuǒng ngay kèo trōm lai tuòng nhà", "points": [[148, 1135], [919, 1130], [919, 1161], [148, 1166]], "difficult": false}, {"transcription": "khòng có nguòi.\"", "points": [[149, 1171], [317, 1169], [317, 1196], [149, 1198]], "difficult": false}, {"transcription": "Thoat nhìn chi giǒng nhur mot tò quàng cáo tiěp thi giao do ǎn có màu sác lòe", "points": [[176, 1204], [918, 1201], [918, 1232], [176, 1235]], "difficult": false}, {"transcription": "loet. Xuat phát tùr thói quen nghě nghièp, Trác Than vǎn di tói ngó qua mòt cái,", "points": [[149, 1240], [917, 1237], [917, 1264], [149, 1268]], "difficult": false}, {"transcription": "ò mǎt truóc viět may món ǎn gia dinh nhur \"thit lon thái sqi xào\",\"khoai tày thái", "points": [[146, 1271], [921, 1267], [921, 1301], [146, 1304]], "difficult": false}, {"transcription": "sqi chua cay\".. Mǎt sau khòng viet gì, chi thiet ke mot cái logo xǎu xi.", "points": [[148, 1306], [816, 1305], [816, 1336], [148, 1337]], "difficult": false}, {"transcription": "18", "points": [[509, 1372], [540, 1372], [540, 1399], [509, 1399]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page17.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[389, 54], [564, 54], [564, 78], [389, 78]], "difficult": false}, {"transcription": "\"Thói quen tot day.\" Khen ngoi tính cành giác cùa khách hàng xong,Trác", "points": [[129, 94], [856, 100], [856, 128], [129, 121]], "difficult": false}, {"transcription": "Than lai kiēm tra xe mòt luot. Sau khi xác nhàn khòng có chat no cǔng khòng", "points": [[98, 128], [856, 133], [856, 159], [98, 155]], "difficult": false}, {"transcription": "có nguòi àn nǎp,anh mói ra hieu cho hai nguòi ngǒi vào bǎng ghě sau dě minh", "points": [[96, 161], [856, 162], [856, 192], [96, 191]], "difficult": false}, {"transcription": "lái xe.", "points": [[94, 194], [160, 194], [160, 224], [94, 224]], "difficult": false}, {"transcription": "\"Daylà con anh a?\" Ly Dinh ngǒi chung vói càu bé, khòng nhin dugc hòi", "points": [[126, 229], [856, 231], [856, 262], [126, 260]], "difficult": false}, {"transcription": "mot cau.", "points": [[96, 265], [185, 265], [185, 294], [96, 294]], "difficult": false}, {"transcription": "\"Cháu tòi day.\" Trác Than thát day an toàn, lái xe ra duròng lón.", "points": [[126, 301], [747, 303], [747, 331], [126, 329]], "difficult": false}, {"transcription": "\"òò.\" Chàng hieu sao Ly Dinh lai khē thò phào mòt hoi, có lē vi it khi gǎp", "points": [[127, 335], [856, 341], [856, 371], [127, 365]], "difficult": false}, {"transcription": "anh chàng nào dep trai the này, nèn lō nguròi ta da làm bǒ rǒi thì thàt dáng tiěc.", "points": [[96, 371], [855, 373], [855, 403], [96, 401]], "difficult": false}, {"transcription": "Co bat chgt hung phan hòi them mot càu,\"The me càu bé dau?\"", "points": [[98, 405], [720, 406], [720, 433], [98, 432]], "difficult": false}, {"transcription": "\"Mat roi.\"", "points": [[126, 440], [231, 437], [232, 469], [127, 472]], "difficult": false}, {"transcription": "\".\"Biět minh lō lòi, Ly Dinh ngai ngùng im lǎng áy náy nhin dúa bé nhò", "points": [[124, 474], [855, 478], [855, 509], [124, 505]], "difficult": false}, {"transcription": "xíu bén canh minh.", "points": [[98, 513], [286, 513], [286, 537], [98, 537]], "difficult": false}, {"transcription": "\"Chào chi a.\" Cau bé hoi gay khien dòi mát lai càng to hon, long lanh lap", "points": [[127, 545], [856, 549], [856, 579], [127, 575]], "difficult": false}, {"transcription": "lánh, hoàn toàn khòng có chút u ám nào,\"Em tèn là Trác Mong Mòng.\"", "points": [[95, 581], [792, 584], [792, 611], [95, 608]], "difficult": false}, {"transcription": "Chiu! Trái tim thieu nūr chgt nhur bi mūi tèn nhò màu hǒng bán trúng. Co", "points": [[127, 615], [855, 619], [855, 647], [127, 643]], "difficult": false}, {"transcription": "voi vàng tháo chiěc móc treo hinh con thò cup tai trèn túi xách ra, nhét vào tay", "points": [[97, 651], [855, 654], [855, 682], [97, 679]], "difficult": false}, {"transcription": "Mong Mòng:\"Ngoan quá,cho em cái này choi.\"", "points": [[97, 686], [569, 684], [569, 711], [97, 713]], "difficult": false}, {"transcription": "\"Cam on chi a.\" Mòng Mòng ngang dau lén cuòi, roi lai im lǎng nǎn chú", "points": [[128, 719], [854, 719], [854, 749], [128, 749]], "difficult": false}, {"transcription": "thó cup tai.", "points": [[96, 754], [211, 754], [211, 782], [96, 782]], "difficult": false}, {"transcription": "Xe chay tói quáng truòng truóc tòa nhà còng ty,ò dó có mot bai dǒ xe tam", "points": [[125, 788], [856, 789], [856, 819], [125, 818]], "difficult": false}, {"transcription": "thòi ngoài tròi, có thě dǒ xe trong vòng nùra tiéng. Trác Thǎn xuǒng xe, bě", "points": [[96, 823], [858, 821], [858, 851], [96, 853]], "difficult": false}, {"transcription": "Mòng Mòng lén di theo Ly Dinh, dura co vào tòa nhà.", "points": [[96, 859], [615, 857], [615, 884], [96, 886]], "difficult": false}, {"transcription": "\"May buóc thòi mà, khòng cǎn tiěn tòi nūra dàu. Anh lái xe di di，tǒi děn dón", "points": [[127, 894], [855, 893], [855, 920], [127, 921]], "difficult": false}, {"transcription": "tòi la duoc.\"Ly Dinh vay tay vói Mòng Mong.", "points": [[95, 927], [551, 930], [551, 958], [95, 955]], "difficult": false}, {"transcription": "\"Trách nhiem cùa toi là phài dua cò tói thang máy.\" Trác Than kièn trì di", "points": [[127, 964], [856, 964], [856, 990], [127, 990]], "difficult": false}, {"transcription": "theo cò, thu hút ánh nhìn cùa rǎt nhiěu nguòi.", "points": [[96, 996], [548, 998], [548, 1025], [96, 1023]], "difficult": false}, {"transcription": "Dang là giò di làm, cán bò còng nhàn vièn áo quǎn phǎng phiu thi nhau", "points": [[126, 1035], [857, 1035], [857, 1062], [126, 1062]], "difficult": false}, {"transcription": "ùa vào tòa nhà, nguòi dàn òng ǎn mǎc thoài mái bě mòt càu bé bǒng trò nèn", "points": [[95, 1069], [856, 1068], [856, 1095], [95, 1096]], "difficult": false}, {"transcription": "vò cùng nǒi bàt trong sǒ dó, hét nhur mòt con cua lǎn trong bay cá mòi vày. Ba", "points": [[96, 1101], [855, 1100], [855, 1130], [96, 1131]], "difficult": false}, {"transcription": "nguòi di cùng nhau rǎt dě khiěn nguòi ta hieu lam, Ly Dinh lúng túng dùng túi", "points": [[94, 1136], [856, 1133], [856, 1164], [94, 1167]], "difficult": false}, {"transcription": "xách che mǎt lai, di vòi vào trong tòa nhà.", "points": [[97, 1172], [505, 1172], [505, 1196], [97, 1196]], "difficult": false}, {"transcription": "\"Cao Vū Sènh, anh dúng là do phu bac. Chúng ta yèu nhau ba nǎm tròi mà", "points": [[125, 1204], [857, 1202], [857, 1232], [125, 1234]], "difficult": false}, {"transcription": "anh lai dǒi xùr vói tòi nhur thě à! Toi ǎn dáng nàm surong gay dung su nghiep tù", "points": [[94, 1239], [857, 1236], [857, 1265], [94, 1269]], "difficult": false}, {"transcription": "hai bàn tay tráng vói anh, bày giò có tièn rǒi anh lai vút bó tòi! Cao Vū Senh, anh", "points": [[95, 1274], [856, 1268], [856, 1296], [95, 1301]], "difficult": false}, {"transcription": "ra dày cho tòi! Do phu bac, tèn khǒn nan, Cao Vū Senh!Anh ra day!\" Mot nguòi", "points": [[95, 1307], [855, 1303], [855, 1330], [95, 1334]], "difficult": false}, {"transcription": "19", "points": [[461, 1361], [493, 1361], [493, 1388], [461, 1388]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page18.jpg	[{"transcription": "Ve a tam thǎi", "points": [[473, 62], [609, 62], [609, 86], [473, 86]], "difficult": false}, {"transcription": "phu nù dúng bèn ngoài cánh cia xoay cua tòa nhà, mǎc quàn áo cǔ re tien, buòc", "points": [[158, 106], [919, 102], [919, 131], [158, 136]], "difficult": false}, {"transcription": "tóe duòi ngua, dang chong nanh cao giong chùi bói, cue ky có van có dieu.", "points": [[158, 141], [866, 136], [866, 163], [158, 167]], "difficult": false}, {"transcription": "\"Sao co ta lai tói nūa roi.\" Cong nhàn vièn di ngang qua nhó giong binh luán.", "points": [[190, 174], [908, 171], [908, 198], [190, 201]], "difficult": false}, {"transcription": "\"Ai, thúr Sáu tuǎn nào cūng tói, chuán giò dúng chǒ, sét dánh cūng khòng sòn.\"", "points": [[190, 209], [919, 206], [919, 235], [190, 238]], "difficult": false}, {"transcription": "\"Cao Vū Senh la ai vày?\"", "points": [[191, 247], [437, 245], [437, 272], [191, 274]], "difficult": false}, {"transcription": "\"Cau khong biet anh ta á? Nguòi sieu dep trai sáng láp ra Tieu Diem mà", "points": [[191, 282], [921, 277], [921, 307], [191, 312]], "difficult": false}, {"transcription": "hòm truóc chúng ta gǎp trong thang máy áy, my nam sǒ mot cúa tòa nhà Tài", "points": [[158, 317], [921, 310], [921, 340], [158, 347]], "difficult": false}, {"transcription": "Phú chúng ta.\"", "points": [[158, 353], [323, 347], [324, 378], [159, 384]], "difficult": false}, {"transcription": "\"Là anh ay à!Oa, vày chàng trách, tòi mà bi anh áy vút bó thi tòi cūng dién mát.\"", "points": [[192, 387], [910, 380], [910, 406], [192, 414]], "difficult": false}, {"transcription": "Súc lc cùa nguòi phu nū kia nhur the dùng mai khòng het váy. Co ta chǒng", "points": [[191, 424], [920, 417], [920, 444], [191, 450]], "difficult": false}, {"transcription": "nanh vùra chùi mǎng vùra nháy dōng lèn, chùi mòt hǒi rǒi lai ké le chi li vói", "points": [[160, 457], [922, 447], [922, 478], [160, 488]], "difficult": false}, {"transcription": "nguòi ta vě quá khú cua minh và Cao Vū Senh. Trác Than thay thú vi bèn dùng", "points": [[160, 488], [923, 481], [923, 515], [160, 522]], "difficult": false}, {"transcription": "buóc thuòng lam mòt lúc.", "points": [[161, 526], [411, 520], [411, 547], [161, 553]], "difficult": false}, {"transcription": "\"Làm gì day, mau di di!\" Bào vè cúa tòa nhà vòi ra duoi nguòi.", "points": [[191, 558], [787, 556], [787, 584], [191, 586]], "difficult": false}, {"transcription": "\"Tòi là ban gái cū cùa Cao Vū Senh, các nguròi mau dǎn tòi di gǎp anh ta!\"", "points": [[193, 595], [910, 589], [910, 617], [193, 623]], "difficult": false}, {"transcription": "\"Thoi di,Tong Giám dǒc Cao mà thich cò duocá?Bi dièn thì di chura nhanh", "points": [[191, 630], [919, 626], [919, 653], [191, 657]], "difficult": false}, {"transcription": "lēn,khòng là chúng tòi báo cánh sát day!\"", "points": [[158, 665], [559, 660], [559, 689], [158, 695]], "difficult": false}, {"transcription": "Thú vi thàt, něu Cao Vū Senh mà di ngang qua day dúng lúc thi lai càng hap", "points": [[189, 700], [918, 697], [918, 725], [189, 727]], "difficult": false}, {"transcription": "dǎn hon. Chi tiěc là Tōng Giám dǒc nhà nguòi ta lái xe di làm, di thang máy", "points": [[159, 734], [919, 731], [919, 758], [159, 761]], "difficult": false}, {"transcription": "trong bai dǒ xe nèn chác chán sē khòng gǎp duroc\"nguròi yèu cū\"roi. TrácThan", "points": [[158, 768], [920, 763], [920, 791], [158, 796]], "difficult": false}, {"transcription": "lác dau, bě càu bé vě xe, quay xe di děn truròng mǎm non, bò lòi tay nāo\"Cao", "points": [[159, 801], [919, 797], [919, 824], [159, 828]], "difficult": false}, {"transcription": "Vū Sènh phu bac'\"lai phía sau.", "points": [[161, 837], [455, 835], [455, 860], [161, 862]], "difficult": false}, {"transcription": "\"Cau oi,cái cò dó bi ban trai dá a?\" Mòng Mòng trèo lèn ghe sau, vira nán", "points": [[186, 870], [920, 865], [920, 895], [186, 900]], "difficult": false}, {"transcription": "bóp chú thò tai cup vùra hòi.", "points": [[158, 908], [428, 903], [428, 930], [158, 935]], "difficult": false}, {"transcription": "\"Cau khòng biét.\" Trác Than lái xe ra khòi bai dǒ, dúng lúc nhin thay chiec", "points": [[187, 941], [920, 937], [920, 967], [187, 971]], "difficult": false}, {"transcription": "sieu xe có cánh thien súr dang divào ham dexe,\"Theo nhu càu biet thì chú Tieu", "points": [[157, 977], [919, 971], [919, 998], [157, 1003]], "difficult": false}, {"transcription": "Cao kia rǎt giàu có, khòng có chuyen truóc khi gay dung sur nghièp phài ǎn", "points": [[157, 1011], [919, 1005], [919, 1033], [157, 1039]], "difficult": false}, {"transcription": "dáng nàm suong. Hon nūra..\"", "points": [[159, 1044], [441, 1044], [441, 1071], [159, 1071]], "difficult": false}, {"transcription": "\"An dáng nàm suong là sao a?\" Luong tù vung cúa mot càu nhóc bǒn tuoi", "points": [[184, 1076], [921, 1074], [921, 1107], [184, 1109]], "difficult": false}, {"transcription": "khóng dù de hieu duoc nhūrng thành ngūr cao cǎp này", "points": [[157, 1116], [675, 1116], [675, 1140], [157, 1140]], "difficult": false}, {"transcription": "\"Nghīa là rát nghèo, khong có tien ǎn com, chi có thē ǎn vò trǎu vói rau dai", "points": [[186, 1151], [918, 1148], [918, 1176], [186, 1179]], "difficult": false}, {"transcription": "qua ngay..\"Nói děn day,Trác Than chot khung lai. Nhin guong mǎt ngay ngo", "points": [[158, 1187], [918, 1183], [918, 1211], [158, 1215]], "difficult": false}, {"transcription": "cúa cáu bé qua guong chiěu hàu, anh hoi mím mòi.", "points": [[157, 1220], [647, 1217], [647, 1244], [157, 1247]], "difficult": false}, {"transcription": "Trong ky úc cúa anh, cūng dā tùng có mot giong nói non nót měm mai, tra", "points": [[184, 1255], [919, 1250], [919, 1280], [184, 1284]], "difficult": false}, {"transcription": "dòng suǒi uǒn luon quanh nhūng day non xanh nuóc biěc tràp trùng.", "points": [[158, 1287], [828, 1288], [828, 1318], [158, 1317]], "difficult": false}, {"transcription": "20", "points": [[512, 1358], [547, 1358], [547, 1387], [512, 1387]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page19.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[384, 59], [562, 59], [562, 80], [384, 80]], "difficult": false}, {"transcription": "\"Dày là rau dai...\"", "points": [[122, 100], [290, 100], [290, 128], [122, 128]], "difficult": false}, {"transcription": "\"O, dāy cūng là rau dai...\"", "points": [[121, 134], [364, 137], [364, 164], [121, 162]], "difficult": false}, {"transcription": "\"Anh khōng biet, nhung dèu có the goi chúng là rau dai.\"", "points": [[121, 172], [646, 171], [646, 202], [121, 203]], "difficult": false}, {"transcription": "***", "points": [[460, 211], [495, 211], [495, 231], [460, 231]], "difficult": false}, {"transcription": "Ngày mai là cuoi tuǎn nen dich vu dua dón tam dirng. Buoi toi lúc dugc dón", "points": [[118, 247], [861, 246], [861, 277], [118, 278]], "difficult": false}, {"transcription": "vě tùr chǒ làm, Ly Dinh mói chgt nhàn ra minh thuè phuc vy mot tuàn nhung", "points": [[89, 280], [861, 284], [861, 314], [89, 310]], "difficult": false}, {"transcription": "the chat chi dùng duoc nǎm ngày, àm tham dǎm nguc hǒi hàn vì quyět dinh", "points": [[90, 318], [858, 318], [858, 345], [90, 345]], "difficult": false}, {"transcription": "ban dau cùa minh.", "points": [[89, 352], [277, 350], [277, 375], [89, 377]], "difficult": false}, {"transcription": "\"Gi mà mōt tuǎn bay nghin, giàm giá cho tòi còn nǎm nghin chú, cuǒi cùng", "points": [[120, 386], [859, 389], [859, 419], [120, 415]], "difficult": false}, {"transcription": "chàng phài vān là mōi ngày mōt nghin à?\" Ly Dinh vùra lái xe vùra túc giàn nói.", "points": [[91, 421], [857, 423], [857, 449], [91, 448]], "difficult": false}, {"transcription": "\"Dàu có,něu cuǒi tuàn mà cò tǎng ca, tòi vǎn děn dón cò nhur thuòng.\" Trác", "points": [[120, 457], [859, 458], [859, 486], [120, 485]], "difficult": false}, {"transcription": "Than ngǒi phia sau dùng ngón tay vàt tay vói cháu trai,\"Giàm giá chính là", "points": [[91, 494], [857, 494], [857, 521], [91, 521]], "difficult": false}, {"transcription": "tǎng khòng cho cò hai ngày sǎn sàng dgi lènh còn gì, hoi bi lòi day.'", "points": [[92, 530], [757, 530], [757, 554], [92, 554]], "difficult": false}, {"transcription": "n", "points": [[146, 567], [161, 567], [161, 579], [146, 579]], "difficult": false}, {"transcription": "Hinh nhu cǔng rǎt có ly, nhung hinh nhu lai có gì dó sai sai. Ly Dinh", "points": [[162, 563], [856, 564], [856, 591], [162, 590]], "difficult": false}, {"transcription": "..", "points": [[125, 577], [151, 574], [153, 588], [127, 591]], "difficult": false}, {"transcription": "khong nói lai durgc anh, dành phài doi dě tài,\"Dúng roi, hòm nay Tong Giám", "points": [[88, 596], [856, 597], [856, 627], [88, 626]], "difficult": false}, {"transcription": "doc Cao hòi tòi tèn cúa anh day,hai nguòi quen nhau nhu thě nào vay?\"", "points": [[90, 630], [799, 632], [799, 659], [90, 657]], "difficult": false}, {"transcription": "\"Hà? Cau ay nói gì co?\" Nhác tói Tong Giám doc Cao,hien giò trong dau", "points": [[120, 668], [855, 670], [855, 697], [120, 695]], "difficult": false}, {"transcription": "Trác Than chi toàn là\"Cao Vū Senh phu bac\",bǒng chǒc khòng nhó duoc tùr", "points": [[89, 701], [856, 703], [856, 729], [89, 728]], "difficult": false}, {"transcription": "nào khác.", "points": [[87, 736], [187, 736], [187, 764], [87, 764]], "difficult": false}, {"transcription": "\"Khòng nói gì cà, chi làm bam mòt càu'Lau son cao trǎm thuóc, vói tay hái", "points": [[121, 773], [855, 773], [855, 800], [121, 800]], "difficult": false}, {"transcription": "sao tròis.A dúng rǒi, anh ày còn cuòi nira!\" Dǒi vói Ly Dinh mà nói thì duòng", "points": [[86, 804], [856, 806], [856, 837], [86, 835]], "difficult": false}, {"transcription": "nhu diem cuǒi cùng ay mói là dieu dáng ngac nhièn nhat. Tong Giám dǒc Cao", "points": [[88, 840], [854, 841], [854, 868], [88, 867]], "difficult": false}, {"transcription": "ngày nào di làm cūng lanh mǎt dù tám tiěng, ay vày mà lai mim cuòi?!", "points": [[89, 876], [784, 874], [784, 902], [89, 904]], "difficult": false}, {"transcription": "\"Vǎn churong tǒt that dǎy.\" Trác Than thuàn mièng khen mot càu, sau dó", "points": [[119, 912], [855, 912], [855, 939], [119, 939]], "difficult": false}, {"transcription": "dùng ngón tay vat tay Mòng Mòng xuong.", "points": [[88, 946], [509, 948], [509, 976], [88, 973]], "difficult": false}, {"transcription": "\"Tho cia hoc sinh tieu hoc mà, anh khen chǎng có tí thành y nào cà.\"", "points": [[118, 981], [794, 981], [794, 1010], [118, 1010]], "difficult": false}, {"transcription": "\"Xin lōi, toi chua tùrng hoc tieu hoc.\"", "points": [[118, 1018], [478, 1019], [478, 1047], [118, 1046]], "difficult": false}, {"transcription": "\".\"Děn dày thì chàng the nào nói chuyen durgc nūa, nguòi khách tièu tien", "points": [[109, 1049], [858, 1052], [858, 1092], [109, 1089]], "difficult": false}, {"transcription": "uōng phí lyra chon ngam mieng.", "points": [[87, 1092], [405, 1094], [405, 1121], [87, 1119]], "difficult": false}, {"transcription": "***", "points": [[455, 1127], [489, 1127], [489, 1146], [455, 1146]], "difficult": false}, {"transcription": "Sáng thú Bày, anh vè sī\"sǎn sàng doi lènh' ngù quèn cà tròi dat ò nhà,", "points": [[115, 1166], [852, 1164], [852, 1191], [115, 1193]], "difficult": false}, {"transcription": "quǎng luòn chuyèn giàm giá dich vu cúa khách hàng lèn chín tǎng mày. Vùa", "points": [[89, 1200], [851, 1200], [851, 1227], [89, 1227]], "difficult": false}, {"transcription": "mo tói doan tròi do con mua vàng, còn chura dgi durgc hanh phúc rót xuǒng thì", "points": [[86, 1233], [851, 1232], [851, 1259], [86, 1260]], "difficult": false}, {"transcription": "dien thoai ò dau giuòng dā réo am lèn làm anh thúrc giǎc.", "points": [[87, 1265], [651, 1267], [651, 1293], [87, 1292]], "difficult": false}, {"transcription": "Trich trong bài tho“Da túc son tr\"cia Ly Bach.", "points": [[87, 1315], [430, 1317], [430, 1344], [87, 1342]], "difficult": false}, {"transcription": "21", "points": [[453, 1369], [485, 1369], [485, 1393], [453, 1393]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page20.jpg	[{"transcription": "ve sī tam thoi", "points": [[463, 58], [597, 56], [597, 81], [463, 83]], "difficult": false}, {"transcription": "\"A lò, ai day?\" Anh vǎn nhám tit mát, khó chiu nhàn cuòc goi.", "points": [[200, 98], [759, 101], [759, 132], [200, 128]], "difficult": false}, {"transcription": "\"Là tòi, Cao Vū Senh dày.\"Giong nói binh tinh lanh lùng mang theo ngù", "points": [[199, 133], [901, 133], [901, 169], [199, 169]], "difficult": false}, {"transcription": "dièu tuyèt vòi， khien nguòi ta thoài mái tói tùng lǒ chàn lòng, có hièu quá kinh", "points": [[173, 170], [900, 167], [900, 201], [173, 204]], "difficult": false}, {"transcription": "nguòi trong vièc làm giàm càm giác cáu bàn khi bi dánh thúc.", "points": [[173, 207], [730, 205], [730, 236], [173, 238]], "difficult": false}, {"transcription": "Ke phu bac u? Trác Than suyt buot mièng goi ra cái tèn này trong con mo", "points": [[200, 243], [902, 242], [902, 273], [200, 274]], "difficult": false}, {"transcription": "màng, may mà lòi da tói bén mieng lai kip nuǒt trò vě.", "points": [[175, 279], [668, 276], [668, 307], [175, 310]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page21.jpg	[{"transcription": "Cnuong 4", "points": [[417, 97], [545, 97], [545, 128], [417, 128]], "difficult": false}, {"transcription": "Sao tren troi(4)", "points": [[319, 147], [641, 145], [641, 184], [319, 185]], "difficult": false}, {"transcription": "\"Sao càu lai có sǒ dien thoai cùa tòi?\" So này den Ly Dinh còn chǎng biet.", "points": [[133, 266], [841, 264], [841, 295], [133, 297]], "difficult": false}, {"transcription": "\"Anh tr nói mà.\"ò dau dày bèn kia, duòng nhu Cao Vū Senh vira bàt cuòi.", "points": [[133, 304], [856, 302], [856, 333], [133, 335]], "difficult": false}, {"transcription": "Bǎy giò Trác Than mói nhó tói chuyèn di nham xe hòm ày. Anh bat dày vò", "points": [[133, 342], [856, 341], [856, 369], [133, 370]], "difficult": false}, {"transcription": "dǎu, trong lòng tham nghī trí nhó cúa nguòi này tǒt thàt, minh chi buot mièng", "points": [[104, 377], [856, 376], [856, 406], [104, 407]], "difficult": false}, {"transcription": "doc mòt lan mà hán cūng nhó dugc.", "points": [[105, 411], [456, 416], [456, 443], [105, 438]], "difficult": false}, {"transcription": "Töng Giám dǒc Cao bào ràng có còng vièc muǒn bàn vói anh nèn mòi anh", "points": [[133, 449], [857, 449], [857, 479], [133, 479]], "difficult": false}, {"transcription": "cùng ǎn mot būa com. Trác Than khòng cho ràng mot ve sī nghiep dur nghèo", "points": [[106, 486], [855, 486], [855, 513], [106, 513]], "difficult": false}, {"transcription": "rót mǒng toi nhu minh có bàn līnh gì dě bàn chuyèn làm ǎn vói mòt nguòi", "points": [[104, 519], [855, 520], [855, 547], [104, 546]], "difficult": false}, {"transcription": "giàu có dep trai nhu hán, cùng lám là muōn thuè anh làm vé sī thòi. Dù sao", "points": [[105, 555], [856, 554], [856, 581], [105, 582]], "difficult": false}, {"transcription": "don hàng vói Ly Dinh cūng sáp kět thúc rǒi, nhūng ngày tháng uǒng nuóc lā", "points": [[106, 590], [856, 590], [856, 617], [106, 617]], "difficult": false}, {"transcription": "hít khí tròi mà sǒng lai sáp bát dau, něu trróc dó nhàn dugc kèo mói thì chǎng", "points": [[103, 622], [856, 623], [856, 653], [103, 652]], "difficult": false}, {"transcription": "còn gì tot hon duqc nūa.", "points": [[107, 661], [344, 661], [344, 685], [107, 685]], "difficult": false}, {"transcription": "Anh dǒng y luòn khòng chút do dy, Cao Vū Sènh hói anh muon ǎn gì， anh", "points": [[136, 696], [854, 696], [854, 722], [136, 722]], "difficult": false}, {"transcription": "Thǎn chua ǎn sáng xoa xoa cái bung rǒng cùa minh, quyět doán chon món làu.", "points": [[104, 728], [856, 729], [856, 759], [104, 758]], "difficult": false}, {"transcription": "\"Mòng Mòng, ra ngoài vói càu.\"An mǎc chinh tě,khoác ba lo den lèn vai rǒi", "points": [[136, 768], [856, 768], [856, 795], [136, 795]], "difficult": false}, {"transcription": "Trác Than day mò cánh cira nhà cò Chu bèn phía doi dièn, goi dúra cháu ngoai", "points": [[105, 802], [855, 803], [855, 830], [105, 829]], "difficult": false}, {"transcription": "cúa minh dang ngǒi xem ti vi vói cháu trai cò Chu. Phurong So Durong là cánh", "points": [[107, 839], [853, 839], [853, 863], [107, 863]], "difficult": false}, {"transcription": "sát hình su, binh thuòng khòng có ngày nghi lě gì cá, cuǒi tuǎn cūng phài tǎng", "points": [[103, 869], [855, 873], [855, 903], [103, 899]], "difficult": false}, {"transcription": "ca dē diěu tra án. Mà Trác Thǎn cūng khòng thě de thàng bé ò nhà mòt minh", "points": [[104, 905], [854, 909], [854, 936], [104, 932]], "difficult": false}, {"transcription": "duroc, nèn dǎn nó di ǎn ké com cúa Tǒng Giám dǒc Cao luòn", "points": [[107, 944], [690, 944], [690, 968], [107, 968]], "difficult": false}, {"transcription": "\"Thǎn Thǎn, cháu di dàu vày?\" Trong nhà cò Chu còn có mot nguòi phy", "points": [[132, 975], [855, 981], [855, 1010], [132, 1005]], "difficult": false}, {"transcription": "nù trung nièn khác, hai nguòi vùra ngǒi dan mū len vùra nói chuyèn, nhiét tinh", "points": [[102, 1012], [855, 1013], [855, 1043], [102, 1042]], "difficult": false}, {"transcription": "chào hòi Trác Than dang buóc vào.", "points": [[103, 1048], [447, 1049], [447, 1076], [103, 1075]], "difficult": false}, {"transcription": "\"Cháu ra ngoài gǎp ban a.\" Trác Than curòi nói vói cò Chu rǒi quay sang", "points": [[129, 1085], [856, 1087], [856, 1118], [129, 1116]], "difficult": false}, {"transcription": "ngoác tay goi cháu minh.", "points": [[104, 1122], [352, 1122], [352, 1152], [104, 1152]], "difficult": false}, {"transcription": "\"Cau. cháu còn chua xem xong phim hoat hinh mà.\" Mong Mòng nhin", "points": [[129, 1157], [855, 1158], [855, 1189], [129, 1188]], "difficult": false}, {"transcription": "chàm chàm vào màn hình ti vi vói vè day luyen tiěc. Nhà cò Chu láp smart ti vi,", "points": [[103, 1192], [855, 1193], [855, 1223], [103, 1222]], "difficult": false}, {"transcription": "có rǎt nhieu phim hoat hinh nuóc ngoài, tha hǒ xem hoài khòng hět. Mèo Tom", "points": [[103, 1230], [854, 1229], [854, 1256], [103, 1257]], "difficult": false}, {"transcription": "màu lam xám dang rurgt duoi chuòt Jerry, duoi tói chǒ cày phoi quan áo mói", "points": [[104, 1263], [855, 1263], [855, 1290], [104, 1290]], "difficult": false}, {"transcription": "phát hièn mình giām vào khoàng khòng mǎt nó nghet ra rǒi roi thàng xuǒng", "points": [[103, 1297], [855, 1296], [855, 1326], [103, 1327]], "difficult": false}, {"transcription": "23", "points": [[462, 1358], [498, 1358], [498, 1388], [462, 1388]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page22.jpg	[{"transcription": "ve sī ta.n tho", "points": [[471, 45], [606, 45], [606, 69], [471, 69]], "difficult": false}, {"transcription": "kēt hop vói tiēng nhac nèn hài huóc. Hai dúra trè ngǒi xem cuòi tít cá mát, nhóe", "points": [[159, 85], [908, 83], [908, 117], [159, 119]], "difficult": false}, {"transcription": "ho Trác kia dā quèn béng luòn òng càu nhà minh còn dang dúng ngoài cúra.", "points": [[161, 124], [883, 124], [883, 150], [161, 150]], "difficult": false}, {"transcription": "\"De Mòng Mong choi vói Lac Lae di,trua nay ǎn com o nhà có cūng durge.", "points": [[192, 158], [908, 159], [908, 189], [192, 188]], "difficult": false}, {"transcription": "Chàng mǎy khi nghi cuǒi tuǎn, cháu cūng dugc mot ngày thánh thoi.\" Có Chu", "points": [[161, 192], [908, 191], [908, 222], [161, 223]], "difficult": false}, {"transcription": "phat tay, tò y de minh chǎm sóc càu bé cho, còn Trác Thàn cúr lo viec cúa minh", "points": [[162, 230], [908, 227], [908, 254], [162, 257]], "difficult": false}, {"transcription": "di. Trong khu tàp the này deu là nguòi thàn cùa nhan vien Cuc Cánh sát, lam", "points": [[162, 265], [909, 262], [909, 289], [162, 292]], "difficult": false}, {"transcription": "hàng xóm muòi mày nǎm tròi nèn ai cūng thàn quen vói nhau cá. Thòi còn di", "points": [[162, 302], [910, 296], [910, 323], [162, 329]], "difficult": false}, {"transcription": "hoc,Trác Than cǔng tùrng ǎn com ò nhà cò Chu nhieu rǒi", "points": [[163, 336], [703, 332], [703, 359], [163, 363]], "difficult": false}, {"transcription": "Anh hoi luōng lr.", "points": [[194, 376], [366, 376], [366, 400], [194, 400]], "difficult": false}, {"transcription": "\"Khòng sao, cò biět tinh hinh súrc khòe cúa Mòng Mòng mà, cò khòng dǎn", "points": [[191, 408], [908, 401], [908, 434], [191, 441]], "difficult": false}, {"transcription": "bon trè ra ngoài dàu, chi choi trong nhà thòi. Có chuyen gì cò sē goi dien cho", "points": [[162, 444], [909, 438], [909, 468], [162, 474]], "difficult": false}, {"transcription": "cháu ngay.\" Co Chu vō nguc dàm bao, nguòi phu nūr bèn canh tò mò nhin Trác", "points": [[165, 480], [909, 474], [909, 501], [165, 507]], "difficult": false}, {"transcription": "Than chàm chàm.", "points": [[163, 514], [335, 511], [335, 538], [163, 541]], "difficult": false}, {"transcription": "\"Cau cú di di, khòng sao dàu a.\" Trác Mong Mòng vǎn dang dán mát vào", "points": [[193, 549], [909, 547], [909, 576], [193, 578]], "difficult": false}, {"transcription": "màn hinh ti vi, vǎy bàn tay nho nhò chǎng chút dě tàm.", "points": [[164, 585], [680, 582], [680, 610], [164, 613]], "difficult": false}, {"transcription": "\"Vay làm phiěn cò a.\" Trác Thǎn nhe rǎng vói thàng nhóc vò luong tàm kia,", "points": [[194, 620], [907, 620], [907, 650], [194, 650]], "difficult": false}, {"transcription": "càm on cò Chu rǒi khièng xe dién gap xuǒng duói tang.", "points": [[167, 659], [683, 659], [683, 683], [167, 683]], "difficult": false}, {"transcription": "\"Ke tiěp di, chuyen nhà bon ho là nhu thě nào vày?\" Nguòi phy nū trung", "points": [[192, 692], [909, 693], [909, 722], [192, 721]], "difficult": false}, {"transcription": "nièn da nín nhin mòt lúc làu, ngúra ruōt ngura gan lám rǒi. Ban nāy truróc khi", "points": [[161, 729], [909, 725], [909, 752], [161, 756]], "difficult": false}, {"transcription": "Trác Than tói, cò Chu dang buòn mòt sǒ chuyèn vě nhà dǒi dièn, chù yěu là", "points": [[161, 763], [908, 760], [908, 788], [161, 791]], "difficult": false}, {"transcription": "muǒn nhò bà ban già cúa minh giói thieu dǒi turong cho Phuong So Durong", "points": [[163, 800], [907, 800], [907, 824], [163, 824]], "difficult": false}, {"transcription": "chua ke xong thi Trác Than da di vào. Ngoi nghe duroc mot nira càu chuyen lai", "points": [[162, 833], [909, 831], [909, 858], [162, 860]], "difficult": false}, {"transcription": "gǎp ngay nhàn vàt chính, khòng dám de lò ra vièc\"tòi vùra nghe nói vě càu\",", "points": [[161, 870], [908, 863], [908, 893], [161, 900]], "difficult": false}, {"transcription": "suyt nūa làm cò thính già này chět vì nghen.", "points": [[162, 905], [579, 902], [579, 929], [162, 932]], "difficult": false}, {"transcription": "\"Ai,dúra bé là con cùa chi gái càu ǎy,cò chi vùra sinh con xong thì qua dòi,", "points": [[192, 941], [907, 941], [907, 968], [192, 968]], "difficult": false}, {"transcription": "bó lai thàng con trai.\" Co Chu nhò giong nói, sg Trác Mong Mong ò phòng bèn", "points": [[160, 977], [909, 972], [909, 1003], [160, 1007]], "difficult": false}, {"transcription": "canh nghe thay,\"Phuong So Duong là con nuòi, cǔng trac tuoi Trác Than, hinh", "points": [[161, 1012], [909, 1008], [909, 1036], [161, 1040]], "difficult": false}, {"transcription": "nhu là con trai cúa ban òng Trác Kien Quoc-bo Trác Thǎn. Trác Kiěn Quoc thì", "points": [[160, 1044], [910, 1042], [910, 1072], [160, 1074]], "difficult": false}, {"transcription": "khòi phài nói rǒi, tǒt oi là tǒt, nǎm kia vì cúu mot nguòi nhay sòng tur sát mà", "points": [[159, 1080], [911, 1079], [911, 1109], [159, 1110]], "difficult": false}, {"transcription": "mát luón cà mang….\"", "points": [[157, 1114], [364, 1110], [365, 1148], [158, 1152]], "difficult": false}, {"transcription": "\"Oi chao, òi chao.\" Bà ban già thōn thuc khòng thòi,\"Hai thàng thanh", "points": [[189, 1149], [912, 1150], [912, 1184], [189, 1183]], "difficult": false}, {"transcription": "nien làm sao mà chǎm tré con dugc chú.\"", "points": [[161, 1189], [551, 1189], [551, 1216], [161, 1216]], "difficult": false}, {"transcription": "\"Chǎng thě à, tòi nhìn thòi cūng thày sǒt hět cá ruòt. Dúra bé kia còn khòng", "points": [[190, 1224], [910, 1230], [910, 1257], [190, 1250]], "difficult": false}, {"transcription": "duqc khòe nǔra chú, lúc nào cūng phai tròng nom can thàn, thyc sur là quá vat", "points": [[161, 1258], [910, 1263], [910, 1292], [161, 1288]], "difficult": false}, {"transcription": "và cho hai anh em chúng nó.\"", "points": [[161, 1293], [437, 1296], [437, 1323], [161, 1320]], "difficult": false}, {"transcription": "24", "points": [[507, 1359], [544, 1359], [544, 1388], [507, 1388]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page23.jpg	[{"transcription": "Luc DaThienHac", "points": [[391, 47], [568, 47], [568, 71], [391, 71]], "difficult": false}, {"transcription": "Trác Than ngoc nghech dáng thurong trong càu chuyèn cúa hàng xóm dang", "points": [[130, 89], [861, 92], [861, 119], [130, 116]], "difficult": false}, {"transcription": "phóng xe dien nhó di tói buoi hen ǎn làu vói vi Tōng Giám dǒc dòc tài. Cao Vǔ", "points": [[99, 124], [862, 120], [862, 149], [99, 154]], "difficult": false}, {"transcription": "Sènh dǎt bàn ò mòt quán làu ít nguòi trong con ngō nhó tràn day hoi thò nghè", "points": [[100, 156], [860, 156], [860, 183], [100, 183]], "difficult": false}, {"transcription": "thuàt. Durong nhien là chiec sieu xe mang logo dòi cánh kia khòng vào dày", "points": [[100, 190], [860, 191], [860, 218], [100, 217]], "difficult": false}, {"transcription": "durgc, dành phai tùi thàn dàu ò ngoài bāi dǒ là thièn.", "points": [[102, 225], [616, 225], [616, 252], [102, 252]], "difficult": false}, {"transcription": "Trác Than gap xe dien rǒi xách vào theo, de phòng bi trom mat.", "points": [[129, 261], [748, 260], [748, 287], [129, 288]], "difficult": false}, {"transcription": "Quán làu này duoc trang trí tinh té và nhā nhǎn, thoat nhìn còn turòng là", "points": [[129, 300], [861, 297], [861, 324], [129, 327]], "difficult": false}, {"transcription": "nhà hàng Au. Cao Vū Sènh mǎc áo so mi màu xanh thǎm in hinh tròi sao, ngǒi", "points": [[100, 334], [861, 330], [861, 357], [100, 361]], "difficult": false}, {"transcription": "ò vi trí gǎn cira sō, hò hūng uǒng nuóc chanh bac hà. Tong Giám dǒc Cao tuoi", "points": [[100, 369], [861, 364], [861, 391], [100, 396]], "difficult": false}, {"transcription": "tre tài cao, khòng hě mang vé ngòng cuǒng nhu nhūng vi doanh nhàn tré khác", "points": [[101, 404], [861, 398], [861, 424], [101, 431]], "difficult": false}, {"transcription": "thuòng có, phu kièn duy nhat trén nguòi chi là chiěc dǒng ho deo trèn cǒ tay", "points": [[100, 436], [860, 430], [860, 460], [100, 465]], "difficult": false}, {"transcription": "trái， duong nhièn cūng khòng có gì phò truong cà. Nhin tùr xa, tròng hán binh", "points": [[101, 471], [859, 465], [859, 492], [101, 498]], "difficult": false}, {"transcription": "thàn nhu mòt búrc tranh thùy mǎc tīnh lǎng, dàm chat thien tinh.", "points": [[101, 504], [728, 499], [728, 526], [101, 531]], "difficult": false}, {"transcription": "\"Ngai quá, xe dien di hoi chàm.\" Trác Than dǎt chiec xe dien da duroc gap", "points": [[130, 538], [859, 533], [859, 566], [130, 571]], "difficult": false}, {"transcription": "gon khòng còn nhin ra dáng vé ban dau vào canh quǎy lě tàn, sau dó ngǒi", "points": [[100, 575], [857, 567], [857, 597], [100, 605]], "difficult": false}, {"transcription": "xuǒng dǒi dién vói TongGiám dǒc Cao.", "points": [[101, 610], [494, 607], [494, 634], [101, 637]], "difficult": false}, {"transcription": "\"Toi cūng vira tói thoi.\" Cao Vū Senh dua thyrc don cho Trác Thǎn de anh", "points": [[128, 643], [858, 638], [858, 668], [128, 673]], "difficult": false}, {"transcription": "chon món.", "points": [[101, 678], [209, 678], [209, 708], [101, 708]], "difficult": false}, {"transcription": "\"Càu chon di, toi khòng kén ǎn.\" Trác Than cam cǒc nuróc chanh bac hà", "points": [[128, 715], [858, 708], [858, 738], [128, 744]], "difficult": false}, {"transcription": "lèn tu irng uc. Thòi tiet càng ngày càng nóng, chay xe dien giua trua chang", "points": [[99, 749], [858, 744], [858, 774], [99, 779]], "difficult": false}, {"transcription": "khác nào cho thit vào quay trong lò nuóng, di them mot lúc nüra khéo anh", "points": [[101, 784], [858, 779], [858, 806], [101, 811]], "difficult": false}, {"transcription": "chín luòn mat.", "points": [[102, 820], [251, 818], [251, 843], [102, 845]], "difficult": false}, {"transcription": "Cao Vū Senh làng lǎng nhin Trác Than, rǒi gio tay lèn goi nhàn vièn phuc", "points": [[129, 852], [863, 848], [863, 879], [129, 883]], "difficult": false}, {"transcription": "vu tói ghi order. Mōi nguròi có mot chiec nǒi nhò duoc cham tro hoa vǎn", "points": [[100, 888], [861, 881], [861, 912], [100, 919]], "difficult": false}, {"transcription": "tinh xáo, bǒn phan thit gǎu bò lón và các loai thit khác, ratit rau xanh. Thit", "points": [[101, 923], [860, 916], [860, 945], [101, 952]], "difficult": false}, {"transcription": "bò cùa nhà hàng này dugc bày trèn khay dá lanh dài ching mòt mét, tròng", "points": [[98, 956], [861, 952], [861, 981], [98, 986]], "difficult": false}, {"transcription": "rat phong cách.", "points": [[101, 992], [261, 992], [261, 1020], [101, 1020]], "difficult": false}, {"transcription": "\"Toi cú tuòng sep tōng nhà giàu nhu các càu deu khòng ǎn lau co.\" Trác", "points": [[127, 1025], [862, 1021], [862, 1054], [127, 1058]], "difficult": false}, {"transcription": "Than rǎt hài lòng vói bàn thit day áp này, gáp luòn thit bò lèn nhúng chàng", "points": [[98, 1060], [861, 1057], [861, 1087], [98, 1090]], "difficult": false}, {"transcription": "chút khách sáo.", "points": [[103, 1097], [254, 1097], [254, 1121], [103, 1121]], "difficult": false}, {"transcription": "\"Tòi cūng có phài dai gia gì dàu, chi là mot thanh nièn vùra bát dǎu khòi", "points": [[130, 1132], [860, 1128], [860, 1158], [130, 1162]], "difficult": false}, {"transcription": "nghiep thòi.\" Cao Vū Sènh khòng voi nói ra muc dich cùa minh, chi trò chuyèn", "points": [[99, 1167], [860, 1162], [860, 1192], [99, 1197]], "difficult": false}, {"transcription": "vu vo vói Trác Than dē kéo gǎn khoàng cách. Dày là thói quen trèn thuong", "points": [[101, 1199], [861, 1199], [861, 1229], [101, 1229]], "difficult": false}, {"transcription": "truòng cúa hán, trróc khi ǎn khòng bàn chuyèn làm ǎn, dù sao cūng rǎt khó", "points": [[101, 1234], [860, 1230], [860, 1259], [101, 1264]], "difficult": false}, {"transcription": "de thuyět phyc mot nguòi dang dói sòi bung, chò com no ruqu say rǒi mói dě", "points": [[100, 1267], [861, 1262], [861, 1293], [100, 1297]], "difficult": false}, {"transcription": "nói chuyèn.", "points": [[99, 1299], [219, 1303], [218, 1334], [98, 1330]], "difficult": false}, {"transcription": "25", "points": [[462, 1356], [499, 1356], [499, 1385], [462, 1385]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page24.jpg	[{"transcription": "ve sī tam thài", "points": [[471, 52], [605, 54], [605, 78], [471, 76]], "difficult": false}, {"transcription": "Tinh dēn nay, moi lièn he duy nhat giüra hai nguòi chi có Ly Dinh, cho nen", "points": [[198, 95], [904, 97], [904, 125], [198, 123]], "difficult": false}, {"transcription": "ho bát dǎu nói chuyén tùr co khách hàng này.", "points": [[168, 130], [590, 130], [590, 156], [168, 156]], "difficult": false}, {"transcription": "Tat cà mqi nguòi trong còng ty deu biet chuyen Ly Dinh bi ban trai cū deo", "points": [[198, 165], [905, 164], [905, 191], [198, 192]], "difficult": false}, {"transcription": "bám. Lúc hai nguròi hg mói chia tay, Vuong Cánh Hàng còn mò tói tàn cong ty", "points": [[169, 201], [904, 201], [904, 225], [169, 225]], "difficult": false}, {"transcription": "quy bèn ngoài cùra kính khóc lóc cǎu xin tha thú. Ly Dinh xǎu ho quá dành dǎn", "points": [[168, 234], [906, 227], [906, 258], [168, 265]], "difficult": false}, {"transcription": "gā ra ngoài, kět quà là suyt nūa bi gā kéo lèn taxi. Sau dó còng ty goi bào vè tói,", "points": [[168, 269], [905, 263], [905, 293], [168, 299]], "difficult": false}, {"transcription": "khòng cho phép gā buóc vào tòa nhà, nēn gā mói xuǒng hǎm dě xe chǎn nguròi.", "points": [[168, 304], [903, 299], [903, 325], [168, 330]], "difficult": false}, {"transcription": "\"A mà tòi chua hòi dǎy, hòm dó sau khi chúng tòi di, anh da xùr ly thé nào", "points": [[199, 337], [906, 335], [906, 362], [199, 364]], "difficult": false}, {"transcription": "vay?\" May ngày nay khòng thay Vuong Cánh Hàng xuat hien,Trác Than cam", "points": [[169, 374], [906, 368], [906, 395], [169, 401]], "difficult": false}, {"transcription": "thay mǎy tèn nhà minh nói rǎt có ly, loai nguòi khǒn nan này cúr dánh cho mòt", "points": [[169, 405], [908, 401], [908, 430], [169, 435]], "difficult": false}, {"transcription": "tràn là yèn chuyèn.", "points": [[169, 441], [350, 438], [350, 465], [169, 467]], "difficult": false}, {"transcription": "\"Dúng nhu anh doán, gāy xuong cut.\"Có lē hoi nóng nèn Cao Vū Senh xán", "points": [[200, 476], [905, 469], [905, 496], [200, 503]], "difficult": false}, {"transcription": "tay áo so mi lèn tói khuyu tay, de lò ra duòng nét co báp khá rán ròi. ve ly mà", "points": [[169, 508], [907, 502], [907, 533], [169, 539]], "difficult": false}, {"transcription": "nói, dáng lē vào cái tuoi giao thoa giua thieu nièn và dàn òng trròng thành này,", "points": [[169, 541], [907, 538], [907, 568], [169, 571]], "difficult": false}, {"transcription": "các báp thit thuròng sē khá bèo nhèo, nhung Tong Giám dǒc Cao lai có co báp", "points": [[171, 574], [906, 570], [906, 600], [171, 604]], "difficult": false}, {"transcription": "rat chat luong, chác hàn cūng thuòng xuyen tàp luyèn.", "points": [[172, 611], [670, 608], [670, 632], [172, 635]], "difficult": false}, {"transcription": "Hóa ra là nàm liét giuròng khòng dày nǒi à, anh còn turòng tén dó sq thàt", "points": [[199, 646], [908, 642], [908, 668], [199, 672]], "difficult": false}, {"transcription": "roi co. Trác Than hoi hǒi hàn vì dā ra tay manh thě, dáng lě nèn dánh nhe nhe", "points": [[171, 680], [908, 677], [908, 700], [171, 704]], "difficult": false}, {"transcription": "thòi, dě gā còn di lai dugc, nhu vày cǔng có thē thira co dánh thém vài tran nua", "points": [[171, 714], [907, 708], [907, 734], [171, 739]], "difficult": false}, {"transcription": "trong thòi gian còng tác, bào dàm dánh mot tuǎn là phuc ngay.", "points": [[169, 745], [749, 742], [749, 772], [169, 775]], "difficult": false}, {"transcription": "\"Rot cuòc mot ngày cùa anh bao nhièu tiěn?\" Cao Vū Sènh dǎt dūa xuǒng", "points": [[198, 780], [907, 776], [907, 806], [198, 810]], "difficult": false}, {"transcription": "dùng khǎn uót mà nhàn vièn phuc vu dura tói de' lau tay.", "points": [[169, 817], [692, 814], [692, 841], [169, 844]], "difficult": false}, {"transcription": "\"Còn tùy tinh huǒng nira, xem càu muǒn dich vu nhu thě nào, ban ngay,", "points": [[196, 851], [907, 848], [907, 878], [196, 881]], "difficult": false}, {"transcription": "ban dem, hay là hai muoi tr tieng.\"", "points": [[167, 889], [496, 886], [496, 913], [167, 916]], "difficult": false}, {"transcription": "Nguòi nhán vièn phuc vy dua khǎn uót cho Trác Thǎn run cá tay, suyt thì", "points": [[192, 925], [909, 918], [909, 948], [192, 955]], "difficult": false}, {"transcription": "quàng luòn cà khǎn vào nǒi làu, may mà Trác Than nhanh tay bát lai duroc.", "points": [[167, 960], [877, 954], [877, 983], [167, 990]], "difficult": false}, {"transcription": "\"Toi da hòi còng ty cùa anh rǒi, anh chi nhàn còng vièc trong vòng tám", "points": [[195, 994], [908, 992], [908, 1019], [195, 1021]], "difficult": false}, {"transcription": "tiěng dǒng hǒ vào ban ngày, giá trung bình bǒn nghìn, bao cà tháng là ba muroi", "points": [[168, 1030], [908, 1025], [908, 1053], [168, 1058]], "difficult": false}, {"transcription": "nghin. Nhumng bình thuòng anh khòng nhàn bao cà tháng, chi nhàn viec ngán", "points": [[165, 1064], [908, 1058], [908, 1088], [165, 1094]], "difficult": false}, {"transcription": "han.\" Cao Vū Senh khua tay ra hiéu cho nhàn vièn phuc vy ròi di, lay mot tǎm", "points": [[166, 1098], [908, 1094], [908, 1121], [166, 1125]], "difficult": false}, {"transcription": "thé ra day děn trróc mǎt Trác Than,\"Bao tháng nǎm muoi nghin, toi muǒn anh", "points": [[166, 1132], [908, 1127], [908, 1155], [166, 1160]], "difficult": false}, {"transcription": "làm viec cho tòi chín tieng mǒi ngày.\"", "points": [[168, 1167], [516, 1167], [516, 1191], [168, 1191]], "difficult": false}, {"transcription": "Trác Than khòng nhán lǎy tǎm thé kia, chi nám chǎt tǎm khǎn uót da dùng", "points": [[194, 1201], [907, 1201], [907, 1228], [194, 1228]], "difficult": false}, {"transcription": "roi,nhanh nhen gǎp thành mòt con chuòt nhò:\"Vói múrc giá cao nhur vày,càu", "points": [[167, 1234], [906, 1235], [906, 1262], [167, 1260]], "difficult": false}, {"transcription": "hoàn toàn có thě tói nhūng còng ty vé sī chính quy thuè bò dòi dǎc chùng dā", "points": [[165, 1265], [907, 1268], [907, 1297], [165, 1295]], "difficult": false}, {"transcription": "giài ngū mà, cǎn gì phài tim tói tòi.\"", "points": [[167, 1301], [501, 1300], [501, 1327], [167, 1328]], "difficult": false}, {"transcription": "26", "points": [[510, 1355], [546, 1355], [546, 1385], [510, 1385]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page25.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[392, 53], [566, 53], [566, 73], [392, 73]], "difficult": false}, {"transcription": "\"Có nguòi muǒn giet tòi.\" Cao Vū Senh mǎt khòng bien sác, tháp giong nói:", "points": [[139, 95], [852, 95], [852, 122], [139, 122]], "difficult": false}, {"transcription": "4.+", "points": [[84, 115], [91, 115], [91, 140], [84, 140]], "difficult": false}, {"transcription": "\"Ve sī binh thuròng khòng xùr ly duge.\"", "points": [[108, 128], [482, 129], [482, 155], [108, 154]], "difficult": false}, {"transcription": "Trác Than dǎt con chuòt vira gǎp xong xuǒng canh tám thé, cuòi giěu nói:", "points": [[137, 164], [855, 164], [855, 194], [137, 194]], "difficult": false}, {"transcription": "\"ve si binh thuròng khòng làm dugc, vày thì vé sī nghiep du cǎp hai nhu tòi lai", "points": [[107, 197], [856, 198], [856, 228], [107, 227]], "difficult": false}, {"transcription": "cang khōng làm duoc.\"", "points": [[108, 235], [335, 233], [335, 260], [108, 262]], "difficult": false}, {"transcription": "\"Anh làm durc.\"Cao Vū Senh bi con chuòt nhó thu hút sy chúy,tronglúc", "points": [[140, 273], [854, 273], [854, 297], [140, 297]], "difficult": false}, {"transcription": "that than, hǎn lo dang liěc nhin chiěc ba lò den dǎt trèn ghě,\"Anh biét toi dang", "points": [[108, 306], [856, 306], [856, 336], [108, 336]], "difficult": false}, {"transcription": "nói gì mà.\"", "points": [[103, 341], [217, 338], [218, 370], [104, 374]], "difficult": false}, {"transcription": "Trác Thǎn khě hít vào mòt hoi khí lanh, trong dàu túrc khác vang lèn hǒi", "points": [[136, 379], [856, 379], [856, 409], [136, 409]], "difficult": false}, {"transcription": "chuòng cành báo. Anh ngang dàu nhin vào mát Tong Giám doc Cao,ánh mát", "points": [[108, 415], [858, 411], [858, 441], [108, 444]], "difficult": false}, {"transcription": "lúc truóc thoat tròng có vè nhā nhǎn và vò hai giò dày bǒng nhién tràn dày", "points": [[109, 452], [855, 452], [855, 476], [109, 476]], "difficult": false}, {"transcription": "tính xàm lugc, mang chút càm giác de doa khòng děphát hièn ra. Có vé khòng", "points": [[110, 487], [856, 487], [856, 511], [110, 511]], "difficult": false}, {"transcription": "phai tat cá nhūng sinh vàt nhó hon minh děu dáng yeu, Trác Than biu moi, rat", "points": [[109, 521], [857, 518], [857, 545], [109, 548]], "difficult": false}, {"transcription": "nhanh nhen và dúrt khoát day tǎm the lai:\"Xin lǒi, tòi khòng rành.\"", "points": [[108, 556], [753, 553], [753, 580], [108, 583]], "difficult": false}, {"transcription": "Cao Vū Sènh chàm rai dura tay lǎy cà con chuòt gǎp bàng khǎn uót kia vě.", "points": [[138, 593], [844, 592], [844, 619], [138, 620]], "difficult": false}, {"transcription": "Dù Trác Than tùr choi don hàng vói Tong Giám doc Cao, nhung doi phuong", "points": [[138, 628], [858, 631], [858, 659], [138, 656]], "difficult": false}, {"transcription": "cūng khòng nài ni nhiěu, còn tǒt bung lái xe dura anh vě nhà, de anh khòi bi", "points": [[110, 667], [859, 663], [859, 689], [110, 694]], "difficult": false}, {"transcription": "phoi náng thành miěng thit khò vi lau. Làm ǎn khòng thành nhumg vǎn thau", "points": [[110, 702], [858, 698], [858, 725], [110, 728]], "difficult": false}, {"transcription": "tinh dat ly, chu dáo tói múrc khien nguròi ta khòng the bói móc chút khuyět", "points": [[110, 734], [859, 733], [859, 761], [110, 762]], "difficult": false}, {"transcription": "diem nào, khòng hō là doanh nhàn trè có tài sàn lèn tói cá trǎm triéu.", "points": [[110, 769], [770, 768], [770, 795], [110, 796]], "difficult": false}, {"transcription": "Buoi tǒira ngoài mua thurc ǎn, Trác Than tièn duòng di vòng qua Dich vu", "points": [[140, 807], [857, 807], [857, 834], [140, 834]], "difficult": false}, {"transcription": "gia dinh Báo Bien, báo vói òng chù Chu ràng vu làm ǎn mói dàm phán that bai", "points": [[110, 843], [859, 838], [859, 868], [110, 873]], "difficult": false}, {"transcription": "rǒi, nhò gā chú y tim viéc mói cho minh.", "points": [[112, 879], [502, 878], [502, 902], [112, 903]], "difficult": false}, {"transcription": "\"Viec tǒt nhur vày mà càu còn tùr chǒi à?\" Chu béo òm nira quà dua hǎu Trác", "points": [[141, 913], [859, 912], [859, 940], [141, 941]], "difficult": false}, {"transcription": "Than mua, vira ǎn vira máng\"Cau khòng làm thi de bon Dieu Hau làm cūng duoc", "points": [[111, 949], [858, 947], [858, 974], [111, 976]], "difficult": false}, {"transcription": "mà, khó lám mói quen duoc vói mōt khách hàng lón ra tay hào phóng nhur the.\"", "points": [[110, 984], [855, 979], [855, 1007], [110, 1011]], "difficult": false}, {"transcription": "\"Khách hàng lón trà hàu hīnh den máy di nüra thì cǔng phài còn mang mói", "points": [[141, 1021], [857, 1018], [857, 1046], [141, 1049]], "difficult": false}, {"transcription": "kiem dugc chúr.\" Cúr nghī tói ánh mát thàng nhai kia nhin minh là Trác Than", "points": [[110, 1056], [858, 1052], [858, 1079], [110, 1083]], "difficult": false}, {"transcription": "lai càm thay hoi hoáng, dura tay an gā dau troc mōt cái that manh,\"An dura hau", "points": [[108, 1091], [859, 1085], [859, 1115], [108, 1121]], "difficult": false}, {"transcription": "cùa anh di.\"", "points": [[110, 1126], [232, 1124], [232, 1152], [110, 1154]], "difficult": false}, {"transcription": "*", "points": [[472, 1164], [503, 1164], [503, 1179], [472, 1179]], "difficult": false}, {"transcription": "Chóp mát da tói sáng thúr Hai, Trác Than chò cháu trai di dón Ly Dinh,", "points": [[141, 1201], [855, 1197], [855, 1224], [141, 1228]], "difficult": false}, {"transcription": "thuàn tién mua do ǎn sáng bò vào giò xe. Tuǎn truróc anh phát hien cò gái này", "points": [[112, 1235], [856, 1234], [856, 1260], [112, 1262]], "difficult": false}, {"transcription": "buòi sáng bàn trang diēm khòng có thòi gian ǎn, nèn cǔng tièn mua luòn mòt", "points": [[112, 1270], [856, 1266], [856, 1294], [112, 1297]], "difficult": false}, {"transcription": "phan cho cò ày ǎn trong lúc di duòng.", "points": [[112, 1303], [478, 1305], [478, 1333], [112, 1331]], "difficult": false}, {"transcription": "27", "points": [[469, 1357], [499, 1357], [499, 1385], [469, 1385]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page26.jpg	[{"transcription": "ve aī tam thoi", "points": [[463, 51], [601, 49], [601, 73], [463, 75]], "difficult": false}, {"transcription": "\"Cau oi, trong sàn nhieu nguòi the.\" Trác Mong Mong nhoài nguòi trén tay", "points": [[189, 92], [905, 93], [905, 124], [189, 123]], "difficult": false}, {"transcription": "lái, tò mò nhin vào bèn trong. Hom nayThái Trang Tan Thanh có gi dó hoi bat", "points": [[158, 129], [903, 127], [903, 153], [158, 155]], "difficult": false}, {"transcription": "thuròng. Moi ngày vào thòi diem này sě turong dǒi yén tīnh, chi có mot vài thanh", "points": [[159, 163], [904, 160], [904, 187], [159, 190]], "difficult": false}, {"transcription": "nièn chay vòi dē kip xe buyt hay tàu dièn, vày mà bay giò già tré gái trai déu cé", "points": [[160, 196], [904, 193], [904, 221], [160, 224]], "difficult": false}, {"transcription": "mǎt dòng dù, truóe cōng còn có mòt chiěc xe cánh sát dang sáng den.", "points": [[159, 231], [809, 227], [809, 254], [159, 258]], "difficult": false}, {"transcription": "Trre giác khiēn tim Trác Than dap thich mot cái that manh, anh tǎng těe", "points": [[188, 266], [903, 262], [903, 292], [188, 296]], "difficult": false}, {"transcription": "phóng xe dien vào trong.", "points": [[160, 303], [399, 303], [399, 330], [160, 330]], "difficult": false}, {"transcription": "\"Dùng lai, dùng lai, dàng trróc khong di dugc dàu.\"Canh sát cán chiec xe", "points": [[189, 338], [906, 333], [906, 363], [189, 368]], "difficult": false}, {"transcription": "dien lai, quay dàu cao giong quát vói dám dòng,\"Nhin cái gì mà nhìn, mau", "points": [[160, 372], [904, 368], [904, 397], [160, 401]], "difficult": false}, {"transcription": "giài tán di, có gi hay mà xem!\"", "points": [[160, 409], [448, 403], [448, 431], [160, 437]], "difficult": false}, {"transcription": "Trác Than quǎng xe dièn ra, goi dien thoai cho Ly Dinh nhung khòng ai", "points": [[189, 440], [905, 438], [905, 468], [189, 470]], "difficult": false}, {"transcription": "nghe máy, cau mày chen vào giüra dám nguòi. Chǒ gǎn turòng truóc tòa nhà da", "points": [[161, 478], [904, 471], [904, 498], [161, 505]], "difficult": false}, {"transcription": "durge chǎng dày ngǎn cách, moi nguròi děu thi nhau thò cǒ ngó vào bèn trong", "points": [[161, 508], [904, 508], [904, 538], [161, 538]], "difficult": false}, {"transcription": "chàng biět có thě thǎy duoc gì qua ba lóp nguròi này nūra.", "points": [[164, 544], [693, 544], [693, 571], [164, 571]], "difficult": false}, {"transcription": "Trác Than nhanh chóng hít mòt hoi oxy, day dám dòng ra de lǎy mot khe", "points": [[189, 578], [905, 577], [905, 607], [189, 608]], "difficult": false}, {"transcription": "hò, sài buróc len len trén cùng. Còn chua dúng vūng,Trác Than da voi vàng áp", "points": [[160, 612], [904, 613], [904, 643], [160, 642]], "difficult": false}, {"transcription": "dau Mong Mòng vào lòng minh:\"Nhám mát lai,dùng nhin.\"", "points": [[165, 647], [732, 647], [732, 674], [165, 674]], "difficult": false}, {"transcription": "Trèn něn xi mǎng lǒ chō ō gà, mòt thi thě nát bày làng lǎng nàm dó, máu", "points": [[190, 681], [904, 683], [904, 712], [190, 710]], "difficult": false}, {"transcription": "tuoi tùy nāo da khò can, giǒng nhur màu vē chàt luong thǎp dòng dǎc phù kháp", "points": [[162, 718], [902, 718], [902, 745], [162, 745]], "difficult": false}, {"transcription": "mǎt dat qua bàn tay ma quy.", "points": [[161, 752], [428, 752], [428, 779], [161, 779]], "difficult": false}, {"transcription": "Bèn canh có nguròi cùa cành sát dang chup ành hǒ so:\"Nguròi chět là Ly", "points": [[188, 784], [904, 788], [904, 819], [188, 815]], "difficult": false}, {"transcription": "Dinh, nū, hai muoi báy tuòi.\"", "points": [[159, 821], [438, 819], [438, 849], [159, 851]], "difficult": false}, {"transcription": "28", "points": [[508, 1368], [540, 1368], [540, 1394], [508, 1394]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page27.jpg	[{"transcription": "Cnuong5", "points": [[416, 101], [552, 104], [552, 136], [416, 133]], "difficult": false}, {"transcription": "Sao tren troi (5)", "points": [[317, 151], [647, 155], [647, 195], [317, 192]], "difficult": false}, {"transcription": "令", "points": [[423, 222], [445, 222], [445, 250], [423, 250]], "difficult": false}, {"transcription": "\"Sao còn trè thě mà lai nhay lau co chú?\"", "points": [[126, 273], [534, 273], [534, 300], [126, 300]], "difficult": false}, {"transcription": "\"Dám thanh nièn bay giò ay mà, tō chàt tàm ly yěu lám, chác là cóng vièc", "points": [[124, 305], [870, 310], [870, 340], [124, 335]], "difficult": false}, {"transcription": "khòng thuàn lqi hay chia tay gì dó xong nghī quan thòi.\"", "points": [[95, 344], [659, 344], [659, 371], [95, 371]], "difficult": false}, {"transcription": "\"Phài nghī quàn tói múc nào mói nhày làu khi mǎc áo ngù thě này chú!\"", "points": [[123, 377], [844, 378], [844, 409], [123, 408]], "difficult": false}, {"transcription": "\"Da muǒn chět ròi thì ai còn quan tàm mǎc gì nüra?\"", "points": [[125, 412], [644, 415], [644, 445], [125, 443]], "difficult": false}, {"transcription": "Kiem tra so bò xong thi the da duqc cánh sát che lai, trróc cành turong", "points": [[124, 448], [871, 453], [871, 484], [124, 479]], "difficult": false}, {"transcription": "khòng còn kinh khùng nhu lúc nāy, mqi nguròi lai càng to gan hon, bát dau bàn", "points": [[94, 484], [869, 485], [869, 515], [94, 514]], "difficult": false}, {"transcription": "tán xòn xao, kiēu gì cūng nói duoc.", "points": [[95, 519], [446, 521], [446, 547], [95, 545]], "difficult": false}, {"transcription": "Cánh tay dang òm dúra bé cùa Trác Than dan siet chǎt lai, chǎt tói múc", "points": [[125, 555], [868, 556], [868, 583], [125, 582]], "difficult": false}, {"transcription": "Mòng Mong bi dau, càu bé vùi dǎu vào nguc anh, nhò giong hòi:\"Cau oi,có", "points": [[95, 590], [868, 590], [868, 617], [95, 617]], "difficult": false}, {"transcription": "chuyèn gì vày a?\"", "points": [[96, 624], [275, 622], [275, 650], [96, 652]], "difficult": false}, {"transcription": "TrácThǎn ǎn dàu càu bé lai khòng cho nó ngang lèn, quay lung ròi khòi", "points": [[123, 658], [868, 660], [868, 687], [123, 685]], "difficult": false}, {"transcription": "dám nguòi On a. Chiěc xe màu tráng second-hand cùa Ly Dinh vǎn dǒ bèn", "points": [[95, 692], [868, 691], [868, 717], [95, 718]], "difficult": false}, {"transcription": "duòng, trèn con phǒ nhò này khòng bi dán phieu phat nèn moi nguòi deu dǒ", "points": [[95, 725], [868, 723], [868, 750], [95, 752]], "difficult": false}, {"transcription": "xe ò duòng dành cho xe dap. Cò gái dó rat trong thě dien, dǒng nghiep děu có", "points": [[93, 757], [869, 756], [869, 786], [93, 787]], "difficult": false}, {"transcription": "xe di nèn cò cūng muǒn có, chàng qua khòng nhiěu tiěn děn vày nèn dành tói", "points": [[95, 792], [869, 792], [869, 819], [95, 819]], "difficult": false}, {"transcription": "chg xe cū tim mot chiec xe còn mói tám muoi phǎn trǎm. Chiec xe màu tráng", "points": [[95, 823], [870, 825], [870, 855], [95, 853]], "difficult": false}, {"transcription": "bóng loáng khòng dính mòt giot bùn nào, hien nhièn cuoi tuǎn vùra durqc don", "points": [[95, 860], [869, 859], [869, 886], [95, 887]], "difficult": false}, {"transcription": "rúra dē chò vè sī tam thòi cúa cò tói dón di lam.", "points": [[96, 894], [560, 893], [560, 917], [96, 918]], "difficult": false}, {"transcription": "Lái chiěc xe dièn di nguoc dòng nguòi trong giò cao diem buoi sáng, Trác", "points": [[123, 928], [870, 928], [870, 958], [123, 958]], "difficult": false}, {"transcription": "Than nhu bi vùi lǎp trong con giàn dū phùrng phùng. Něu khòng phài bày giò", "points": [[94, 962], [868, 963], [868, 989], [94, 988]], "difficult": false}, {"transcription": "dang khòng hít khí oxy thì có khi anh da bóp nát cà tay lái xe roi. Vat và dap xe", "points": [[96, 996], [869, 995], [869, 1022], [96, 1023]], "difficult": false}, {"transcription": "děn truóc cōng truòng mam non, anh mói dan binh tīnh lai.", "points": [[95, 1029], [687, 1028], [687, 1055], [95, 1056]], "difficult": false}, {"transcription": "Ong Duong bào vè cùa khu nhà doi dièn vùra nhìn thǎy hai càu cháu da làp", "points": [[122, 1065], [868, 1064], [868, 1094], [122, 1095]], "difficult": false}, {"transcription": "túrc tuoi curòi chào hòi:\"Tieu Trác day à, sao hòm nay děn sóm the cháu?\"", "points": [[94, 1101], [825, 1098], [825, 1125], [94, 1128]], "difficult": false}, {"transcription": "Trác Than hít sàu mot hoi,xách gói do ǎn sáng trong giò xe ra dura cho òng:", "points": [[120, 1134], [869, 1136], [869, 1167], [120, 1165]], "difficult": false}, {"transcription": "\"Cháu mang do ǎn sáng cho bác này.\"", "points": [[93, 1169], [475, 1170], [475, 1200], [93, 1199]], "difficult": false}, {"transcription": "\"ǒi chà, bao nhièu nǎm roi mà cháu còn khách sáo the.\" Ong Duong cuòi ha", "points": [[123, 1206], [867, 1205], [867, 1233], [123, 1234]], "difficult": false}, {"transcription": "hà nhàn lǎy, ra hièu cho Trác Thǎn dǒ xe dièn vào san khu nhà bén òng.", "points": [[90, 1243], [805, 1241], [805, 1267], [90, 1270]], "difficult": false}, {"transcription": "Trác Than khóa xe dien, be Mòng Mòng vào nhà ǎn cùa truòng mǎm non", "points": [[120, 1277], [869, 1273], [869, 1304], [120, 1308]], "difficult": false}, {"transcription": "dē cho càu bé ǎn sáng, còn minh thì cam cái bánh rán nhàn thit di ra sàn, ngǒi", "points": [[92, 1312], [866, 1308], [866, 1336], [92, 1340]], "difficult": false}, {"transcription": "29", "points": [[460, 1367], [499, 1367], [499, 1395], [460, 1395]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page28.jpg	[{"transcription": "ve sītam thoi", "points": [[470, 57], [604, 59], [604, 83], [470, 81]], "difficult": false}, {"transcription": "xuǒng chiěe ghě hinh cày nǎm, māi vǎn khòng nuǒt nói. Anh nhin chàm chàm", "points": [[165, 102], [904, 98], [904, 126], [165, 130]], "difficult": false}, {"transcription": "vào màn hinh dien thoai, dqi cánh sát goi tói. Sáng nay anh dā goi dien cho Ly", "points": [[166, 135], [905, 133], [905, 160], [166, 162]], "difficult": false}, {"transcription": "Dinh, chǎc chán cánh sát sě goi dien dieu tra anh dàu tièn, nhurng dgi děn tán", "points": [[166, 168], [906, 165], [906, 192], [166, 195]], "difficult": false}, {"transcription": "khi bánh nguòi rǒi vǎn khòng thǎy có cuòc goi nào cà.", "points": [[166, 201], [672, 200], [672, 227], [166, 228]], "difficult": false}, {"transcription": "\"Cau oi, minh khòng dón chi gái tǎng con thó di làm a?\" Trác Mòng Mong", "points": [[197, 238], [908, 235], [908, 263], [197, 266]], "difficult": false}, {"transcription": "cǎm con thò cup tai màu tráng muǒt di tói. Ban nāy hien truòng quá hǒn loan,", "points": [[169, 274], [907, 269], [907, 296], [169, 301]], "difficult": false}, {"transcription": "còn bi càu che mát nèn bé khòng nhìn thay gì hět, nghe cūng khòng hieu gì.", "points": [[168, 308], [880, 303], [880, 330], [168, 335]], "difficult": false}, {"transcription": "Tay chàn cùa chú thò tai cup kia deu měm měm, lòng dài che khuàt cá mát", "points": [[198, 345], [907, 337], [907, 364], [198, 372]], "difficult": false}, {"transcription": "rat dáng yèu. Chác cò ay phài thich nó lám mói treo trèn túi xách suǒt, nhung", "points": [[167, 375], [911, 368], [911, 402], [167, 409]], "difficult": false}, {"transcription": "lai tǎng luòn cho càu bé mà chǎng chút do du.", "points": [[169, 414], [598, 404], [598, 431], [169, 441]], "difficult": false}, {"transcription": "Trác Than nhin chú thò kia, khàn giong nói:\"Chi ay di trróc roi, sau này", "points": [[198, 444], [907, 438], [907, 469], [198, 475]], "difficult": false}, {"transcription": "khòng cǎn chúng ta tói dón nǔra.\"", "points": [[171, 483], [485, 476], [485, 503], [171, 510]], "difficult": false}, {"transcription": "\"Vay a.\"Mòng Mòng that vong dáp, rǒi tr di ra choi ò chǒ xích du phía xa.", "points": [[200, 516], [907, 508], [907, 535], [200, 543]], "difficult": false}, {"transcription": "Cuc Canh sát khong goi dien tói, Trác Than dinh goi cho Phuong So Durong", "points": [[200, 550], [909, 544], [909, 574], [200, 580]], "difficult": false}, {"transcription": "hòi thù, nhung bày giò vièc này vǎn do cành sát khu vurc quàn ly, chác tèn kia", "points": [[170, 585], [907, 576], [907, 604], [170, 613]], "difficult": false}, {"transcription": "cūng khòng biet duqc gi Anh mò dièn thoai lèn, luót qua luót lai chǒ danh ba,", "points": [[170, 618], [907, 610], [907, 638], [170, 646]], "difficult": false}, {"transcription": "dau ngón tay dùng lai ò cái tèn\"Cao Vū Sènh\".", "points": [[171, 652], [609, 644], [609, 670], [171, 679]], "difficult": false}, {"transcription": "The chat cia Trác Thǎn hoi trái vói quy luàt tr nhien, tùr nhò Trác Kien Quoc", "points": [[198, 686], [908, 677], [908, 704], [198, 713]], "difficult": false}, {"transcription": "da nhác nhò anh phài che giǎu diēm dǎc bièt này, dě phòng vě sau lai chuǒc", "points": [[169, 720], [908, 711], [908, 738], [169, 746]], "difficult": false}, {"transcription": "hoa vào thàn. Nguòi binh thuòng ratit khi lièn tuòng vièc hít khí oxy nǒng dò", "points": [[168, 752], [908, 744], [908, 772], [168, 780]], "difficult": false}, {"transcription": "cao vói viec tǎng súc manh lèn chi trong nháy mát, chi cho ràng anh thrc sur có", "points": [[168, 786], [908, 777], [908, 804], [168, 813]], "difficult": false}, {"transcription": "bènh vě ho hap gì dó. Nhurng rō ràng Cao Vū Sènh da doán ra, diěu này khiěn", "points": [[167, 819], [908, 810], [908, 837], [167, 846]], "difficult": false}, {"transcription": "Trác Thǎn vò thúrc muǒn tránh xa hán. Thě nhung, bày giò nguròi có thě trò", "points": [[167, 851], [908, 843], [908, 871], [167, 879]], "difficult": false}, {"transcription": "chuyèn vói anh vě Ly Dinh chi có minh Cao Vū Senh thoi.", "points": [[168, 886], [702, 879], [702, 905], [168, 912]], "difficult": false}, {"transcription": "Anh cán hai ba mieng ǎn het chiec bánh, trong lòng thyc sur buǒn brc děn", "points": [[196, 919], [909, 914], [909, 942], [196, 947]], "difficult": false}, {"transcription": "phát hoáng, lúc dinh thǎn lai thì da bam nút goi rǒi. Chuòng chi vùra vang mt", "points": [[165, 953], [909, 947], [909, 977], [165, 984]], "difficult": false}, {"transcription": "tiěng, dǒi phuong da nhac máy, có muǒn tǎt cūng khòng kip.", "points": [[165, 987], [733, 982], [733, 1012], [165, 1016]], "difficult": false}, {"transcription": "\"Anh döi y roi à?\" Giong cúa Tong Giám dǒc Cao vǎn có tác dung thur gian", "points": [[192, 1021], [909, 1018], [909, 1047], [192, 1050]], "difficult": false}, {"transcription": "ha hòa nhu truróc.", "points": [[166, 1059], [332, 1056], [332, 1080], [166, 1083]], "difficult": false}, {"transcription": "Trác Than hat nhe tóc vě phía sau, tho hát ra mot hoi:\"Ly Dinh chetroi.\"", "points": [[192, 1092], [888, 1087], [888, 1115], [192, 1120]], "difficult": false}, {"transcription": "\".\"Diphuong im lǎng mat may giày, giong dieu nghièm túc hǎn lèn,\"Có", "points": [[191, 1125], [909, 1122], [909, 1156], [191, 1159]], "difficult": false}, {"transcription": "chuyén gì vày? Chuyèn xáy ra khi nào?\"", "points": [[166, 1163], [541, 1160], [541, 1187], [166, 1190]], "difficult": false}, {"transcription": "\"Toi qua có ày roi tùr trèn lǎu xuǒng, sáng sóm nay lúc tòi tói dón thì cǒ ay", "points": [[193, 1198], [907, 1197], [907, 1224], [193, 1225]], "difficult": false}, {"transcription": "dā mat rǒi. Toi dang dqi dién thoai cúa cành sát, có lē cành sát cǔng sē nhanh", "points": [[168, 1232], [908, 1232], [908, 1256], [168, 1256]], "difficult": false}, {"transcription": "chóng tim chúng ta de dieu tra thòi.\" Trác Than dúng dày tua vào lan can, nhin", "points": [[167, 1264], [908, 1262], [908, 1289], [167, 1290]], "difficult": false}, {"transcription": "nhūng nguròi dàn lao dòng và hoc sinh di lai hǒi hà trén duòng, cǒ gáng kě su", "points": [[165, 1293], [910, 1295], [910, 1326], [165, 1324]], "difficult": false}, {"transcription": "30", "points": [[510, 1359], [543, 1359], [543, 1385], [510, 1385]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page29.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[392, 54], [565, 54], [565, 75], [392, 75]], "difficult": false}, {"transcription": "vièc mot cách khách quan, khòng thèm thát quan diem cá nhàn, khòng bình", "points": [[99, 97], [856, 97], [856, 124], [99, 124]], "difficult": false}, {"transcription": "luàn là tr sát hay bi giet hai, nén het nhūng lòi chùi tuc vào trong hong.", "points": [[95, 128], [795, 131], [795, 157], [95, 154]], "difficult": false}, {"transcription": "\"Toi biet roi, anh.. ding nóng gian.\" Von tuòng ràng Tong Giám dǒc Cao", "points": [[128, 160], [858, 162], [858, 193], [128, 191]], "difficult": false}, {"transcription": "sē trà lòi lanh lùng, nhung khòng ngò hán còn thàn trong khuyèn nhù anh mòt", "points": [[96, 195], [857, 196], [857, 223], [96, 222]], "difficult": false}, {"transcription": "càu, giong nói nhe nhàng nhu hoi thò.", "points": [[97, 229], [474, 228], [474, 255], [97, 256]], "difficult": false}, {"transcription": "Trác Than tham hoài nghi tai minh có van de, něu khòng vì sao anh lai càm", "points": [[125, 260], [858, 263], [858, 293], [125, 290]], "difficult": false}, {"transcription": "thǎy càu\"dùng nóng giàn\" kia có chút ngot ngào co chú. Nó khiěn mot ké", "points": [[97, 296], [859, 296], [859, 326], [97, 326]], "difficult": false}, {"transcription": "khòng the kháng lai nhūng sinh vàt měm mai non nót nhur anh thoáng chǒc", "points": [[96, 329], [858, 327], [858, 357], [96, 359]], "difficult": false}, {"transcription": "nhūn cá nguòi. Thò hát mot hoi dài thuot, Trác Thǎn mói nhan ra minh vira de", "points": [[97, 364], [859, 361], [859, 388], [97, 391]], "difficult": false}, {"transcription": "lò quá nhieu càm xúc. Anh ngǒi lai xuǒng chiec ghě cày nǎm, nói:\"Toi khòng", "points": [[95, 396], [857, 394], [857, 423], [95, 426]], "difficult": false}, {"transcription": "nóng giàn.\"", "points": [[95, 431], [215, 426], [216, 458], [96, 463]], "difficult": false}, {"transcription": "Các bac phu huynh luc tuc dura con den truòng, Trác Than mǎc chiec tap de", "points": [[127, 462], [855, 460], [855, 490], [127, 492]], "difficult": false}, {"transcription": "màu xanh pastel, turoi curòi dón các bé vào truòng mam non.", "points": [[97, 498], [685, 495], [685, 522], [97, 525]], "difficult": false}, {"transcription": "\"Dao Dao!\" Co bé buòc tóc hai ben thát no buóm vùra buóc vào, Mòng", "points": [[129, 531], [856, 531], [856, 558], [129, 558]], "difficult": false}, {"transcription": "Mòng ngǒi mòt minh trèn xích du làp túrc phan chan tinh than, ǎn sach nǒi", "points": [[97, 566], [855, 561], [855, 588], [97, 593]], "difficult": false}, {"transcription": "buǒn vì khòng durgc dón chi thó di làm cùng chiěc bánh quy mà Dao Dao dua.", "points": [[97, 598], [856, 594], [856, 621], [97, 625]], "difficult": false}, {"transcription": "Nhung nguòi lón thì khòng the ǎn sach phien nāo durgc, quá nhièn cành sát", "points": [[126, 635], [856, 630], [856, 656], [126, 661]], "difficult": false}, {"transcription": "da tói tim Trác Than de diěu tra ngay trong buoi sáng. Tam thòi vu này vǎn", "points": [[97, 665], [855, 661], [855, 690], [97, 695]], "difficult": false}, {"transcription": "do Dǒn Canh sát khu vuc quàn ly, nhūng nguòi có lièn quan trong khu dàn cur", "points": [[98, 700], [856, 695], [856, 722], [98, 726]], "difficult": false}, {"transcription": "cūng bi dua tói dày dě lǎy lài khai, máy vièn cánh sát bàn túi bui.", "points": [[98, 732], [732, 728], [732, 756], [98, 760]], "difficult": false}, {"transcription": "\"Các càu goi tòi den daylàm gibà già nhur toi còn có thegit nguòi dugc chác?\"", "points": [[127, 764], [855, 759], [855, 793], [127, 798]], "difficult": false}, {"transcription": "\"Toi qua tòi vě ben ngoai vói vg minh, khòng hě có nhà. Các anh cǔng thǎy", "points": [[131, 802], [854, 802], [854, 829], [131, 829]], "difficult": false}, {"transcription": "roi dǎy, sáng nay tòi mói vě mà.\"", "points": [[99, 838], [422, 834], [422, 858], [99, 862]], "difficult": false}, {"transcription": "\"Toi khòng nghe thay tiěng dòng la nào cà. Các càu khòng biět dǎy chú,", "points": [[129, 869], [854, 869], [854, 896], [129, 896]], "difficult": false}, {"transcription": "cách àm cúa tòa nhà chúng tòi cc ky kém, tiěng gì cūng có cà. Nào là tiěng cāi", "points": [[97, 903], [855, 901], [855, 928], [97, 930]], "difficult": false}, {"transcription": "co, tiěng dánh con, tiěng nhày nhót, ngày nào cūng ǒn gan chět, něu có xày ra", "points": [[97, 936], [854, 934], [854, 962], [97, 964]], "difficult": false}, {"transcription": "chuyén gì thàt thì cūng chǎng nghe noi.\"", "points": [[98, 971], [496, 964], [496, 992], [98, 999]], "difficult": false}, {"transcription": "Bác gái, dòi vg chǒng tré sǒng cùng tang vói Ly Dinh và hàng xóm ò tǎng", "points": [[124, 1002], [854, 1000], [854, 1031], [124, 1033]], "difficult": false}, {"transcription": "trèn tǎng duói děu bi goi tói, ai cǔng tranh nhau nói loan hět cà lèn.", "points": [[97, 1038], [753, 1033], [753, 1060], [97, 1065]], "difficult": false}, {"transcription": "\"Anh là Trác Than phai khòng tai sao sáng nay anh lai goi dien cho nan nhàn?\"", "points": [[126, 1071], [853, 1067], [853, 1097], [126, 1101]], "difficult": false}, {"transcription": "Canh sát phy trách gō xuǒng bàn, nhin anh bàng ánh mát hoài nghi.", "points": [[97, 1106], [731, 1102], [731, 1129], [97, 1133]], "difficult": false}, {"transcription": "Trác Than dòi mát khòi may nguòi hàng xóm, nghièng nguòi dua vào bàn,", "points": [[125, 1141], [855, 1140], [855, 1167], [125, 1168]], "difficult": false}, {"transcription": "nói vói vè rǎt hò hūng:\"Toi là vé sī rièng cùa cò ay, děn dón cò ày di làm.\"", "points": [[95, 1172], [823, 1170], [823, 1200], [95, 1202]], "difficult": false}, {"transcription": "\"A,vé si.. Hà, vè sīá?\"Vièn cành sát tréngang phát daulèn,dap bòp xuǒng", "points": [[128, 1210], [854, 1210], [854, 1237], [128, 1237]], "difficult": false}, {"transcription": "bàn làm cho bò am chén kieu cǔ rung lách cách,\"Nói chuyèn cho dàng hoàng", "points": [[95, 1242], [853, 1243], [853, 1269], [95, 1268]], "difficult": false}, {"transcription": "mot nguòi làm còng ǎn luong nhu cò ày thì thuè vè sī làm gi? Anh là ban cúa", "points": [[95, 1274], [854, 1271], [854, 1301], [95, 1304]], "difficult": false}, {"transcription": "cò ày phài khòng?\"", "points": [[96, 1304], [287, 1308], [287, 1338], [96, 1335]], "difficult": false}, {"transcription": "31", "points": [[460, 1363], [491, 1363], [491, 1389], [460, 1389]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page30.jpg	[{"transcription": "Vesītamthāi", "points": [[480, 57], [612, 57], [612, 78], [480, 78]], "difficult": false}, {"transcription": "\"Toi nói that.\" Trác Than chong mǎt bàng mot tay,ghé sát hon chút,\"Co áy", "points": [[209, 99], [904, 101], [904, 128], [209, 126]], "difficult": false}, {"transcription": "bi ban trai cū deo bám, còn bi dánh hai lan, báo cánh sát các anh nhung khóng", "points": [[179, 137], [901, 137], [901, 160], [179, 160]], "difficult": false}, {"transcription": "ai quan tàm nén dành phài thuévé sī thòi.\"", "points": [[179, 171], [583, 167], [583, 192], [179, 196]], "difficult": false}, {"transcription": "\"Bi ban trai cǔ deo bám.\" Vièn cánh sát tré bát dugc manh moi quan trong", "points": [[209, 204], [902, 204], [902, 234], [209, 234]], "difficult": false}, {"transcription": "nghièm túc ghi chép lai,\"Ban trai cǔ tèn gì?\"", "points": [[180, 244], [595, 238], [595, 265], [180, 271]], "difficult": false}, {"transcription": "Vùra nói Trác Than vùra liěc nhin mǎy trang giáy trong tay vien cánh sát tre", "points": [[208, 278], [904, 274], [904, 301], [208, 305]], "difficult": false}, {"transcription": "mà càu ta chua kip thu lai.", "points": [[181, 315], [429, 313], [429, 338], [181, 340]], "difficult": false}, {"transcription": "[Dieu tra so bō hièn truòng: Khōng có vēt throng rō rét bén ngoài, vě co ban khóp", "points": [[208, 349], [905, 344], [905, 374], [208, 379]], "difficult": false}, {"transcription": "vói dièu kièn tir vong roi tu do tie trèn cao xuǒng. Hành lang khòng có dǎu vet àu dǎ", "points": [[182, 386], [904, 380], [904, 406], [182, 413]], "difficult": false}, {"transcription": "trong phòng nguòi chet khōng có dàu vēt bi xàm nháp, dang dgi giám dinh dau án tay", "points": [[181, 419], [906, 412], [906, 442], [181, 448]], "difficult": false}, {"transcription": "tren tay nám cia. Nghi ngò tue sát...", "points": [[184, 454], [495, 451], [495, 476], [184, 479]], "difficult": false}, {"transcription": "\"Khòng thě có chuyèn cò ay tu sát durgc.\" Trác Than chi vào hai chūr kia.", "points": [[212, 488], [880, 482], [880, 509], [212, 515]], "difficult": false}, {"transcription": "vièn cành sát trè vòi vàng giǎu tò giày xuǒng durói kep tài liéu:\"Khòng", "points": [[210, 521], [905, 519], [905, 550], [210, 552]], "difficult": false}, {"transcription": "duoc nhin lung tung!\"", "points": [[183, 560], [389, 558], [389, 586], [183, 588]], "difficult": false}, {"transcription": "\"Tai sao lai khòng the?\" Mot nguròi trung nién ngǒi phía sau màn hinh", "points": [[212, 595], [905, 589], [905, 616], [212, 622]], "difficult": false}, {"transcription": "máy tính, nhàn nhā bung tách trà nóng, tròng hoàn toàn khòng ǎn nhàp gì vói", "points": [[182, 629], [905, 623], [905, 651], [182, 657]], "difficult": false}, {"transcription": "khung cành bàn ròn xung quanh, hien nhièn là mòt tay già dòi thích ra vè ta", "points": [[179, 663], [906, 656], [906, 682], [179, 690]], "difficult": false}, {"transcription": "dày thuròng thǎy trong các don vi hành chính,\"Dám thanh nièn bày giò ay à,", "points": [[180, 697], [904, 689], [904, 716], [180, 724]], "difficult": false}, {"transcription": "nira dèm khòng ngù durgc thuòng thích nghī linh tinh, doc mòt bò truyèn thòi", "points": [[177, 730], [905, 722], [905, 749], [177, 757]], "difficult": false}, {"transcription": "cūng có thě nhày lǎu. Ban trai cǔ quǎn lǎy cǔng dàu phài chuyèn gì lón, cò ta", "points": [[180, 765], [905, 756], [905, 783], [180, 792]], "difficult": false}, {"transcription": "thué càu làm vè sī chác chán là vì lí do khác.\"", "points": [[180, 800], [595, 793], [595, 817], [180, 824]], "difficult": false}, {"transcription": "Trong lòi phàn tích nghe nhu binh thuòng lai àn chúra phòng doán vò cùng", "points": [[206, 836], [905, 828], [905, 855], [206, 863]], "difficult": false}, {"transcription": "ácy vě nguròi chět. Trác Than bóp nhe binh oxy trong ba lò qua lóp vai, hít sàu", "points": [[178, 871], [905, 861], [905, 888], [178, 898]], "difficult": false}, {"transcription": "mot hoi:\"Ly Dinh là nguòi rǎt trong the dièn, mǎc dù khòng có tien nhurng cǒ", "points": [[178, 905], [906, 895], [906, 922], [178, 932]], "difficult": false}, {"transcription": "ay vǎn nghèo mòt cách rǎt ky tính. vi khòng muǒn mǎt mǎt vói dǒng nghiép", "points": [[177, 937], [906, 928], [906, 958], [177, 968]], "difficult": false}, {"transcription": "nèn co ay dā mua mot chiec xe second-hand, ngày nào cūng lau sach tói múrc có", "points": [[177, 972], [905, 962], [905, 989], [177, 999]], "difficult": false}, {"transcription": "the soi guong. Vì muǒn tròng tinh turom mà cò ày sǎn sàng dành thòi gian ǎn", "points": [[178, 1006], [905, 997], [905, 1024], [178, 1032]], "difficult": false}, {"transcription": "sáng dě trang diem, làm sao có the mǎc do ngú nháy lau tr sát duoc co chúr?\"", "points": [[178, 1040], [902, 1030], [902, 1057], [178, 1067]], "difficult": false}, {"transcription": "Canh sát tré ghi lai nhūng lòi Trác Than nói theo chúrc trách nhiem vy cúa", "points": [[206, 1073], [904, 1068], [904, 1096], [206, 1101]], "difficult": false}, {"transcription": "minh, tháy anh òm nguc vói vé rǎt khó chiu cǔng vòi hòi anh bi làm sao. Trác", "points": [[177, 1109], [905, 1102], [905, 1129], [177, 1136]], "difficult": false}, {"transcription": "Than xua tay, láy binh oxy trong ba lo ra hít mòt hoi.", "points": [[178, 1142], [660, 1139], [660, 1166], [178, 1169]], "difficult": false}, {"transcription": "\"Něu là bi giět, vày cò ta có thě mǎc áo ngú ra gǎp ai? Phài chú trong diěu", "points": [[207, 1177], [904, 1174], [904, 1201], [207, 1204]], "difficult": false}, {"transcription": "tra moi quan hé nam nūr cúa cò ta mói dugc, chác chàc, bày giò có rat nhieu có", "points": [[178, 1212], [905, 1207], [905, 1234], [178, 1239]], "difficult": false}, {"transcription": "gái tré..\" Tay già dòi vǎn dang khong ngùrng lài nhài, dòt nhièn bi Trác Thǎn", "points": [[179, 1246], [904, 1241], [904, 1267], [179, 1273]], "difficult": false}, {"transcription": "ngǒi bèn kia bàn túm luòn lǎy cō áo kéo lai gǎn, khiēn mǎy món dǒ chat dǒng", "points": [[180, 1277], [904, 1275], [904, 1302], [180, 1304]], "difficult": false}, {"transcription": "trèn bàn roi hět xuǒng dat, kèu loàng xoàng.", "points": [[181, 1310], [582, 1312], [582, 1336], [181, 1334]], "difficult": false}, {"transcription": "32", "points": [[518, 1361], [555, 1361], [555, 1389], [518, 1389]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page31.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[392, 54], [563, 54], [563, 75], [392, 75]], "difficult": false}, {"transcription": "\"Nay này,làm gì the!\" Vièn canh sát còn lai sg dēn ngày nguòi,vòi chay tói", "points": [[134, 94], [850, 93], [850, 123], [134, 124]], "difficult": false}, {"transcription": "kéo Trác Thǎn ra, dǒn cành sát làp túc hōn loan nhur mó bòng bong.", "points": [[102, 130], [751, 129], [751, 158], [102, 159]], "difficult": false}, {"transcription": "Trác Thǎn lòi òng ta tói truóc mǎt nhu kéo mot vàt nhe hěu, khē cuòi khay,", "points": [[132, 167], [849, 167], [849, 194], [132, 194]], "difficult": false}, {"transcription": "dùng giong dieu binh than nói:\"Me kiep, òng thùr nói thèm cau nüa xem.\"", "points": [[104, 204], [815, 200], [815, 227], [104, 231]], "difficult": false}, {"transcription": "***", "points": [[477, 239], [511, 239], [511, 259], [477, 259]], "difficult": false}, {"transcription": "ò cong ty Bàn do Tieu Diem, Cao Vū Senh và Giám dǒc Nhàn su vùra tiěn", "points": [[132, 277], [852, 274], [852, 305], [132, 308]], "difficult": false}, {"transcription": "cành sát dieu tra ra vě.", "points": [[105, 318], [323, 315], [323, 340], [105, 343]], "difficult": false}, {"transcription": "\"Canh sát sě thòng báo vói bǒ me cùa Ly Dinh, nhàn su cūng phài thòng", "points": [[135, 353], [852, 353], [852, 380], [135, 380]], "difficult": false}, {"transcription": "báo mòt cáu, còn cá bào hiem nhàn vién nūra.\" Cao Vū Sènh vira divira dǎn dò", "points": [[103, 389], [850, 384], [850, 411], [103, 417]], "difficult": false}, {"transcription": "Giám dǒc Nhán sy.", "points": [[105, 422], [295, 426], [295, 453], [105, 449]], "difficult": false}, {"transcription": "\"Vang, tòi sē thòng báo ngay vói bō me Ly Dinh. Phia bào hiem chác phài", "points": [[135, 461], [852, 455], [852, 485], [135, 491]], "difficult": false}, {"transcription": "chò cành sát kět án, khi nào có giǎy chúmg tùr mói có thě yèu cǎu bào hièm", "points": [[106, 497], [850, 493], [850, 520], [106, 524]], "difficult": false}, {"transcription": "duoc.\"Giám dǒc Nhán su báo cáo rō ràng chi tiět, sau khi nhàn durgc sr dong", "points": [[105, 530], [852, 527], [852, 557], [105, 560]], "difficult": false}, {"transcription": "y mói vài vàng ròi khòi dó.", "points": [[105, 569], [369, 565], [369, 592], [105, 596]], "difficult": false}, {"transcription": "Cao Vū Senh quay lai vǎn phòng, ánh mǎt tròi xuyèn qua cira sǒ thùy tinh", "points": [[136, 604], [850, 599], [850, 629], [136, 634]], "difficult": false}, {"transcription": "sát dǎt chiěu xuǒng con chuót dugc gǎp bàng khǎn urót trèn bàn, khiěn nó nhur", "points": [[106, 640], [852, 636], [852, 663], [106, 667]], "difficult": false}, {"transcription": "xù lēn.Hán di tói truóc cùa sō, chóp nhe mát roi ngǎng dau nhin bau tròi trong", "points": [[107, 673], [852, 671], [852, 698], [107, 701]], "difficult": false}, {"transcription": "xanh khòng mot gon máy. Tang muòi tám cao nhu vày, phài dūng cám thěnào", "points": [[106, 708], [851, 702], [851, 732], [106, 737]], "difficult": false}, {"transcription": "mói dám nháy xuōng co chú?", "points": [[107, 742], [394, 740], [394, 767], [107, 769]], "difficult": false}, {"transcription": "\"Tong Giám dǒc Cao, day là tu lièu vě Trác Than, toi da sápxep xong roi a.\"", "points": [[136, 776], [847, 773], [847, 804], [136, 807]], "difficult": false}, {"transcription": "Thu ky Trinh Kinh di vào, dua cho hán mot tò giǎy A4.", "points": [[107, 812], [632, 811], [632, 841], [107, 842]], "difficult": false}, {"transcription": "Cao Vǔ Sénh xoay nguòi, chóp mǎt thèm lan nūa rǒi mói dón lǎy tò giǎy,", "points": [[135, 848], [848, 849], [848, 879], [135, 878]], "difficult": false}, {"transcription": "lóng mày dan cau lai:\"Bǒ anh ay là cành sát hinh sy à, là bǒ ruōt u?\"", "points": [[106, 884], [761, 880], [761, 910], [106, 914]], "difficult": false}, {"transcription": "\"Chàc, cái này thì phài hòi me anh ta.\" Thu ky Trinh trá lòi, tèn này là mòt", "points": [[138, 922], [848, 922], [848, 949], [138, 949]], "difficult": false}, {"transcription": "chang trai mày rám mǎt to,lúc nói ra cau ay còn het surc nghièm túc.", "points": [[109, 959], [753, 959], [753, 982], [109, 982]], "difficult": false}, {"transcription": "\"Hoi me anh ta à?\" Cao Vū Senh gát dau nhu hoi dǎm chièu suy nghī,cuōn", "points": [[136, 992], [850, 993], [850, 1020], [136, 1019]], "difficult": false}, {"transcription": "tò giày lai dàp cái\"bǒp\" vào dau tèn thu ky nhà minh,\"Tòi hòi anh trén hò", "points": [[104, 1027], [850, 1025], [850, 1055], [104, 1057]], "difficult": false}, {"transcription": "khau là con ruot hay con nuoi!\"", "points": [[105, 1063], [411, 1060], [411, 1088], [105, 1091]], "difficult": false}, {"transcription": "\"Hò khau thì tòi khòng biět,nhung nghe hàng xóm nói là con ruòt.\" Thu ky", "points": [[137, 1100], [850, 1100], [850, 1127], [137, 1127]], "difficult": false}, {"transcription": "Trinh òm dau, voi vàng trá lòi,\"Di út cúa tòi có quen vói bà lāo ò dǒi dièn nhà", "points": [[105, 1135], [850, 1133], [850, 1160], [105, 1162]], "difficult": false}, {"transcription": "anh ta, thúr Bày vùra rǒi mói di nghe ngóng xong. Bǒ cúa anh ta tén Trác Kiěn", "points": [[105, 1170], [851, 1169], [851, 1196], [105, 1197]], "difficult": false}, {"transcription": "Quǒc, me làm giáo vièn, mǎy nǎm gǎn dày hàng xóm khòng nhìn thay bà ǎy", "points": [[104, 1203], [851, 1204], [851, 1234], [104, 1233]], "difficult": false}, {"transcription": "dàu. Nguròi chi da mat cùa anh ta tèn là Trác Te Nguyét, còn có mòt nguòi anh", "points": [[104, 1239], [851, 1240], [851, 1266], [104, 1265]], "difficult": false}, {"transcription": "em duoc nhàn nuòi tén Phuong So Duong khong biet ai lón ai bé. Tùr nhò Trác", "points": [[104, 1272], [852, 1273], [852, 1300], [104, 1299]], "difficult": false}, {"transcription": "Than dā sǒng ò khu nhà kia, hàn là con ruòt thòi.\"", "points": [[105, 1306], [589, 1305], [589, 1332], [105, 1333]], "difficult": false}, {"transcription": "33", "points": [[462, 1360], [495, 1360], [495, 1386], [462, 1386]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page32.jpg	[{"transcription": "vesī tam tho1", "points": [[474, 52], [608, 54], [608, 78], [474, 76]], "difficult": false}, {"transcription": "\"Khòng thě nào.\" Cao Vū Senh ngǒi xuǒng ghě, trài phǎng tò giáy A4 ra,", "points": [[207, 93], [898, 99], [898, 129], [207, 122]], "difficult": false}, {"transcription": "mai mot lúc làu khòng nói gì.", "points": [[177, 127], [453, 131], [453, 158], [177, 154]], "difficult": false}, {"transcription": "Trinh Kinh lǎng lē chuǒn ra cira:\"Tong Giám dǒc Cao, neu khòng có viec g", "points": [[205, 162], [897, 167], [897, 197], [205, 192]], "difficult": false}, {"transcription": "thì tòi di truóc nhé?\"", "points": [[177, 198], [374, 198], [374, 225], [177, 225]], "difficult": false}, {"transcription": "\"Trinh Kinh.\" Cao Vū Senh vuot nhe con chuot bàng khǎn tay kia, goi Trinh", "points": [[207, 234], [897, 237], [897, 264], [207, 261]], "difficult": false}, {"transcription": "Kinh dā buróc mot chàn ra ngoài,\"Neu có chuyèn gì dó mà anh khòng the chác", "points": [[177, 270], [897, 268], [897, 296], [177, 298]], "difficult": false}, {"transcription": "chán, nhung lai hi vong nó trò thành sur thàt， vày thì anh sē làm thě nào?\"", "points": [[180, 303], [858, 300], [858, 330], [180, 333]], "difficult": false}, {"transcription": "Thu ky Trinh gāi dau quay lai, bóng dèn trong dau chot bùng sáng, anh ta", "points": [[208, 339], [896, 339], [896, 366], [208, 366]], "difficult": false}, {"transcription": "chay vòi ra quǎy lě tàn rút mōt bòng cúc chàu Phi trong lǎng hoa rǒi dua cho", "points": [[180, 373], [898, 370], [898, 400], [180, 403]], "difficult": false}, {"transcription": "òng chù:\"Anh thir bút cánh hoa xem!\"", "points": [[181, 409], [532, 404], [532, 430], [181, 435]], "difficult": false}, {"transcription": "Cao Vū Sènh chàm rāi ngang dau lèn, làng lǎng nhin thur ky nhà minh.", "points": [[208, 442], [855, 440], [855, 468], [208, 470]], "difficult": false}, {"transcription": "\"Trong phim truyěn hinh toàn diēn nhu vày còn gì vùra bút vùra lam nham", "points": [[209, 480], [897, 477], [897, 504], [209, 507]], "difficult": false}, {"transcription": "That, già,thàt, già, cánh hoa còn lai cuǒi cùng chính là ket quà.\" Thur ky Trinh", "points": [[180, 514], [897, 512], [897, 539], [180, 541]], "difficult": false}, {"transcription": "chàn thành de nghi.", "points": [[182, 548], [362, 548], [362, 572], [182, 572]], "difficult": false}, {"transcription": "\"Cóly.\"Cao Vū Senh gat dau.", "points": [[209, 583], [486, 581], [486, 609], [209, 611]], "difficult": false}, {"transcription": "Thu ky Trinh vui vé cuòi tuoi, thǎm cam thán minh dúng là tri ky cùa òng", "points": [[207, 617], [898, 619], [898, 650], [207, 648]], "difficult": false}, {"transcription": "chù, nhin mà xem, chi khi ò truóc mǎt minh, sěp tōng mói vùa dáng yèu vùra", "points": [[180, 654], [898, 653], [898, 680], [180, 681]], "difficult": false}, {"transcription": "ngay tho nhu mot thanh nien hai muoi ba tuoi the này dày. Anh ta mang theo", "points": [[178, 687], [899, 683], [899, 715], [178, 719]], "difficult": false}, {"transcription": "nu cuòi mim cùa nguòi bǒ già ròi khòi phòng, nhumg vùra cham tay vào cira da", "points": [[177, 722], [899, 718], [899, 745], [177, 749]], "difficult": false}, {"transcription": "nghe thay giong nói àm u cúa òng chù vang lèn phía sau:\"Thu ky Trinh, trù", "points": [[177, 754], [901, 750], [901, 781], [177, 785]], "difficult": false}, {"transcription": "toàn bò tiěn thuròng tháng này cùa anh.\"", "points": [[178, 790], [546, 787], [546, 814], [178, 817]], "difficult": false}, {"transcription": "34", "points": [[519, 1376], [555, 1376], [555, 1403], [519, 1403]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page33.jpg	[{"transcription": "Ohuong6", "points": [[414, 106], [545, 106], [545, 137], [414, 137]], "difficult": false}, {"transcription": "Sao tren troi(6)", "points": [[310, 153], [641, 153], [641, 197], [310, 197]], "difficult": false}, {"transcription": "Thu ky Trinh vùra di, mot thu ky khác ten Hách Hoc lai day cua buóc vào:", "points": [[119, 274], [863, 275], [863, 302], [119, 301]], "difficult": false}, {"transcription": "\"Sēp, theo lich trinh thì bay giò anh can xuǎt phát tói Vien Khoa hoc roi.\"", "points": [[94, 309], [813, 309], [813, 336], [94, 336]], "difficult": false}, {"transcription": "Cao Vū Sènh gàt dau, cǎt con chuòt bàng khǎn tay vào ngǎn kéo,lǎy áo vest", "points": [[118, 345], [864, 346], [864, 373], [118, 372]], "difficult": false}, {"transcription": "treo trèn giá áo vát lèn khuyu tay. Thu ky Hách sira soan lai tài liéu da ky tren", "points": [[90, 380], [861, 380], [861, 407], [90, 407]], "difficult": false}, {"transcription": "bàn ròi cho vào kep tài lieu, sau dó di theo hán ra khòi vǎn phòngGiám dǒe bo", "points": [[89, 414], [862, 414], [862, 440], [89, 440]], "difficult": false}, {"transcription": "phànNghièn cúru và Phát trien phai di cùng da dqi sǎn ò bén ngoài.", "points": [[89, 448], [759, 447], [759, 474], [89, 475]], "difficult": false}, {"transcription": "Sau khi òng chù cùng nguòi cúa bò phàn Nghièn ciru và Phát trien di rǒi，", "points": [[119, 484], [862, 484], [862, 511], [119, 511]], "difficult": false}, {"transcription": "Thu ky Hách làp túrc phát tài lièu khàn da dugc ky xong cho các phòng ban.", "points": [[89, 516], [862, 518], [862, 545], [89, 543]], "difficult": false}, {"transcription": "Trinh Kinh dang kě kho vói Giám dǒc Nhàn su, quay sang hòi anh ta vói vè", "points": [[90, 551], [863, 551], [863, 578], [90, 578]], "difficult": false}, {"transcription": "sau nao:\"Hách Hoc này, cùng là thur ky mà sao anh chua bao giò bi trùr tièn", "points": [[90, 584], [861, 584], [861, 611], [90, 611]], "difficult": false}, {"transcription": "thuòng the?\"", "points": [[88, 619], [224, 614], [225, 645], [89, 650]], "difficult": false}, {"transcription": "Thur ky Hách dua mòt bàn tài lieu cho Giám dǒe Nhàn su, dùng mot ngón", "points": [[118, 653], [862, 654], [862, 684], [118, 683]], "difficult": false}, {"transcription": "tay day nhe chiec kính khòng gong cúa minh:\"Toi da tùng hòi Siri cùa sěp van", "points": [[89, 690], [861, 687], [861, 713], [89, 716]], "difficult": false}, {"transcription": "dě này ròi,nó nói něu sǒ tiěn dó duoc trà thì goi là tièn thuròng, còn něu bi trùr", "points": [[88, 720], [862, 719], [862, 749], [88, 750]], "difficult": false}, {"transcription": "thì goi là thuē thòng minh.\"", "points": [[89, 756], [368, 755], [368, 782], [89, 783]], "difficult": false}, {"transcription": "\"\"Trinh Kinh há hǒc mieng do ra mat mot lúc mói quay dau hòi Giám dǒc", "points": [[117, 788], [862, 789], [862, 819], [117, 818]], "difficult": false}, {"transcription": "Nhán su,\"Ban siri thiet kě dǎc bièt cùa òng chù khòng cho nguròi ngoài dùng", "points": [[86, 822], [862, 825], [862, 858], [86, 855]], "difficult": false}, {"transcription": "dúngkhòng?\"", "points": [[87, 860], [235, 858], [235, 889], [87, 891]], "difficult": false}, {"transcription": "Chi Giám doc Nhàn sur vō vai anh ta day vè cam thòng:\"ò thì.. trróc giò", "points": [[119, 895], [861, 895], [861, 925], [119, 925]], "difficult": false}, {"transcription": "thu ky Hách ǎn nói turong dǒi khéo léo mà.\"", "points": [[88, 931], [529, 928], [529, 956], [88, 959]], "difficult": false}, {"transcription": "\"n", "points": [[117, 968], [162, 968], [162, 986], [117, 986]], "difficult": false}, {"transcription": ".", "points": [[131, 982], [150, 982], [150, 993], [131, 993]], "difficult": false}, {"transcription": "Vùra buóc vào thang máy,nhóm Cao Vū Senh gǎp ngay Húra Kieu cúa phòng", "points": [[118, 1039], [863, 1039], [863, 1069], [118, 1069]], "difficult": false}, {"transcription": "Thi truòng da khóc dò cà mát. Húra Kieu là mot co gái rat xinh xǎn và hoat bát,", "points": [[88, 1074], [861, 1069], [861, 1099], [88, 1104]], "difficult": false}, {"transcription": "dang khóc nác cà lèn, nhìn thay ho thì voi vàng chào hòi:\"Tong Giám dǒe Cao,", "points": [[87, 1106], [862, 1102], [862, 1136], [87, 1140]], "difficult": false}, {"transcription": "tòi muǒn xin nghi mot ngày dě di thǎm Dinh Dinh.\"", "points": [[87, 1143], [609, 1138], [609, 1168], [87, 1173]], "difficult": false}, {"transcription": "Co gái này hoc dai hoc ò Bào Dào, nói chuyen dǎc set giong Dai Loan pha", "points": [[118, 1181], [861, 1177], [861, 1205], [118, 1209]], "difficult": false}, {"transcription": "Bác Kinh, binh thuòng moi nguòi děu thích trèu co ay, nhung hòm nay chang", "points": [[89, 1214], [860, 1212], [860, 1239], [89, 1241]], "difficult": false}, {"transcription": "ai có tám trang dó nūa, tǎt cá děu lǎng ngǎt.", "points": [[89, 1248], [526, 1245], [526, 1272], [89, 1276]], "difficult": false}, {"transcription": "Něu Trác Thǎn nhin thay cành sinh vát nhó bé dáng yèu khóc thút thit thě", "points": [[118, 1283], [861, 1277], [861, 1305], [118, 1311]], "difficult": false}, {"transcription": "này, chác chán sē khòng nhin dugc mà rút khǎn giǎy ra dǒ dành. Còn vói nguòi", "points": [[90, 1316], [859, 1310], [859, 1340], [90, 1346]], "difficult": false}, {"transcription": "35", "points": [[462, 1371], [490, 1371], [490, 1393], [462, 1393]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page34.jpg	[{"transcription": "ve aī tam thǎi", "points": [[470, 68], [605, 68], [605, 92], [470, 92]], "difficult": false}, {"transcription": "khòng bièt thuong hoa tiěc ngoc nhu Cao Vū Senh, hán chi khē gàt dau, cho", "points": [[167, 111], [913, 106], [913, 136], [167, 142]], "difficult": false}, {"transcription": "phép cò ǎy nghi làm.", "points": [[170, 147], [366, 143], [366, 171], [170, 175]], "difficult": false}, {"transcription": "*", "points": [[521, 179], [549, 179], [549, 195], [521, 195]], "difficult": false}, {"transcription": "Durói su can ngǎn cia cáe cánh sát khác trong don, Trác Than khòng the", "points": [[196, 214], [913, 209], [913, 239], [196, 244]], "difficult": false}, {"transcription": "dánh cho tay già dòi kia vǎng rǎng day dàt, nhurng nhǔng cánh sát khác cǔng", "points": [[168, 247], [912, 243], [912, 273], [168, 277]], "difficult": false}, {"transcription": "khòng có y truy cinu anh tòi \"tǎn cong canh sát\". Vièn cánh sát tré láy lòi khai", "points": [[167, 280], [913, 276], [913, 306], [167, 310]], "difficult": false}, {"transcription": "còn lén gio ngón cái lēn vói anh. Ngày nào mà cành sát khu vuc chǎng bán vát", "points": [[167, 314], [912, 309], [912, 339], [167, 344]], "difficult": false}, {"transcription": "chàn lèn cǒ,xem ra nhūng dǒng chí ò dày cǔng khòng ua vi\"lāo gia\" này tù", "points": [[168, 347], [913, 343], [913, 373], [168, 377]], "difficult": false}, {"transcription": "làu lám roi.", "points": [[169, 382], [280, 382], [280, 407], [169, 407]], "difficult": false}, {"transcription": "Làng nhàng nùra ngày tròi, dēn khi anh di ra khói dòn cánh sát thì vùra khéo", "points": [[197, 416], [913, 411], [913, 441], [197, 445]], "difficult": false}, {"transcription": "gǎp Hura Kièu tói dày hòi thǎm tinh hinh.", "points": [[170, 453], [558, 446], [558, 473], [170, 479]], "difficult": false}, {"transcription": "\"Anh chính là nguòi vè sī kia dúng khòng?\"", "points": [[200, 485], [607, 483], [607, 511], [200, 513]], "difficult": false}, {"transcription": "Co gái này thap hon Trác Thǎn mot cái dǎu, lai dúng quá gǎn khien tam mát", "points": [[199, 521], [912, 516], [912, 546], [199, 551]], "difficult": false}, {"transcription": "cùa anh luót thàng qua dinh dàu co ǎy, suyt nūra khòng nhin tháy nguròi dàu", "points": [[172, 555], [910, 551], [910, 578], [172, 582]], "difficult": false}, {"transcription": "ca. Anh cúi xuǒng dáp mòt tiěng:\"Ha, có là..?\"", "points": [[171, 589], [618, 584], [618, 611], [171, 616]], "difficult": false}, {"transcription": "\"Toi la Húra Kieu, dong nghiep kiem ban thàn cúa Dinh Dinh. Lúc truróc toi", "points": [[202, 623], [911, 620], [911, 647], [202, 650]], "difficult": false}, {"transcription": "tùng nhìn thǎy anh dēn dón cò ay tan làm.\" Thòi tiět nóng búc, cò gái chay", "points": [[172, 654], [912, 653], [912, 684], [172, 685]], "difficult": false}, {"transcription": "thàng tói dày, mǒ hòi và nuróc mát da làm nhòe cà lóp trang diēm. Biet tin thi", "points": [[173, 689], [912, 685], [912, 711], [173, 715]], "difficult": false}, {"transcription": "the duoc dua di khám nghiem roi， phòng ò cūng bi nièm phong nèn tam thài", "points": [[173, 723], [910, 720], [910, 743], [173, 746]], "difficult": false}, {"transcription": "khòng vào duoc, khòng có thòng tin gì vě vu án, cò gái lai bat chot òa khóc.", "points": [[170, 755], [883, 751], [883, 777], [170, 781]], "difficult": false}, {"transcription": "Nhin cò ay khóc, Trác Than chǎng biet phài làm the nào, dành dān cò ay", "points": [[198, 787], [910, 786], [910, 816], [198, 817]], "difficult": false}, {"transcription": "sang quán trà sūra bèn duòng uǒng mot cǒc.", "points": [[169, 824], [577, 821], [577, 848], [169, 851]], "difficult": false}, {"transcription": "\"Chác chán Dinh Dinh sē khòng tu sát dau, nhat dinh là do tèn khǒn Vurong", "points": [[197, 854], [913, 856], [913, 887], [197, 885]], "difficult": false}, {"transcription": "Cánh Hàng kia làm.\"Húra Kieu hút manh mot hoi trà sūra.", "points": [[170, 894], [709, 891], [709, 915], [170, 918]], "difficult": false}, {"transcription": "Trác Thǎn bóc náp cǒc nuróc chanh ra, cǎm cà cǒc lèn chàm rāi nhàm nháp", "points": [[197, 928], [909, 926], [909, 952], [197, 954]], "difficult": false}, {"transcription": "láng nghe cò gái no cǎm phǎn kě lai chuyèn cua Ly Dinh bàng chat giong Dài", "points": [[168, 962], [911, 959], [911, 985], [168, 989]], "difficult": false}, {"transcription": "Loan pha Bác Kinh cúa minh.", "points": [[168, 995], [445, 994], [445, 1019], [168, 1020]], "difficult": false}, {"transcription": "Ly Dinh và Vuong Cánh Hàng quen nhau khi di thuè phòng, nhà ga chính", "points": [[194, 1030], [911, 1028], [911, 1055], [194, 1057]], "difficult": false}, {"transcription": "là ho di dòi cúa khu Thái Trang. Truóc dày Thái Trang là mot thòn nQi do rat", "points": [[166, 1063], [912, 1063], [912, 1090], [166, 1090]], "difficult": false}, {"transcription": "lón, mǒi nhà mǒi hò děu xày ít nhǎt ba tǎng, ai ai cūng duoc dèn bù thành phú", "points": [[169, 1098], [911, 1098], [911, 1122], [169, 1122]], "difficult": false}, {"transcription": "ong het. Lúc ay,Ly Dinh là nghièn curu sinh vira tot nghiep chura duroc bao lau", "points": [[167, 1131], [912, 1129], [912, 1156], [167, 1158]], "difficult": false}, {"transcription": "ngay tho chua trái su dòi, bi lòi ngon tieng ngot cua Vuong Cánh Hang lira gat", "points": [[167, 1165], [911, 1164], [911, 1191], [167, 1192]], "difficult": false}, {"transcription": "nèn mói yèu hán mōt thòi gian, cuoi cùng lai phát hien hoc thúrc và quan diem", "points": [[168, 1198], [910, 1196], [910, 1223], [168, 1225]], "difficult": false}, {"transcription": "sǒng quá cách biet. Ly Dinh muǒn chia tay, nhung Vuong Cánh Hàngkhong", "points": [[168, 1231], [911, 1230], [911, 1257], [168, 1258]], "difficult": false}, {"transcription": "chiu, ban dau còn doa nhay lǎu cát cō tay, vě sau cú bám nhàng nhǎng láy cǒ", "points": [[169, 1263], [911, 1260], [911, 1287], [169, 1289]], "difficult": false}, {"transcription": "ǎy,thám chí còn theo dōi nūa.", "points": [[171, 1298], [450, 1298], [450, 1322], [171, 1322]], "difficult": false}, {"transcription": "36", "points": [[518, 1362], [551, 1362], [551, 1388], [518, 1388]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page35.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[391, 56], [564, 56], [564, 77], [391, 77]], "difficult": false}, {"transcription": "\"Anh ta tùrng nói, něu Dinh Dinh khòng chiu ò bèn thì anh ta sě hùy hoai có", "points": [[127, 95], [860, 99], [860, 126], [127, 122]], "difficult": false}, {"transcription": "ay.\" Húa Kiěu cán bep cà Ong hút, khòng nhin durgc lai bát dau trào nuóc mát.", "points": [[95, 130], [859, 130], [859, 159], [95, 159]], "difficult": false}, {"transcription": "Trác Than dua khǎn giay ben canh cho co: \"Có nghia Vuong Cánh Hang là", "points": [[125, 165], [860, 168], [860, 195], [125, 192]], "difficult": false}, {"transcription": "nguòi cia Thái Trang, vày thì anh ta deu quen biet mqi nguòi trong Thái Trang", "points": [[95, 199], [861, 201], [861, 232], [95, 230]], "difficult": false}, {"transcription": "Tan Thành dúng khòng?\"", "points": [[94, 235], [354, 233], [354, 263], [94, 265]], "difficult": false}, {"transcription": "\"Chác chán có quen vói chú nhà vì dù sao cǔng là nguòi cùng thòn. Nguòi", "points": [[125, 269], [861, 272], [861, 302], [125, 299]], "difficult": false}, {"transcription": "thuè tro thì chua chǎc.\" Co dā nói dieu này vói cành sát khi ho tói còng ty dieu", "points": [[95, 305], [859, 305], [859, 335], [95, 335]], "difficult": false}, {"transcription": "tra, hi vong có the bát duqc tén cǎn ba dó.", "points": [[96, 343], [509, 342], [509, 369], [96, 370]], "difficult": false}, {"transcription": "Hai nguòi luu sǒ dièn thoai cùa nhau, nói chính xác hon là Húra Kieu chù", "points": [[127, 380], [860, 380], [860, 407], [127, 407]], "difficult": false}, {"transcription": "dong yèu cǎu Trác Than dě lai so dien thoai cua minh cho cò ay.", "points": [[97, 416], [719, 416], [719, 442], [97, 442]], "difficult": false}, {"transcription": "\"Toi biet chuyèn này thc su khòng lièn quan gi tói anh.. Chang qua tòi that", "points": [[128, 450], [862, 451], [862, 481], [128, 480]], "difficult": false}, {"transcription": "su rat hoang mang, anh lai là anh hùng tùrng dánh Vurong Cánh Hàng, nèn có", "points": [[96, 486], [861, 485], [861, 515], [96, 516]], "difficult": false}, {"transcription": "sō dièn thoai cúa anh, tòi cǔng cám thǎy yèn tàm hon.\"", "points": [[98, 524], [631, 524], [631, 548], [98, 548]], "difficult": false}, {"transcription": "\"Trách nhiem thoi mà.\"", "points": [[128, 559], [364, 557], [364, 584], [128, 586]], "difficult": false}, {"transcription": "Anh hùng u?", "points": [[128, 597], [262, 597], [262, 625], [128, 625]], "difficult": false}, {"transcription": "Trác Than lác dau, quǎng ba lo lèn vai, hít sau mòt hoi. Hoi nóng cuǒn theo", "points": [[128, 636], [860, 636], [860, 660], [128, 660]], "difficult": false}, {"transcription": "khói xe ò to àp vào mǎt, hurong vi dǎc bièt cùa mùa hè khiěn anh ho sǎc sua", "points": [[99, 670], [860, 670], [860, 694], [99, 694]], "difficult": false}, {"transcription": "mǎy tieng. Hoi anh còn là thieu nièn, cūng vào mòt mùa hè oi birc nhu the này,", "points": [[97, 705], [859, 702], [859, 729], [97, 731]], "difficult": false}, {"transcription": "Trác Kien Quǒc tùrng quǎn bǎng vài cán rǎng nhěch mièng nói vói anh: \"Làm", "points": [[97, 738], [860, 736], [860, 763], [97, 765]], "difficult": false}, {"transcription": "gì có anh hùng chú, chi có bàn nǎng làm nguòi thòi.\"", "points": [[97, 774], [616, 771], [616, 799], [97, 802]], "difficult": false}, {"transcription": "Buoi toi khi truòng mam non tan hoc, Trác Than cǒng cháu trai děn don", "points": [[127, 811], [860, 809], [860, 833], [127, 835]], "difficult": false}, {"transcription": "cành sát hòi thǎm tiěn triēn cùa vu án. Vì děn lièn tuc ba ngày nèn anh cǔng", "points": [[96, 843], [863, 844], [863, 874], [96, 873]], "difficult": false}, {"transcription": "làm than durgc vói dǒng chí cánh sát trè tuoi kia. Vién cánh sát trè rǎt phien", "points": [[95, 880], [861, 878], [861, 905], [95, 907]], "difficult": false}, {"transcription": "nāo, nguòi vè sī khòng có chúng chi hành nghě, khòng thàn cǔng chàng quen", "points": [[96, 916], [861, 913], [861, 940], [96, 943]], "difficult": false}, {"transcription": "vói nan nhàn này chi duoc thuè tam vài ngày, něu khòng phai vi Trác Than có", "points": [[97, 950], [861, 947], [861, 973], [97, 977]], "difficult": false}, {"transcription": "day dù chúng có ngoai pham thì càu ta còn suyt nghi ngò anh là hung thú děn", "points": [[96, 984], [861, 980], [861, 1009], [96, 1012]], "difficult": false}, {"transcription": "thǎm dò tinh hình ǎy chúr.", "points": [[97, 1020], [352, 1020], [352, 1044], [97, 1044]], "difficult": false}, {"transcription": "\"Toi vǎn dang trong thòi gian durgc thuè mà.\" Trác Than trà lòi nhu vày,", "points": [[125, 1053], [860, 1055], [860, 1085], [125, 1083]], "difficult": false}, {"transcription": "\"Khách hàng chět trong thòi gian làm viec là sur si nhuc dǒi vói sur nghiep cua", "points": [[96, 1090], [862, 1090], [862, 1120], [96, 1120]], "difficult": false}, {"transcription": "tói, khòng bào vè dugc nguròi thì phài bào ve còng ly.\" Lòi nói cùa anh rat dūng", "points": [[96, 1126], [861, 1125], [861, 1153], [96, 1154]], "difficult": false}, {"transcription": "mānh can truòng, dǒng dac hùng hǒn, chi thiěu diěu phǒi thèm nhac cách", "points": [[95, 1160], [861, 1157], [861, 1188], [95, 1191]], "difficult": false}, {"transcription": "mang làm něn nura thòi.", "points": [[97, 1200], [333, 1197], [333, 1222], [97, 1225]], "difficult": false}, {"transcription": "Nghe vày, vièn cành sát tré càm thay rǎt kính nē, cuc ky khàm phuc tinh thǎn", "points": [[125, 1235], [860, 1230], [860, 1256], [125, 1262]], "difficult": false}, {"transcription": "chuyèn nghièp cúa anh, nèn mói lén lút tiet lò cho anh mot chút thòng tin:\"Giám", "points": [[96, 1267], [860, 1262], [860, 1292], [96, 1296]], "difficult": false}, {"transcription": "dinh pháp y cho thày diēm roi có sai lech so vói roi tr do, kět luàn so bò là bi", "points": [[96, 1301], [860, 1296], [860, 1326], [96, 1331]], "difficult": false}, {"transcription": "37", "points": [[461, 1362], [498, 1362], [498, 1391], [461, 1391]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page36.jpg	[{"transcription": "ve sī tam thòn", "points": [[469, 54], [604, 50], [605, 74], [470, 79]], "difficult": false}, {"transcription": "nguòi ta ném xuǒng. Nhung vì khòng có manh mǒi gì vě hung thú nèn chúng tòi", "points": [[160, 98], [905, 94], [905, 125], [160, 129]], "difficult": false}, {"transcription": "báo cáo lèn Cuc Canh sát Thành phǒ, Cuc cǔng dā phái nguòi tói hǒ trg dieu tra.\"", "points": [[160, 133], [903, 127], [903, 154], [160, 159]], "difficult": false}, {"transcription": "Cuc Canh sát thành phǒ phái nguòi tói dièu tra thì chác chán là doi cánh sát", "points": [[190, 167], [905, 163], [905, 193], [190, 197]], "difficult": false}, {"transcription": "hinh s cua Phurong So Durong roi. Trác Than vǒ vai cau canh sát tré:\"Cam on", "points": [[159, 201], [905, 196], [905, 227], [159, 232]], "difficult": false}, {"transcription": "nguòi anh em, nhumg vè sau dùng tiét lò nhūng thòng tin nhur thé này nhé, l", "points": [[160, 237], [904, 229], [904, 260], [160, 268]], "difficult": false}, {"transcription": "tòi chính là hung thù thì sao?\"", "points": [[162, 273], [451, 268], [451, 295], [162, 300]], "difficult": false}, {"transcription": "Anh ghé sát vào tai càu ta nói càu cuǒi cùng càu cánh sát tré trgn tròn mát", "points": [[191, 306], [904, 301], [904, 332], [191, 337]], "difficult": false}, {"transcription": "ngày ra tai tràn, hèt nhu chú mèo con bi lāo chǒn già doa cho sg hět hǒn, xù", "points": [[160, 340], [906, 334], [906, 368], [160, 374]], "difficult": false}, {"transcription": "het cà lòng lèn.", "points": [[162, 377], [311, 375], [311, 402], [162, 405]], "difficult": false}, {"transcription": "Cau cành sát tré này mói nhàm chúrc chua durgc bao làu, hon nūra binh", "points": [[192, 410], [905, 405], [905, 436], [192, 440]], "difficult": false}, {"transcription": "thuòng chi giài quyět may chuyèn tranh chǎp nhò nhǎt cùa nguòi dàn, nén", "points": [[165, 444], [905, 440], [905, 471], [165, 475]], "difficult": false}, {"transcription": "Trác Thǎn mói có co hoi gài cho càu ta nói ra. Chú neu là nguòi cúa Phurong So", "points": [[166, 478], [904, 476], [904, 504], [166, 506]], "difficult": false}, {"transcription": "Duong lō mieng dē lò thì chác chán sē bi doi phó Phurong tan cho mot tràn ròi", "points": [[167, 513], [904, 509], [904, 536], [167, 540]], "difficult": false}, {"transcription": "duoi ra khòi doi cành sát hinh sy ngay làp túrc.", "points": [[170, 548], [598, 548], [598, 572], [170, 572]], "difficult": false}, {"transcription": "***", "points": [[511, 579], [547, 579], [547, 602], [511, 602]], "difficult": false}, {"transcription": "Tai doi canh sát hinh sur cua Cuc Canh sát thành pho, Phurong So Durong", "points": [[193, 617], [903, 618], [903, 648], [193, 647]], "difficult": false}, {"transcription": "dang xem anh chup hien truòng.", "points": [[168, 652], [473, 655], [473, 683], [168, 679]], "difficult": false}, {"transcription": "\"Dòi phó, chuyèn này bèn don khu vuc còn chura xir ly xong, chúng ta nhàn", "points": [[196, 689], [901, 689], [901, 715], [196, 715]], "difficult": false}, {"transcription": "sóm nhu váy lièu có ōn khòng a?\" Tran Chieu Huy, thành vièn cua dòi cành sát", "points": [[165, 724], [902, 720], [902, 746], [165, 750]], "difficult": false}, {"transcription": "hinh su dang ngǒi xōm duói dat spxp do dac, dè dt bau lay bàn hòi Phuong", "points": [[165, 755], [902, 755], [902, 785], [165, 785]], "difficult": false}, {"transcription": "So Duong. Cau ta hoi den, bat thinh linh ló ra tùr duói gǎm bàn làm nguròi ta", "points": [[164, 789], [904, 786], [904, 817], [164, 820]], "difficult": false}, {"transcription": "giàt thót cà tim.", "points": [[164, 827], [311, 822], [312, 850], [165, 855]], "difficult": false}, {"transcription": "\"Anh khong càm thǎy vu này giǒng vói vu ò thành Nam à?\" Mòt thành vièn", "points": [[193, 862], [903, 859], [903, 886], [193, 889]], "difficult": false}, {"transcription": "khác quay dàu lai nói.", "points": [[165, 897], [371, 894], [371, 922], [165, 925]], "difficult": false}, {"transcription": "\"Vyò thành Nam á?\" Tran Chiěu Huy ngǒi thàng nguòi dày,voi vā luc tài", "points": [[191, 931], [902, 928], [902, 958], [191, 961]], "difficult": false}, {"transcription": "liéu cúa vu án thành Nam. Máy ngày truóc có mòt nguòi dàn òng trung nièn", "points": [[166, 967], [902, 964], [902, 990], [166, 993]], "difficult": false}, {"transcription": "chět ò thành Nam,núra dém nguròi này nháy tùr trèn cǎu vuot xuǒng, ngā gāy", "points": [[166, 1000], [900, 998], [900, 1025], [166, 1027]], "difficult": false}, {"transcription": "co chet ngay tai cho. Vg cùa òng ta nói òng ta tr sát vì dang ng rat nhieu tiěn", "points": [[166, 1033], [901, 1029], [901, 1059], [166, 1063]], "difficult": false}, {"transcription": "khong the trà nǒi, nhung bǒ me òng ta lai chác chán ràng con trai minh bi nguròi", "points": [[166, 1068], [901, 1066], [901, 1093], [166, 1095]], "difficult": false}, {"transcription": "ta sát hai.", "points": [[165, 1101], [257, 1101], [257, 1129], [165, 1129]], "difficult": false}, {"transcription": "Doan duòng giao nhau ǎy dang thi cong, còn chura dugc chính thúc dura vào", "points": [[191, 1136], [901, 1136], [901, 1166], [191, 1166]], "difficult": false}, {"transcription": "sùr dung, xung quanh cǔng khòng có camera. Nhurng buǒi sáng hòm ay có rát", "points": [[165, 1170], [901, 1168], [901, 1198], [165, 1200]], "difficult": false}, {"transcription": "nhiěu nguòi di làm nhìn tháy,còn dǎng lèn mang xā hoi khien du luàn xòn xao,", "points": [[168, 1204], [899, 1204], [899, 1231], [168, 1231]], "difficult": false}, {"transcription": "do dó vy án này mói dugc chuyen sang cho Cue Canh sát thành pho dieu tra.", "points": [[168, 1236], [897, 1238], [897, 1266], [168, 1263]], "difficult": false}, {"transcription": "Děu là roi tùr trèn cao xuǒng, khòng có nhàn chúng, khòng có di thur, khòng", "points": [[191, 1269], [902, 1271], [902, 1305], [191, 1303]], "difficult": false}, {"transcription": "có dǎu hièu nào báo truóc, còn hen gǎp nguòi khác vào ngày hòm sau.", "points": [[168, 1302], [822, 1311], [822, 1341], [168, 1332]], "difficult": false}, {"transcription": "38", "points": [[510, 1370], [544, 1370], [544, 1394], [510, 1394]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page37.jpg	[{"transcription": "Luc DaThienHac", "points": [[390, 57], [568, 54], [568, 78], [390, 81]], "difficult": false}, {"transcription": "\"Ban trai cū có bàng chúng ngoai pham, trèn tay nám cura chi có dau ván", "points": [[133, 101], [860, 98], [860, 125], [133, 128]], "difficult": false}, {"transcription": "tay cùa cò gái kia, hành lang khòng có dáu vét giàng co.\" Dqi truòng Pham", "points": [[98, 134], [861, 129], [861, 156], [98, 160]], "difficult": false}, {"transcription": "cúa doi canh sát hinh syr mèt mòi buóc vào, vùra di vùra lau mǒ hoi:\"Còn dáu", "points": [[98, 165], [860, 160], [860, 186], [98, 191]], "difficult": false}, {"transcription": "chàn thì sao?\"", "points": [[99, 196], [241, 194], [241, 221], [99, 223]], "difficult": false}, {"transcription": "Truóc day doi truong Pham là trg thù cúa bǒ Trác Than, lón hon dám", "points": [[127, 230], [861, 227], [861, 254], [127, 257]], "difficult": false}, {"transcription": "Phuong SoDuong rát nhieu, tuoi dā trung nien nèn the luc có phan khong", "points": [[98, 262], [862, 262], [862, 289], [98, 289]], "difficult": false}, {"transcription": "theo kip lóp tre.", "points": [[96, 296], [257, 294], [257, 322], [96, 324]], "difficult": false}, {"transcription": "\"Quàn ly sinh hoat cùa chung cu này rǎt té, thuròng xuyen khòng có nguòi", "points": [[128, 329], [862, 326], [862, 356], [128, 359]], "difficult": false}, {"transcription": "quét don, tùr thang máy tói cùra nhà Ly Dinh phù day dau chàn cúa già tré lón", "points": [[96, 364], [861, 360], [861, 388], [96, 392]], "difficult": false}, {"transcription": "bé.\" Phurong So Duong tim anh chup dau chan dua ra cho doi truòng xem.", "points": [[94, 396], [861, 394], [861, 420], [94, 423]], "difficult": false}, {"transcription": "Hành lang ban thiu, rác ruòi linh tinh chat dǒng, chai chai lo lo do bác gái nhà", "points": [[93, 427], [863, 423], [863, 454], [93, 457]], "difficult": false}, {"transcription": "ò giüra nhǎt vě, tā lót tré em mà dòi vg chǒng ben canh vúrt ra.", "points": [[93, 461], [702, 458], [702, 486], [93, 489]], "difficult": false}, {"transcription": "\"Da kiem tra cira so tang trèn tang duói chura? Có khi nào là roi tùr tàng khác", "points": [[128, 496], [863, 493], [863, 520], [128, 523]], "difficult": false}, {"transcription": "xuōng khòng?\" Doi trròng Pham cam lay tam ành xem xét ky luōng\"Ban trai", "points": [[93, 528], [862, 526], [862, 556], [93, 558]], "difficult": false}, {"transcription": "cù là nguòi ò dàu?\"", "points": [[94, 563], [295, 559], [295, 587], [94, 591]], "difficult": false}, {"transcription": "\"Cháu da xem các tang khác rǒi, deu khòng có dau vět giàng co. Ban trai cǔ", "points": [[126, 595], [861, 596], [861, 623], [126, 622]], "difficult": false}, {"transcription": "tèn Vurong Cánh Hàng, là nguòi ò Thái Trang, cǔng có nhà ò Thái Trang Tan", "points": [[93, 628], [862, 627], [862, 657], [93, 658]], "difficult": false}, {"transcription": "Thành. Hòm xay ra vu án, anh ta dang nàm vièn, y tá truc ban và bènh nhàn", "points": [[96, 663], [860, 663], [860, 687], [96, 687]], "difficult": false}, {"transcription": "cùng phòng có the làm chúng cho anh ta.\" Phurong So Duong rút hǒ so cúa", "points": [[95, 694], [862, 690], [862, 721], [95, 724]], "difficult": false}, {"transcription": "Vuong Cánh Hàng ra dua cho doi truóng.", "points": [[95, 726], [514, 726], [514, 756], [95, 756]], "difficult": false}, {"transcription": "\"Benh vien? Làm sao mà càu ta phai nàm vièn?\"", "points": [[126, 761], [603, 759], [603, 789], [126, 791]], "difficult": false}, {"transcription": "\"Anh ta...bám duòi Ly Dinh, cho nèn bi ban cúa cò ay dánh cho gāy xuong", "points": [[125, 795], [863, 798], [863, 828], [125, 825]], "difficult": false}, {"transcription": "cut.\" Phuong So Duronglò vé mǎt nghien rǎng nghien loi, giau di cái tèn cùa", "points": [[94, 832], [861, 830], [861, 857], [94, 859]], "difficult": false}, {"transcription": "anh Trác ra tay dánh nguòi.", "points": [[94, 865], [373, 862], [373, 889], [94, 892]], "difficult": false}, {"transcription": "\"O.\" Doi truóng Pham thoáng ngac nhien.", "points": [[125, 897], [543, 898], [543, 925], [125, 924]], "difficult": false}, {"transcription": "\"Nói nhur vày thì dúng là hai vy án này rǎt giǒng nhau.\" Càu bé thàt thà", "points": [[126, 933], [861, 933], [861, 960], [126, 960]], "difficult": false}, {"transcription": "Trǎn Chieu Huy viet tat cá nhūng diem turong tur ra giay,\"Bay giò chi còn thieu", "points": [[93, 967], [861, 966], [861, 992], [93, 993]], "difficult": false}, {"transcription": "mot nguòi thàn cua nan nhàn tuyèn bǒ ràng dó là tr sát nūa thòi.\"", "points": [[94, 1001], [745, 996], [745, 1023], [94, 1028]], "difficult": false}, {"transcription": "\"Doi truròng!\" Dòi vien phu trách dieu tra tùr bèn ngoài chay vào, vùra nói", "points": [[124, 1033], [863, 1032], [863, 1062], [124, 1063]], "difficult": false}, {"transcription": "vùra thò hǒnghòc,\"Bo.. bo me cùa Ly Dinh nói.. co ay tr sát.\"", "points": [[96, 1070], [724, 1065], [724, 1092], [96, 1097]], "difficult": false}, {"transcription": "\"…\"", "points": [[123, 1103], [169, 1105], [168, 1130], [122, 1128]], "difficult": false}, {"transcription": "塔", "points": [[466, 1139], [495, 1139], [495, 1155], [466, 1155]], "difficult": false}, {"transcription": "\"Bé cieu và bé gǎu nháy múa, nháy nào nháy nào mōt hai mōt, chúng nháy mia", "points": [[128, 1175], [861, 1175], [861, 1202], [128, 1202]], "difficult": false}, {"transcription": "quanh vòng quanh, nháy nào nhay nào mōt hai mot..\"Tiěng nhac vui vè nhe nhàng", "points": [[92, 1206], [862, 1205], [862, 1236], [92, 1237]], "difficult": false}, {"transcription": "vang lèn, co giáo cúa truòng mǎm non mǎc bò do thě thao màu hǒng, huróng", "points": [[97, 1241], [861, 1241], [861, 1267], [97, 1267]], "difficult": false}, {"transcription": "dǎn mǎy dúa bé tàp the duc giüra giò. Bon tré tay chàn ngán tūn khua chàn múa", "points": [[97, 1271], [862, 1271], [862, 1301], [97, 1301]], "difficult": false}, {"transcription": "tay theo có giáo,dòng tác sai bét, da xieu veo lai còn dánh nhau.", "points": [[94, 1306], [725, 1305], [725, 1332], [94, 1333]], "difficult": false}, {"transcription": "39", "points": [[462, 1362], [495, 1362], [495, 1388], [462, 1388]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page38.jpg	[{"transcription": "ve sī tam thān", "points": [[467, 59], [601, 59], [601, 83], [467, 83]], "difficult": false}, {"transcription": "Trác Than deo chiec tap de màu xanh pastel, khoanh tay dúng dra vào", "points": [[192, 100], [911, 99], [911, 129], [192, 130]], "difficult": false}, {"transcription": "turòng nhin nhüng dúra trè nghièng ngà lác lur.", "points": [[164, 136], [597, 133], [597, 160], [164, 162]], "difficult": false}, {"transcription": "\"Oi chao, dám thanh nièn bày giò dúng là chǎng biet tiěc mang sǒng gì ca.\"", "points": [[192, 167], [910, 164], [910, 195], [192, 198]], "difficult": false}, {"transcription": "Co lao còng ngòi bèn canh xem dien thoai, vùra xem vùra nói vói co náu běp", "points": [[163, 202], [909, 198], [909, 228], [163, 232]], "difficult": false}, {"transcription": "dang nhat rau.", "points": [[164, 240], [305, 240], [305, 264], [164, 264]], "difficult": false}, {"transcription": "Trác Than tò mò ngó sang:\"Có chuyen gì vày a?\"", "points": [[192, 273], [657, 269], [657, 299], [192, 303]], "difficult": false}, {"transcription": "\"Cháu xem tin túc ngày hòm nay chua, có mot cò gái làm vǎn phòngvi", "points": [[195, 309], [912, 309], [912, 336], [195, 336]], "difficult": false}, {"transcription": "khòng muǒn tǎng ca nèn dā nhày làu tr sát.\" Máy bà co deu thich nói chuyén", "points": [[163, 342], [911, 339], [911, 370], [163, 373]], "difficult": false}, {"transcription": "vói Trác Than, thǎy anh sáp lai gan bèn voi vàng dua chiec dien thoai vói màn", "points": [[165, 377], [911, 374], [911, 402], [165, 405]], "difficult": false}, {"transcription": "hinh nút nhu mang nhèn ra cho anh xem.", "points": [[166, 414], [557, 411], [557, 435], [166, 437]], "difficult": false}, {"transcription": "Màn hình nút nhu to nhen nhìn khòng rō lám, nhung chi cǎn liěc qua tǎm", "points": [[194, 446], [910, 446], [910, 473], [194, 473]], "difficult": false}, {"transcription": "anh da duoc làm mò dính kèm là có the nhàn ra ngay Thái Trang Tan Thành.", "points": [[165, 482], [910, 480], [910, 507], [165, 509]], "difficult": false}, {"transcription": "Trác Than vòi lǎy dièn thoai cùa minh ra xem. Binh thuòng có tin túrc gì hot la", "points": [[168, 515], [910, 515], [910, 539], [168, 539]], "difficult": false}, {"transcription": "trén mang sē day rǎy thòng tin, chuyén này cǔng khòng ngoai lè, chi tim dai", "points": [[168, 551], [910, 551], [910, 575], [168, 575]], "difficult": false}, {"transcription": "mòt chút là da ra.", "points": [[169, 584], [336, 584], [336, 608], [169, 608]], "difficult": false}, {"transcription": "\"Nü nhàn vièn vǎn phòng khòng chiu duoc áp luc nǎng ně nèn nhày tàu tie vong.", "points": [[196, 613], [912, 619], [912, 652], [196, 646]], "difficult": false}, {"transcription": "Tuong lai nào cho nhieng nhàn vièn vǎn phòng.\"", "points": [[167, 651], [593, 648], [593, 682], [167, 685]], "difficult": false}, {"transcription": "\"Ni nhàn vièn vǎn phòng te sát vì khòng muōn tǎng ca. Ai có the dàm bào cho", "points": [[198, 686], [910, 688], [910, 717], [198, 715]], "difficult": false}, {"transcription": "quyěn loi cia nhūng nguòi lao dōng trí thirc?\"", "points": [[166, 723], [574, 718], [574, 748], [166, 752]], "difficult": false}, {"transcription": "\"Do lao dóng guá siec, trang thái tinh thǎn và sirc khòe cia nhóm lao dōng trí thic", "points": [[196, 756], [911, 759], [911, 786], [196, 783]], "difficult": false}, {"transcription": "dang ò mic dáng báo dōng, sǒ nguòi chet và trǎm càm tǎng lèn theo tieng nǎm.\"", "points": [[168, 793], [864, 793], [864, 820], [168, 820]], "difficult": false}, {"transcription": "Tat cà các bài báo děu nói Ly Dinh nhay lau tr sát. Mǎc dù da che tèn và sira", "points": [[193, 828], [911, 830], [911, 857], [193, 855]], "difficult": false}, {"transcription": "thành Ly A, và cong ty mang A, nhung nhirng nguòi biět chuyèn vira doc là", "points": [[166, 864], [910, 864], [910, 891], [166, 891]], "difficult": false}, {"transcription": "hieu ngay.Tùng càu ting chūr trong dòng tít dài ngoàng deu choc vào dày than", "points": [[166, 896], [910, 897], [910, 925], [166, 924]], "difficult": false}, {"transcription": "kinh nhay càm cùa nguòi dàn lao dòng trong thành pho. Vièc tǎng ca cúa dàn", "points": [[166, 930], [911, 931], [911, 958], [166, 957]], "difficult": false}, {"transcription": "vǎn phòng vǎn luòn là dě tài muòn thuò, nǎm nào cǔng bi lòi ra dě cho nguròi", "points": [[167, 964], [911, 965], [911, 991], [167, 990]], "difficult": false}, {"transcription": "ta thò ngán than dài.", "points": [[166, 999], [365, 996], [365, 1022], [166, 1024]], "difficult": false}, {"transcription": "Dó là co hoi de nhūng nguòi phài tǎng ca vì bènh lě mě tr càm thàyxót", "points": [[193, 1032], [911, 1034], [911, 1064], [193, 1062]], "difficult": false}, {"transcription": "thuong cho mình, dē nhūng nguòi bi giày vò cà vě thē xác lǎn tinh thàn giūa", "points": [[168, 1068], [910, 1070], [910, 1097], [168, 1095]], "difficult": false}, {"transcription": "thành phǒ lón có mòt ly do vě què, de nhūng nguòi bi ép tǎng ca dēn lao l", "points": [[168, 1101], [910, 1103], [910, 1130], [168, 1128]], "difficult": false}, {"transcription": "có có xin ong chú tǎng luong. Chuyen này dugc lan truyěn nhanh chóng là bòi", "points": [[167, 1134], [911, 1135], [911, 1165], [167, 1164]], "difficult": false}, {"transcription": "nó tác dong tói dòng dào quǎn chúng và có the sùr dung vào nhièu muc dich.", "points": [[169, 1170], [906, 1170], [906, 1197], [169, 1197]], "difficult": false}, {"transcription": "Báo mang thòi nay là nhu váy day, giàt tít mò dǎu bàng mòt tǎm ành, nōi", "points": [[197, 1205], [911, 1205], [911, 1235], [197, 1235]], "difficult": false}, {"transcription": "dung thì toàn bia dǎt, chuyèn này cǔng khòng có gi to tát. Nhung cái khiěn cho", "points": [[168, 1238], [913, 1238], [913, 1270], [168, 1270]], "difficult": false}, {"transcription": "trái tim Trác Thǎn quǎn thát chính là doan ghi àm phòng vǎn bǒ me Ly Dinh", "points": [[168, 1269], [912, 1269], [912, 1303], [168, 1303]], "difficult": false}, {"transcription": "dinh kèm yói mǎy tǎm ành chup màn hình trò chuyèn trèn Wechat.", "points": [[169, 1303], [801, 1309], [801, 1339], [169, 1333]], "difficult": false}, {"transcription": "40", "points": [[522, 1374], [557, 1374], [557, 1403], [522, 1403]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page39.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[390, 60], [564, 60], [564, 80], [390, 80]], "difficult": false}, {"transcription": "\"Con bé cir luōn miēng than mèt, lúc truóc có lān nira dèm goi diēn thoai cho tōi", "points": [[132, 99], [857, 102], [857, 129], [132, 126]], "difficult": false}, {"transcription": "khóc lóc nói khōng muōn làm nüra, ngày nào cūng tǎng ca dēn hai ba giò sáng..\"", "points": [[100, 132], [856, 134], [856, 161], [100, 159]], "difficult": false}, {"transcription": "Nguòi phu nū trung nièn nói giong dia phuong, xen lǎn cá giong mūi nghen", "points": [[101, 164], [857, 166], [857, 193], [101, 191]], "difficult": false}, {"transcription": "ngào, hien nhièn là vùra khóc xong. Doan ghi àm này thuoc dang video, khi nói", "points": [[101, 197], [857, 197], [857, 224], [101, 224]], "difficult": false}, {"transcription": "chuyèn chi hièn ky hieu dien thoai, sau khi nói xong hình ánh mói thay dōi", "points": [[101, 228], [856, 230], [856, 257], [101, 255]], "difficult": false}, {"transcription": "thành nhūng tǎm anh chup màn hinh WeChat.", "points": [[101, 261], [552, 263], [552, 287], [101, 285]], "difficult": false}, {"transcription": "[Con gái: Lai tǎng ca tói ba giò sáng, con mèt chet mat.]", "points": [[128, 295], [625, 297], [625, 324], [128, 322]], "difficult": false}, {"transcription": "[Con gái: Du án lón nhe vày mà chi có nhóm nǎm nguòi chúng con làm thoi.]", "points": [[128, 330], [824, 332], [824, 362], [128, 360]], "difficult": false}, {"transcription": "[Con gái: Hinh nhu con sot röi me a.]", "points": [[128, 367], [465, 369], [465, 396], [128, 394]], "difficult": false}, {"transcription": "[Con gái: Con càm thay minh sǎp guc mat roi, con khong chiu nōi nira. Ci tiěp tuc", "points": [[128, 403], [860, 406], [860, 432], [128, 429]], "difficult": false}, {"transcription": "thē'này khéo con phát dièn mat! Chua biet ching mot ngày nào dó con sē chet!]", "points": [[102, 435], [802, 436], [802, 463], [102, 462]], "difficult": false}, {"transcription": "Tin nhán trà lòi cùa nguròi me deu bi lam mò, chi nhin thay hàng loat lòi than", "points": [[129, 468], [859, 472], [859, 499], [129, 495]], "difficult": false}, {"transcription": "phien cùa bèn kia gùi tói. Tin nhán cuǒi cùng gùni vào tuǎn trróc là rō ràng nhat.", "points": [[102, 504], [844, 504], [844, 531], [102, 531]], "difficult": false}, {"transcription": "Nhūng chuyen khác thi khòng nói, nhung Trác Than có the kháng dinh tin", "points": [[129, 539], [860, 540], [860, 567], [129, 566]], "difficult": false}, {"transcription": "nhán vào tuàn truóc khòng phài nói vě còng vièc. Thòi gian là mot ngày truóc", "points": [[101, 571], [860, 574], [860, 601], [101, 598]], "difficult": false}, {"transcription": "khi Ly Dinh tim děn Dich vu gia dinh Báo Bien, ro ràng cò ay nói vě ten ban", "points": [[102, 604], [859, 607], [859, 634], [102, 631]], "difficult": false}, {"transcription": "trai cū than kinh cùa minh!", "points": [[103, 638], [367, 638], [367, 661], [103, 661]], "difficult": false}, {"transcription": "Dang xem děn mirc gàn xanh trèn trán nòi cá lèn thì tin nhán Wechat cúa", "points": [[129, 672], [858, 673], [858, 700], [129, 698]], "difficult": false}, {"transcription": "Hura Kieu bat chgt gini tói.", "points": [[103, 706], [359, 706], [359, 730], [103, 730]], "difficult": false}, {"transcription": "[Kieu Kieu Kieu: Anh Thàn, làm the nào bay giò? Bo'me Dinh Dinh cie nói là cong", "points": [[130, 737], [859, 742], [859, 770], [130, 765]], "difficult": false}, {"transcription": "ty dōn ép có ay dēn chet, hòm qua tòi khuyēn bon ho còn bi mǎng lày nia, ho dòi cōng", "points": [[101, 771], [859, 774], [859, 804], [101, 801]], "difficult": false}, {"transcription": "ty phài den tièn cho ho! Sao trèn dòi lai có the loai bo'me nhu the co chi!", "points": [[103, 807], [751, 805], [751, 832], [103, 834]], "difficult": false}, {"transcription": "\".\"Sao trèn dòi lai có the loai bǒ me nhu the? Trác Than cǔng khòng hieu", "points": [[126, 836], [858, 841], [858, 871], [126, 866]], "difficult": false}, {"transcription": "lám. Con gái minh dòt ngòt qua dòi， phàn úng dàu tièn cùa bon ho khòng phài", "points": [[102, 871], [859, 874], [859, 904], [102, 901]], "difficult": false}, {"transcription": "tim ra hung thú mà là nghī cách dòi tien!", "points": [[105, 909], [501, 907], [501, 931], [105, 933]], "difficult": false}, {"transcription": "Rō ràngBàn do Tiéu Diēm là còng ty có che do dai ngò tǒt mà nguòi nào", "points": [[132, 944], [858, 944], [858, 968], [132, 968]], "difficult": false}, {"transcription": "trong ngành cūng muǒn dǎt chàn vào, giò lai bi nói thành ra thě này. Nhó tói", "points": [[102, 977], [859, 972], [859, 999], [102, 1003]], "difficult": false}, {"transcription": "dáng vè binh tīnh cùa Cao Vū Sènh, khòng biět lièu hán có túrc tói múrc nháy", "points": [[103, 1007], [859, 1006], [859, 1034], [103, 1035]], "difficult": false}, {"transcription": "dung lèn khòng nūra. Bèn tai anh bōng vang lèn càu nói\"anh ding nóng giàn\"", "points": [[103, 1039], [857, 1039], [857, 1069], [103, 1069]], "difficult": false}, {"transcription": "mang chút dè dǎt, cam giác mia mai vùra dàng lèn trong lòng dot ngòt vō\"bup", "points": [[100, 1072], [856, 1071], [856, 1101], [100, 1102]], "difficult": false}, {"transcription": "nhu bong bóng xà phòng.", "points": [[102, 1106], [356, 1108], [356, 1135], [102, 1133]], "difficult": false}, {"transcription": "Dien thoai chot vang lēn cát dút dòng suy nghī cùa anh, nguòi goi tói là\"Kè", "points": [[129, 1140], [859, 1138], [859, 1168], [129, 1170]], "difficult": false}, {"transcription": "phu bac\".", "points": [[102, 1174], [199, 1174], [199, 1202], [102, 1202]], "difficult": false}, {"transcription": "\"Dúng là nhác Tao Tháo, Tào Tháo den ngay.\" Lan trróc nói chuyen dien", "points": [[132, 1207], [858, 1207], [858, 1237], [132, 1237]], "difficult": false}, {"transcription": "thoai vói hán, Trác Than còn cám thày thàt ra càu nhóc này rat dáng yèu, nén", "points": [[102, 1241], [857, 1240], [857, 1266], [102, 1267]], "difficult": false}, {"transcription": "mói doi lai tèn cho vui. Anh dura tay an nhan cuòc goi,\"Tǒng Giám doc Cao,", "points": [[101, 1271], [857, 1270], [857, 1300], [101, 1301]], "difficult": false}, {"transcription": "có vièc gì vày?\"", "points": [[103, 1304], [257, 1306], [257, 1334], [103, 1332]], "difficult": false}, {"transcription": "41", "points": [[463, 1361], [498, 1361], [498, 1385], [463, 1385]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page40.jpg	[{"transcription": "ve aī tam thon", "points": [[470, 59], [602, 59], [602, 83], [470, 83]], "difficult": false}, {"transcription": "\"Bày giò tòi khòng tien ra ngoài, anh có thé tói cong ty tòi mot chuyén durge", "points": [[201, 102], [904, 100], [904, 127], [201, 129]], "difficult": false}, {"transcription": "Khòng? Toi muon nói voi anh mot chuyen lien quan tói Ly Dinh.\" Giong Cao", "points": [[170, 135], [906, 133], [906, 160], [170, 162]], "difficult": false}, {"transcription": "Vū Sènh vǎn nhu truóc, hoàn toàn khong có vè túc giàn vi nhūng tin don kia.", "points": [[171, 169], [902, 165], [902, 192], [171, 196]], "difficult": false}, {"transcription": "\"Bay giò a?\" Tráe Than nhin Trác Mong Mong dang tap the duc vói toc di", "points": [[201, 205], [906, 201], [906, 228], [201, 232]], "difficult": false}, {"transcription": "chám bàng mòt nira cáe ban khác, nhu the dang tàp thái cye quyèn.", "points": [[171, 239], [793, 237], [793, 264], [171, 266]], "difficult": false}, {"transcription": "\"Bay giò luon, sē khòng làm mát quá nhièu thòi gian cúa anh dàu.\"Y là anh", "points": [[200, 273], [907, 270], [907, 301], [200, 304]], "difficult": false}, {"transcription": "có thē quay vě truóc khi truòng mǎm non tan hoc.", "points": [[171, 311], [637, 307], [637, 334], [171, 338]], "difficult": false}, {"transcription": "Chuyèn Ly Dinh dòt ngot tùr vong giong nhur cái dàm dam vào tim Trác", "points": [[198, 346], [910, 341], [910, 371], [198, 376]], "difficult": false}, {"transcription": "Thǎn, khòng làm rò mgi chuyen thì anh khòng thē ngoi yén nǒi. Xin phép hiéu", "points": [[171, 379], [907, 377], [907, 407], [171, 409]], "difficult": false}, {"transcription": "truròng và dǎn dò xong xuòi, anh làp túrc xách ba lò lèn ròi di voi vā.", "points": [[171, 416], [799, 411], [799, 438], [171, 442]], "difficult": false}, {"transcription": "Tòa nhà Tài Phú duoc bao phù bàng thùy tinh tòa ra ánh sáng láp lánh duói", "points": [[201, 452], [908, 448], [908, 475], [201, 479]], "difficult": false}, {"transcription": "vang duong ngày ha. Nó giǒng nhu mot thòi vàng doi tròi dap dat, chi cao mót", "points": [[174, 486], [908, 482], [908, 509], [174, 513]], "difficult": false}, {"transcription": "lóp vò mòng thòi cūng dā hon xa tien lurong cà nǎm cúa mòt giáo vièn mǎm", "points": [[172, 521], [908, 516], [908, 543], [172, 548]], "difficult": false}, {"transcription": "non nghèo nhu anh.", "points": [[172, 557], [358, 554], [358, 578], [172, 581]], "difficult": false}, {"transcription": "\"Cao Vū Sènh, do phu bac!\" Nghe thay tiěng máng chiri day nhip dieu kia,", "points": [[201, 590], [906, 590], [906, 617], [201, 617]], "difficult": false}, {"transcription": "Trác Thǎn mói nhó ra hòm nay lai là thúr Sáu. Chì gái no rō ràng lón tuoi hon", "points": [[173, 624], [908, 623], [908, 650], [173, 651]], "difficult": false}, {"transcription": "Cao Vū Sènh, chiri rùa còn hung hǎng hon làn truóc, \"Cao Vū Senh, anh sě", "points": [[172, 659], [910, 656], [910, 683], [172, 686]], "difficult": false}, {"transcription": "khòng duoc chet tùr tě dau! Vút vo bò con, anh dqi xuǒng dia nguc di!\"", "points": [[171, 693], [829, 693], [829, 719], [171, 719]], "difficult": false}, {"transcription": "Còn dùng cà thành ngūr nūra co à.", "points": [[198, 730], [509, 730], [509, 757], [198, 757]], "difficult": false}, {"transcription": "Giò dang là thòi diem ánh náng gay gát nhat, bào vè tòa nhà dúrng trong", "points": [[196, 766], [909, 768], [909, 795], [196, 793]], "difficult": false}, {"transcription": "cira kính vói vè mǎt dòi chàng còn gì luru luyen, thǎy có khách tói bèn voi vàng", "points": [[168, 800], [909, 802], [909, 830], [168, 828]], "difficult": false}, {"transcription": "duòi chi ta di.", "points": [[167, 836], [298, 836], [298, 863], [167, 863]], "difficult": false}, {"transcription": "\"Haiz, chi gi oi, tòi bào này.\"Trác Than dùng mot ngón tay choc vào vai", "points": [[195, 872], [910, 873], [910, 903], [195, 902]], "difficult": false}, {"transcription": "nguòi phu nū dang bi bào vè lòi di,\"Chi nói Cao Vǔ Sènh dá chi, sao giò lai", "points": [[167, 909], [910, 906], [910, 937], [167, 940]], "difficult": false}, {"transcription": "thành vút vg bò con rǒi?\"", "points": [[169, 945], [406, 945], [406, 969], [169, 969]], "difficult": false}, {"transcription": "\"Toi sày thai vì anh ta! Dúa tré dó da thành hình ròi! Vày mà anh ta còn", "points": [[193, 978], [909, 980], [909, 1009], [193, 1008]], "difficult": false}, {"transcription": "khóng chju cuói tòi!\" Nguòi phu nǔr cǎm tǎm ành Cao Vū Senh mǎc do Au", "points": [[167, 1015], [909, 1013], [909, 1044], [167, 1046]], "difficult": false}, {"transcription": "khóng biět cát ra tù quyen tap chí nào, nói vò cùng chác chán.", "points": [[166, 1050], [743, 1050], [743, 1083], [166, 1083]], "difficult": false}, {"transcription": "\"Cau dùrng de y tói co ta, Tong Giám doc Cao khòng phài loai nguròi ay dàu", "points": [[196, 1088], [909, 1089], [909, 1120], [196, 1119]], "difficult": false}, {"transcription": "A này mác chúng hoang tuòng, giǒng kieu fan cuǒng máng chii thǎn turqng", "points": [[168, 1121], [909, 1124], [909, 1157], [168, 1154]], "difficult": false}, {"transcription": "vút bò minh ày.\" Bào vé voi vàng giài thích, hai nguòi hop sirc lòi nguròi phu", "points": [[167, 1158], [907, 1162], [907, 1192], [167, 1188]], "difficult": false}, {"transcription": "nūray sang mot bèn.", "points": [[168, 1194], [356, 1198], [356, 1225], [168, 1220]], "difficult": false}, {"transcription": "\"Các nguòi dèu là tay sai cua anh ta! Là dám chó giúp nguròi có tiěn làm", "points": [[194, 1229], [910, 1230], [910, 1264], [194, 1262]], "difficult": false}, {"transcription": "chuyen ác!\" Nguòi phy nū tiěp tuc mǎng rǎt nhip nhàng, còn mǎng lày sang", "points": [[166, 1260], [910, 1264], [910, 1300], [166, 1297]], "difficult": false}, {"transcription": "cà Trác Than.", "points": [[167, 1294], [294, 1298], [294, 1325], [167, 1321]], "difficult": false}, {"transcription": "42", "points": [[517, 1371], [548, 1371], [548, 1395], [517, 1395]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page41.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[392, 54], [568, 51], [568, 75], [392, 78]], "difficult": false}, {"transcription": "\"Vǎn hoa thàt, còn gieo vàn dinh ghè.\" Trác Than vǒ tay khen ngqi hét súrc", "points": [[137, 95], [859, 98], [859, 125], [137, 122]], "difficult": false}, {"transcription": "lichsu.", "points": [[104, 129], [180, 129], [180, 157], [104, 157]], "difficult": false}, {"transcription": "Anh di vào thang máy, quen tay an nút tang 23. Lúc truóc Ly Dinh hói tai", "points": [[136, 163], [858, 166], [858, 190], [136, 187]], "difficult": false}, {"transcription": "sao anh lai biet Bàn do Tiéu Diēm ò tǎng 23, anh còn già vò than bí nói vói co", "points": [[105, 197], [859, 197], [859, 221], [105, 221]], "difficult": false}, {"transcription": "dó là bí màt, nhung thuc ra chi là thói quen nghe nghiep thòi. Vùra vào cira anh", "points": [[105, 228], [858, 230], [858, 254], [105, 252]], "difficult": false}, {"transcription": "da lày bàn do ò quày lě tàn, chi can xem lrót qua là biét còng ty nào ó tàng bao", "points": [[104, 258], [859, 261], [859, 288], [104, 285]], "difficult": false}, {"transcription": "nhièu, lǒi thoát him mǒi tǎng nǎm ò vi trí nào.", "points": [[105, 294], [561, 294], [561, 318], [105, 318]], "difficult": false}, {"transcription": "Thang máy lèn dēn tǎng 23,\"tinh\" mòt tiēng mò ra,tiěng gào khóc có", "points": [[133, 324], [861, 327], [861, 357], [133, 354]], "difficult": false}, {"transcription": "dè-xi-ben dat tói tièu chuan cùa tiěng ǒn tràn vào thang máy nhu nuóc lū,", "points": [[104, 359], [860, 363], [860, 390], [104, 386]], "difficult": false}, {"transcription": "khièn anh có ào giác nhur minh vùra buóc vào tang muòi tám cúa Thái Trang", "points": [[102, 391], [860, 397], [860, 424], [102, 417]], "difficult": false}, {"transcription": "Tan Thanh.", "points": [[102, 424], [217, 427], [217, 452], [102, 449]], "difficult": false}, {"transcription": "Tièn vàng, huong, nēn bày day trèn něn gach tròi sao ngoài cira kính, tǎm", "points": [[132, 459], [860, 461], [860, 491], [132, 489]], "difficult": false}, {"transcription": "rèm trǎngtreo trèn turòng có mày chūr viět tay lón màu den\"cong ty dōc ác", "points": [[102, 494], [861, 496], [861, 523], [102, 521]], "difficult": false}, {"transcription": "mau děn mang cho cháu gái toi\".Mot nguòi dàn òng trung nièn òm di ành", "points": [[103, 529], [860, 529], [860, 556], [103, 556]], "difficult": false}, {"transcription": "cua Ly Dinh, hai nguròi phy nū trung nién dang ngǒi duói dat gào khóc khong", "points": [[103, 560], [860, 563], [860, 590], [103, 587]], "difficult": false}, {"transcription": "ngùng nghi, còn dùng chiec loa cam tay chat luong thap to co vien gach de bat", "points": [[102, 593], [861, 592], [861, 622], [102, 623]], "difficult": false}, {"transcription": "mot bài nhac hieu thé luong.", "points": [[101, 624], [384, 627], [384, 655], [101, 652]], "difficult": false}, {"transcription": "Chác ho dùng thé nhàn vièn cúa Ly Dinh de quet di thang máy, nhung vì", "points": [[132, 658], [860, 662], [860, 692], [132, 687]], "difficult": false}, {"transcription": "khòng có vàn tay, khòng vào duoc bèn trong nèn mói ngǒi ǎn va ngoài này.", "points": [[100, 692], [860, 694], [860, 724], [100, 722]], "difficult": false}, {"transcription": "Còn có phóng vièn cúa tòa báo nào dó cǎm dièn thoai dúng quay video bèn", "points": [[103, 727], [860, 727], [860, 754], [103, 754]], "difficult": false}, {"transcription": "canh:\"Chúng toi dang có mǎt truóc cira Còng ty Ban do Tieu Diem, than nhan", "points": [[101, 760], [860, 759], [860, 786], [101, 787]], "difficult": false}, {"transcription": "cùa nguròi chět Ly A dang yeu cǎu mot lòi giài thich tir phia còng ty,nhung mai", "points": [[102, 791], [860, 792], [860, 822], [102, 821]], "difficult": false}, {"transcription": "vǎn chura thay nguòi phu trách cúa còng ty xuat hièn.\"", "points": [[102, 824], [633, 825], [633, 852], [102, 851]], "difficult": false}, {"transcription": "\"Tir khi cháu tòi màt tói giò, lanh dao cǔa don vi chura tùng tói thǎm mòt lan", "points": [[132, 860], [859, 862], [859, 889], [132, 887]], "difficult": false}, {"transcription": "nào, còn khòng có lǎy mòt cuòc dièn thoai an úi!\"", "points": [[100, 895], [582, 893], [582, 920], [100, 922]], "difficult": false}, {"transcription": "\"Don vi này khòng chính quy, còn khòng có cà trg cǎp tùr vong, nói là phài", "points": [[132, 929], [859, 930], [859, 957], [132, 956]], "difficult": false}, {"transcription": "dqi còng ty bào hiem chi trá!\"", "points": [[101, 965], [392, 960], [392, 987], [101, 992]], "difficult": false}, {"transcription": "Nghe may lòi ngang nguroc bat chap ly lē dó, Trác Than chi càm thay dau", "points": [[128, 997], [859, 995], [859, 1025], [128, 1027]], "difficult": false}, {"transcription": "dau nhu búa bo:\"Haiz, toi bao này,Cuc Canh sát còn chua kět án dàu, các", "points": [[101, 1030], [860, 1029], [860, 1056], [101, 1057]], "difficult": false}, {"transcription": "nguòi ǎn va ò còng ty nguòi ta làm gì the?\"", "points": [[100, 1066], [525, 1060], [525, 1088], [100, 1094]], "difficult": false}, {"transcription": "\"Cau là nguòi cúa còng ty này hà?\" Ga dàn òng tr nhàn là chú cùa Ly Dinh", "points": [[130, 1100], [858, 1097], [858, 1124], [130, 1127]], "difficult": false}, {"transcription": "buóc tói,day manh Trác Than mot cái.", "points": [[102, 1136], [479, 1133], [479, 1157], [102, 1160]], "difficult": false}, {"transcription": "Trác Than lào dào, suyt nūra va vào tuòng, thoat nhin có vé ràt yěu duoi.", "points": [[129, 1168], [856, 1166], [856, 1193], [129, 1195]], "difficult": false}, {"transcription": "Anh cúi dau hít sau mot hoi, sau dó ngang dǎu lèn mim curòi:\"Này òng anh,", "points": [[103, 1200], [855, 1200], [855, 1227], [103, 1227]], "difficult": false}, {"transcription": "có gì thì tùr tù nói chúr, dùrng dòng tay dòng chàn.\"", "points": [[100, 1234], [595, 1231], [595, 1260], [100, 1264]], "difficult": false}, {"transcription": "\"Tao cúr dòng dǎy thì làm sao! Dinh Dinh nhà bon tao bi chúng mày hai chet", "points": [[130, 1270], [856, 1266], [856, 1293], [130, 1296]], "difficult": false}, {"transcription": "roi, còn khòng cho bon tao trút giàn nūa à?\" Thay Trác Than yěu ót nhur vày,", "points": [[102, 1301], [856, 1299], [856, 1329], [102, 1331]], "difficult": false}, {"transcription": "43", "points": [[463, 1359], [497, 1359], [497, 1385], [463, 1385]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page42.jpg	[{"transcription": "ve sī tam thoi", "points": [[466, 52], [602, 49], [602, 73], [466, 76]], "difficult": false}, {"transcription": "khí thě cùa gā dàn òng trung nièn hung hǎng kia làp túc bùng lèn nhur lùra do", "points": [[158, 92], [909, 89], [909, 120], [158, 123]], "difficult": false}, {"transcription": "them dau, ngùn ngut bǒe cao ba mét.", "points": [[161, 130], [514, 127], [514, 151], [161, 153]], "difficult": false}, {"transcription": "\"Súe khòe tòi khòng tōt, dánh chět tòi là òng phái chju trách nhiém dáy.\"", "points": [[191, 161], [906, 157], [906, 185], [191, 189]], "difficult": false}, {"transcription": "Trác Than run ray lay binh oxy ra, hit lien mǎy hoi.", "points": [[160, 197], [644, 190], [644, 217], [160, 224]], "difficult": false}, {"transcription": "\"Mày dinh ǎn va dǎy à!\" Thay anh khòng chi yěu ót mà còn là mòt con ma", "points": [[190, 230], [910, 227], [910, 255], [190, 258]], "difficult": false}, {"transcription": "öm, ga kia ung dung gio tay lèn dinh tát thàng vào mǎt Trác Than.", "points": [[160, 267], [787, 260], [787, 287], [160, 294]], "difficult": false}, {"transcription": "\"Bop!\" Co tay ngǎm den to khòe bi bàn tay mành khánh tráng nōn nárn", "points": [[191, 300], [908, 294], [908, 322], [191, 328]], "difficult": false}, {"transcription": "chǎt, khòng the nhúc nhich noi dù chi mot milimet, nhu the bi trúng thuàt dóng", "points": [[161, 334], [912, 329], [912, 360], [161, 365]], "difficult": false}, {"transcription": "bǎng vày. Dòi mát duc ngǎu cùa gā dan loi ra, nhìn nguòi thanh nién yěu ót", "points": [[161, 370], [912, 362], [912, 390], [161, 398]], "difficult": false}, {"transcription": "truóc mǎt minh vói vè khòng thě tin duqc.", "points": [[161, 404], [564, 399], [564, 426], [161, 431]], "difficult": false}, {"transcription": "\"Danói dùmg dòng tay mà, tòi dang vòi.\"Trác Thàn vǎn giü nguyen vé mǎt", "points": [[191, 435], [912, 432], [912, 462], [191, 465]], "difficult": false}, {"transcription": "vò hai， nói chuyen rǎt tùr tǒn nhung cǎp mát da hoi nheo lai.", "points": [[161, 472], [724, 467], [724, 495], [161, 500]], "difficult": false}, {"transcription": "Cira thùy tinh chot mò, Cao Vū Sènh chi mǎc áo so mi khòng mǎc vest buróc", "points": [[191, 508], [912, 505], [912, 532], [191, 535]], "difficult": false}, {"transcription": "vōi ra ngoài, làng lǎng nám lǎy cánh tay dā gio lèn giura khòng trung chuàn bi", "points": [[163, 543], [912, 540], [912, 567], [163, 570]], "difficult": false}, {"transcription": "dánh nguòi cua Trác Than:\"Bao ve dau?\"", "points": [[164, 578], [555, 575], [555, 599], [164, 602]], "difficult": false}, {"transcription": "Hainguòi mǎc dǒng phuc bào vè chay ra tùr cau thang thoát hiem,òm chǎt lǎy", "points": [[190, 613], [910, 610], [910, 637], [190, 640]], "difficult": false}, {"transcription": "gā dàn òng trung nien kia, kéo vě phia sau.Trác Than kip thòi buòng lòng tay, de", "points": [[161, 647], [913, 643], [913, 673], [161, 677]], "difficult": false}, {"transcription": "lai nǎm dǎu ngón tay tráng xanh trèn cǒ tay ngǎm den cúa gā kia.", "points": [[162, 682], [763, 679], [763, 705], [162, 709]], "difficult": false}, {"transcription": "\"Bày giò phía cành sát còn chua dua ra ket luàn, něu là trách nhiem cùa", "points": [[192, 717], [912, 715], [912, 742], [192, 744]], "difficult": false}, {"transcription": "cong ty chúng tòi thì dù phài táng gia bai sán, tòi cūng sē bǒi thuòng. Nhurng", "points": [[161, 753], [912, 750], [912, 777], [161, 780]], "difficult": false}, {"transcription": "néu khòng phài trách nhiém cùa còng ty chúng tòi, tòi sē khòng chi mòt xu nào", "points": [[159, 787], [911, 784], [911, 811], [159, 814]], "difficult": false}, {"transcription": "het!\"Cao Vū Senh lanh lùng nói roi quay sang dǎn thu ky dúmg bèn canh,\"Báo", "points": [[159, 821], [912, 819], [912, 846], [159, 848]], "difficult": false}, {"transcription": "cành sát di!\"Dút lòi, hán xoay nguòi di vào còng ty.", "points": [[159, 853], [654, 855], [654, 885], [159, 883]], "difficult": false}, {"transcription": "Trác Than vǎn bi kéo tay dành di theo may buóc:\"Này, gì nhi, Tong Giám", "points": [[188, 893], [912, 893], [912, 920], [188, 920]], "difficult": false}, {"transcription": "dǒc Cao,hai chúng ta di vào kieu này nghe chùng khòng ōn lám thì phai?\"", "points": [[159, 927], [878, 924], [878, 955], [159, 958]], "difficult": false}, {"transcription": "Hai nguòi dàn òng lón dùng còn tay nám tay, anh thì chǎng sao nhung hùnh", "points": [[186, 966], [913, 963], [913, 992], [186, 995]], "difficult": false}, {"transcription": "tuong cùa Tong Giám dǒcCao sē bi anh huròng mat.", "points": [[160, 1002], [654, 1000], [654, 1027], [160, 1029]], "difficult": false}, {"transcription": "Cao Vū Sènh chua kip nhàn ra Trác Thǎn dang nói gì， cho tói khi lòng bàn", "points": [[186, 1038], [912, 1035], [912, 1065], [186, 1068]], "difficult": false}, {"transcription": "tay bi dau ngón tay anh gǎi nhe mòt cái.", "points": [[161, 1075], [538, 1075], [538, 1102], [161, 1102]], "difficult": false}, {"transcription": "44", "points": [[510, 1375], [546, 1375], [546, 1403], [510, 1403]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page43.jpg	[{"transcription": "Onuong7", "points": [[416, 103], [546, 106], [546, 138], [416, 135]], "difficult": false}, {"transcription": "Sao trēn troi(7)", "points": [[321, 152], [640, 152], [640, 196], [321, 196]], "difficult": false}, {"transcription": "Báy giò Cao Vū Senh mói nhan ra minh dang cam bàn tay khóng rán chác", "points": [[133, 275], [856, 275], [856, 305], [133, 305]], "difficult": false}, {"transcription": "nhung lai vó cùng âm áp càa anh, vò thúc nám chǎt lai ròi mói buòng lóng ra:", "points": [[103, 307], [856, 309], [856, 340], [103, 338]], "difficult": false}, {"transcription": "\"Xin lǒi.\"", "points": [[102, 340], [203, 338], [204, 369], [103, 372]], "difficult": false}, {"transcription": "Trác Than cūng khòng dē y, di theo hán vào vǎn phòngkéo chiěe ghé tiép", "points": [[134, 380], [855, 382], [855, 409], [134, 407]], "difficult": false}, {"transcription": "khách truóc bàn làm vièc roi ngǒi xuǒng:\"Cau goi tòi děn day là dē nhin dám", "points": [[106, 416], [856, 416], [856, 442], [106, 442]], "difficult": false}, {"transcription": "nguòi khóc tang bèn ngoài kia à?\"", "points": [[105, 450], [438, 445], [438, 475], [105, 479]], "difficult": false}, {"transcription": "\"Khòng.\"Cao Vū Senh rót cho anh cǒc nuóc,\"Lúc toi goi dien cho anh, bon", "points": [[136, 483], [855, 485], [855, 513], [136, 511]], "difficult": false}, {"transcription": "ho còn chua tói, tòi muǒn nói vě chuyen cùa anh co.\"", "points": [[106, 519], [619, 518], [619, 545], [106, 546]], "difficult": false}, {"transcription": "\"Toi á?\"Trác Than nhàn lǎy cǒc nuóc. Chiěc cǒc thúy tinh óng ánh trong", "points": [[137, 553], [857, 557], [857, 585], [137, 581]], "difficult": false}, {"transcription": "suot chúra day nuóc loc tinh khiet thoang thoáng mùi huong bac hà, hàn là hán", "points": [[108, 591], [856, 589], [856, 616], [108, 618]], "difficult": false}, {"transcription": "có ngam lá bac hà kho trong binh. Nhūng nguòi tǎng lóp thurong luu thuòng", "points": [[110, 625], [856, 625], [856, 652], [110, 652]], "difficult": false}, {"transcription": "thich uǒng cà phé dát tien hay ruou Tay có màu sác turoi dep,càu Tieu Cao dày", "points": [[109, 658], [855, 657], [855, 684], [109, 685]], "difficult": false}, {"transcription": "lai chi thích uǒng nuóc bac hà giá rè, nhìn thě nào cūng khòng giǒng mōt vi sěp", "points": [[106, 690], [856, 691], [856, 720], [106, 719]], "difficult": false}, {"transcription": "tong quyen lurc.", "points": [[110, 725], [262, 725], [262, 753], [110, 753]], "difficult": false}, {"transcription": "\"Ve.. sièu nǎng luc cúa anh..\" Cao Vū Senh dán do tim tùr ngū de goi sirc", "points": [[136, 758], [858, 760], [858, 790], [136, 788]], "difficult": false}, {"transcription": "manh khòng giong nguòi binh thuròng cùa Trác Thǎn,\"Anh cúr dě lò ra truóe", "points": [[108, 798], [858, 796], [858, 822], [108, 824]], "difficult": false}, {"transcription": "mǎt nguòi khác nhu vày sē rǎt nguy hiem. Něu làm vé sī cho nhieu nguòi khác", "points": [[109, 831], [858, 829], [858, 857], [109, 859]], "difficult": false}, {"transcription": "nhau, chác chán sě có nguòi nhìn ra duoc giǒng tòi thòi.\"", "points": [[109, 864], [656, 863], [656, 891], [109, 892]], "difficult": false}, {"transcription": "\"Tong Giám dǒc Cao dang uy hiep toi day à?\" Trác Than thuàn tay cam cày", "points": [[136, 898], [858, 900], [858, 930], [136, 928]], "difficult": false}, {"transcription": "thuóc sát trén bàn lén, khē gō vào thành cǒc thúy tinh trong suǒt, nhur thē dang", "points": [[110, 936], [858, 936], [858, 963], [110, 963]], "difficult": false}, {"transcription": "gō vào vi Tong Giám dǒc Cao cǔng dát giá nhu chiec cǒc ay vay,\"Sièu nǎng lre", "points": [[108, 970], [859, 967], [859, 997], [108, 1000]], "difficult": false}, {"transcription": "gì co,Tong Giám dǒc Cao nói gì tòi khòng hieu.\"", "points": [[109, 1007], [581, 1001], [581, 1028], [109, 1033]], "difficult": false}, {"transcription": "\"Toi khong có y mao pham, chi muǒn dua ra mòt lòi dè nghi chàn thành vói", "points": [[139, 1041], [859, 1037], [859, 1066], [139, 1070]], "difficult": false}, {"transcription": "anh thói. Cách an toàn nhǎt là anh nén tim mot khách hàng cǒ dinh và bàng", "points": [[109, 1073], [858, 1072], [858, 1102], [109, 1103]], "difficult": false}, {"transcription": "lòng giū bí màt cho anh.\" Cao Vū Senh dan hai bàn tay vào nhau dǎt lèn bàn,", "points": [[109, 1108], [858, 1105], [858, 1135], [109, 1138]], "difficult": false}, {"transcription": "tu thé vùra vò hai lai vùra manh mē,\"Duong nhièn, dày cūng là vì bàn thàn tòi", "points": [[109, 1142], [858, 1139], [858, 1168], [109, 1171]], "difficult": false}, {"transcription": "nūa, toi gǎp rác rǒi giong nhu Ly Dinh.\"", "points": [[109, 1177], [502, 1174], [502, 1205], [109, 1208]], "difficult": false}, {"transcription": "\"Ha?\" Trác Than ngùng xoay cay thuóe trong tay,\"Cau cǔng bi ban trai cǔ", "points": [[138, 1212], [857, 1209], [857, 1240], [138, 1243]], "difficult": false}, {"transcription": "bám duòi à?\"", "points": [[110, 1246], [244, 1246], [244, 1273], [110, 1273]], "difficult": false}, {"transcription": "1", "points": [[174, 1288], [185, 1288], [185, 1297], [174, 1297]], "difficult": false}, {"transcription": "45", "points": [[470, 1371], [501, 1371], [501, 1392], [470, 1392]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page44.jpg	[{"transcription": "ve aī tam thon", "points": [[450, 63], [588, 61], [588, 85], [450, 87]], "difficult": false}, {"transcription": "\"A khòng phai, ban gái cū chú, cái nguòi duói tàng ay hà? Nhìn thì có ve hoi", "points": [[175, 104], [906, 106], [906, 136], [175, 133]], "difficult": false}, {"transcription": "nguy hiēm, còn bát càu ng máu phái trá bàng máu, khong dugc chět tùr té nūra", "points": [[140, 143], [906, 138], [906, 169], [140, 173]], "difficult": false}, {"transcription": "kia.\" Trác Thàn tám tǎc cam thán nhu thē dā nhìn thǎy hình anh Tong Giám", "points": [[142, 177], [905, 177], [905, 204], [142, 204]], "difficult": false}, {"transcription": "dǒe Cao bi nguòi kia bǎm thày vay.", "points": [[143, 215], [485, 215], [485, 242], [143, 242]], "difficult": false}, {"transcription": "\"Day nguòi nguyèn rùa tói chét, tòi sg gì mòt á dàn bà dièn khòng he có", "points": [[174, 253], [907, 252], [907, 279], [174, 280]], "difficult": false}, {"transcription": "sure tǎn cong co chúr.\" Cao Vū Senh cám nhan duroc sy thiéu thien chí cúa Trác", "points": [[141, 290], [907, 288], [907, 315], [141, 317]], "difficult": false}, {"transcription": "Than. Hǎn xoa nhe sqi gàn xanh dang noi trèn trán, rút mot túi tài liéu ra khói", "points": [[142, 324], [907, 324], [907, 354], [142, 354]], "difficult": false}, {"transcription": "ngǎn kéo, trong dó dung mot trang giǎy rǎt màu mè,\"Toi nhàn dugc thúr này.\"", "points": [[142, 362], [904, 360], [904, 388], [142, 390]], "difficult": false}, {"transcription": "Mǎt truóc in thurc don giao do ǎn mòt cách cau thà, mǎt sau in mot logo ky", "points": [[172, 400], [905, 402], [905, 428], [172, 426]], "difficult": false}, {"transcription": "quái. Logo có dang hình tròn dong tàm, xung quanh vē ky hieu cúa muròi hai", "points": [[143, 438], [906, 436], [906, 463], [143, 465]], "difficult": false}, {"transcription": "chòm sao, ò giüra là mòt con mát tron tròn. Nhin thay tò giay ǎy, lurngTrác", "points": [[142, 469], [907, 471], [907, 501], [142, 499]], "difficult": false}, {"transcription": "Than bōng toát mǒ hòi lanh.", "points": [[143, 507], [420, 509], [420, 536], [143, 534]], "difficult": false}, {"transcription": "\"Tò quàng cáo giao do ǎn!\" Anh chòp lǎy nhìn ky hon mói phát hien nó", "points": [[176, 545], [907, 547], [907, 578], [176, 576]], "difficult": false}, {"transcription": "giong hét vói tò quàng cáo mà hòm ày Ly Dinh da mang theo xuǒng nhà.", "points": [[142, 583], [848, 581], [848, 611], [142, 613]], "difficult": false}, {"transcription": "Tò quang cáo này kep lǎn trong dǒng chuyen phát nhanh duoc dua vào vǎn", "points": [[176, 623], [905, 623], [905, 650], [176, 650]], "difficult": false}, {"transcription": "phòng CEO sáng nay, ghi rō phài do dich thàn Cao Vū Senh mò. Hom no Ly", "points": [[144, 659], [903, 658], [903, 686], [144, 687]], "difficult": false}, {"transcription": "Dinh có dǎng bài lèn trang cá nhan cúa minh, chè bai tò thuc don này thiet kě", "points": [[145, 694], [905, 694], [905, 720], [145, 720]], "difficult": false}, {"transcription": "xǎu xí, nén Cao Vū Sènh có chút ǎn turong vě nó.", "points": [[144, 728], [606, 730], [606, 757], [144, 755]], "difficult": false}, {"transcription": "\"Làm vé sī tam thòi cùa tòi di, neu anh khòng bàng lòng làm chín tiéng thì", "points": [[175, 765], [904, 766], [904, 797], [175, 796]], "difficult": false}, {"transcription": "có the dua dón tòi di làm nhur Ly Dinh cūng duoc...\"", "points": [[143, 803], [651, 802], [651, 832], [143, 833]], "difficult": false}, {"transcription": "\"Duoc.\"Khòng doi Tong Giám doc Cao nói xong,Trác Than da nhan ngay", "points": [[176, 841], [902, 845], [902, 872], [176, 868]], "difficult": false}, {"transcription": "cong viec này. Anh chup voi mot tǎm hinh giri cho Phuong So Durong, nói ràng", "points": [[146, 879], [902, 880], [902, 907], [146, 906]], "difficult": false}, {"transcription": "Ly Dinh cǔng tùrng nhan durgc mot tò giay nhu vày. Có lě Phuong So Durong", "points": [[146, 914], [902, 914], [902, 944], [146, 944]], "difficult": false}, {"transcription": "dang bán nén chua trá lòi anh ngay.", "points": [[144, 948], [493, 950], [493, 981], [144, 978]], "difficult": false}, {"transcription": "\"Anh biet nó là gì khong?\" Nhin Trác Than dang cúi dau nghièn cúru tò giay", "points": [[175, 988], [898, 989], [898, 1016], [175, 1015]], "difficult": false}, {"transcription": "Cao Vū Senh chám rǎi quan sát khuon mǎt anh, nhur muǒn tim diem giǒng vói", "points": [[148, 1026], [900, 1026], [900, 1050], [148, 1050]], "difficult": false}, {"transcription": "nguòi trong hǒi úc cúa hán. Nhung do thòi gian da troi qua quá làu, hán thure", "points": [[145, 1060], [902, 1057], [902, 1088], [145, 1091]], "difficult": false}, {"transcription": "sy khóng còn nhó rō nūa rǒi, nhin mǎi cǔng chi dua ra dugc mòt kět luàn là", "points": [[145, 1096], [901, 1094], [901, 1122], [145, 1124]], "difficult": false}, {"transcription": "Trác Than rat deptrai.", "points": [[148, 1134], [365, 1134], [365, 1158], [148, 1158]], "difficult": false}, {"transcription": "Tim dugc chút manh moi, cám xúc cúa Trác Than diu di rǎt nhieu, anh dǎt", "points": [[176, 1166], [901, 1170], [901, 1200], [176, 1196]], "difficult": false}, {"transcription": "dién thoai xuǒng ngáng dau lēn mim cuòi:\"Càu tùng xem Than dièu dai", "points": [[148, 1202], [901, 1204], [901, 1235], [148, 1233]], "difficult": false}, {"transcription": "hiep'chua?\"", "points": [[148, 1240], [274, 1237], [274, 1266], [148, 1269]], "difficult": false}, {"transcription": "\"Roi.\" Tiéu thuyet vō hiep lùng danh, quay tàn máy phièn ban phim truyen", "points": [[179, 1273], [901, 1280], [901, 1309], [179, 1303]], "difficult": false}, {"transcription": "hinh, hǒi còn bé Cao Vū Sènh rát thích xem.", "points": [[151, 1311], [564, 1312], [564, 1339], [151, 1338]], "difficult": false}, {"transcription": "46", "points": [[503, 1375], [540, 1375], [540, 1403], [503, 1403]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page45.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[390, 56], [568, 54], [568, 78], [390, 80]], "difficult": false}, {"transcription": "\"Trong phim'Than dieu dai hiep', ma dau Ly Mac Sau có mot thói quen la", "points": [[134, 100], [862, 101], [862, 128], [134, 127]], "difficult": false}, {"transcription": "an dau tay máu ò nhà mue tieu truóe khi giēt nguòi. Dě lai mǎy dǎu tay thi sē", "points": [[103, 134], [863, 134], [863, 160], [103, 160]], "difficult": false}, {"transcription": "giet tùrng ay nguòi.\" Hě tàm trang tǒt là Trác Than lai bát dau ǎn nói linh tinh,", "points": [[103, 166], [862, 166], [862, 196], [103, 196]], "difficult": false}, {"transcription": "diung chièu trò binh thuròng hay lira tre con de treu vi Tong Giám dǒc Tieu Cao", "points": [[102, 199], [863, 200], [863, 230], [102, 229]], "difficult": false}, {"transcription": "luòn mang vè mǎt nghiem túe này.", "points": [[104, 237], [444, 237], [444, 261], [104, 261]], "difficult": false}, {"transcription": "Nhumg Cao Vū Senh khòng duoi anh cút nhur Phuong So Duong, mà cup mi", "points": [[132, 268], [863, 271], [863, 302], [132, 299]], "difficult": false}, {"transcription": "xuǒng suy nghī mòt chút:\"Rat có khà nǎng.\"", "points": [[103, 306], [546, 303], [546, 334], [103, 337]], "difficult": false}, {"transcription": "\"Thě cūng tin à, thàng nhóc này khòng bi ngǒc dǎy chú.Trác Thàn nhin", "points": [[157, 340], [861, 341], [861, 371], [157, 370]], "difficult": false}, {"transcription": "hǎn, khòng biět phài nói gì.", "points": [[103, 375], [371, 378], [371, 406], [103, 402]], "difficult": false}, {"transcription": "Sau dó, su thàt chúng minh Tong Giám doc Cao khònghě ngoc, dǎc biet là", "points": [[135, 415], [862, 415], [862, 441], [135, 441]], "difficult": false}, {"transcription": "khi nói tói chuyen tiěn nong. Něu da quyět dinh làm vé sī tam thòi thì truóc hět", "points": [[102, 446], [864, 445], [864, 475], [102, 476]], "difficult": false}, {"transcription": "phai thurong lrong rō chuyén lrong bōng. Cao Vū Sènh lǎy báng giá cúa còng", "points": [[103, 482], [862, 483], [862, 510], [103, 509]], "difficult": false}, {"transcription": "ty vé sī chính quy ra, giá thuè theo ngàylà dát nhǎt, vè sī cǎp A mōt ngày tám", "points": [[104, 516], [862, 516], [862, 543], [104, 543]], "difficult": false}, {"transcription": "nghin, vé sī cap B mot ngày sáu nghin. Bao tháng và bao nǎm thì ré hon nhieu,", "points": [[103, 550], [861, 549], [861, 576], [103, 577]], "difficult": false}, {"transcription": "lurong tháng khoáng ba muoi, bǒn muoi nghin, lrong nǎm khoang tǎm ba trǎm", "points": [[103, 583], [860, 584], [860, 611], [103, 610]], "difficult": false}, {"transcription": "děn bǒn trǎm nghin, khòng có quy luàt gì dáng nói cá.", "points": [[103, 616], [629, 618], [629, 645], [103, 643]], "difficult": false}, {"transcription": "Dày là giá binh quàn trong ngành, Trác Thǎn cūng gàt dau tò vè dǒng y.", "points": [[133, 653], [831, 655], [831, 683], [133, 681]], "difficult": false}, {"transcription": "\"Bói vì anh khòng phàivé sī chính quy, bình thuòng cǔng chi lǎy bǒn", "points": [[134, 687], [860, 693], [860, 719], [134, 714]], "difficult": false}, {"transcription": "nghin mot ngay, nhu vày bao cà tháng khoàng tam hai muroi nghin. Hon nira,", "points": [[102, 723], [861, 723], [861, 753], [102, 753]], "difficult": false}, {"transcription": "bày giò mǒi ngày anh chi làm vièc vào giò di làm và tan tǎm, nèn cùng lám", "points": [[102, 756], [859, 756], [859, 786], [102, 786]], "difficult": false}, {"transcription": "là muòi nghin, tòi trà anh muòi lǎm nghìn.\" Cao Vū Senh trung ra bò mǎt", "points": [[100, 789], [861, 791], [861, 821], [100, 819]], "difficult": false}, {"transcription": "cúa mōt thurong nhàn, cú nhu the nguòi chào giá nǎm muoi nghìn trróc dó", "points": [[100, 824], [861, 825], [861, 855], [100, 854]], "difficult": false}, {"transcription": "khòng phài là hán vày.", "points": [[100, 857], [332, 859], [332, 887], [100, 885]], "difficult": false}, {"transcription": "\"Lúc trróc càu trà nǎm muoi nghin co mà?\" Trác Than thir ky kèo.", "points": [[129, 892], [780, 895], [780, 926], [129, 923]], "difficult": false}, {"transcription": "\"Dó là làm vièc chín tiěng mòt ngày, anh còn phai chǎm tré nǔa mà? Něu", "points": [[131, 931], [858, 933], [858, 961], [131, 959]], "difficult": false}, {"transcription": "nhu anh bàng lòng có thē gúni càu bé ò nhà tré trén tang muòi bay cúa tòa nhà", "points": [[100, 966], [857, 968], [857, 994], [100, 992]], "difficult": false}, {"transcription": "này, chi phí sē do còng ty chi trà.\"", "points": [[100, 1003], [436, 998], [436, 1026], [100, 1030]], "difficult": false}, {"transcription": "Tong Giám dǒc Cao còn càn nhác den cà viec nhà Trác Than có tré con, sáp", "points": [[128, 1036], [858, 1037], [858, 1067], [128, 1066]], "difficult": false}, {"transcription": "xěp tàt cà dàu ra dǎy, chi thieu mǒi cái gàt dau cúa anh vè sī nüra thòi， mà suyt", "points": [[99, 1071], [858, 1071], [858, 1101], [99, 1101]], "difficult": false}, {"transcription": "nūra thì vé sī Trác cǔng dong y that. Nhung ngay khi vùra dǎt duroc nira chàn", "points": [[97, 1106], [858, 1105], [858, 1132], [97, 1133]], "difficult": false}, {"transcription": "vào, anh lai dòt ngòt cám thày có gì dó khòng ǒn. vi sēp tōng này bó ra quá", "points": [[98, 1140], [856, 1139], [856, 1167], [98, 1168]], "difficult": false}, {"transcription": "nhieu vi mot nguòi vé si, hět mòi anh ǎn com rǒi lai dieu tra hoàn cánh gia dinh", "points": [[98, 1175], [856, 1173], [856, 1199], [98, 1201]], "difficult": false}, {"transcription": "anh.. cúr nhur dang chǎng ra mot tǎm luói vò hình, bày dú moi thú anh dang", "points": [[97, 1209], [856, 1207], [856, 1234], [97, 1236]], "difficult": false}, {"transcription": "cǎn nhu nhà tré cao cp, tiěn, cóng vièe có the tránh nguy co bi bai lò bí màt,", "points": [[97, 1240], [856, 1239], [856, 1268], [97, 1269]], "difficult": false}, {"transcription": "dieu tra manh mǒi lién quan tói cái chět cua Ly Dinh... chi dqi con thó béo là", "points": [[98, 1274], [857, 1271], [857, 1301], [98, 1304]], "difficult": false}, {"transcription": "anh dàm dàu vào thòiváy.", "points": [[99, 1306], [365, 1311], [365, 1338], [99, 1333]], "difficult": false}, {"transcription": "47", "points": [[461, 1362], [497, 1362], [497, 1391], [461, 1391]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page46.jpg	[{"transcription": "ve sī tam thàn", "points": [[462, 40], [597, 40], [597, 67], [462, 67]], "difficult": false}, {"transcription": "\"Tam thòi chua cǎn, tòi thich cong viec ò trròng mam non.\"Trác Than nhin", "points": [[197, 86], [893, 83], [893, 116], [197, 119]], "difficult": false}, {"transcription": "dau tùr chǒi món ngon có doc này.", "points": [[169, 126], [483, 125], [483, 151], [169, 152]], "difficult": false}, {"transcription": "Dúng lúc ây, thur ky Hách buóc vào thong báo cánh sát dā tói.", "points": [[197, 163], [765, 161], [765, 188], [197, 190]], "difficult": false}, {"transcription": "Canh sát còng tay ba nguòi làm loan kia, chi vào gā dàn òng trung nién", "points": [[197, 199], [890, 199], [890, 229], [197, 229]], "difficult": false}, {"transcription": "dang gàn cǒ gào thét:\"Sao lai là òng nūa?\"", "points": [[169, 239], [563, 235], [563, 262], [169, 266]], "difficult": false}, {"transcription": "\"Dǒng chí canh sát, anh biet òng ta à?\" Trác Thǎn túm lǎy tén phóng vién", "points": [[200, 274], [892, 273], [892, 303], [200, 304]], "difficult": false}, {"transcription": "dang dinh chuǒn mat, thong thà hít mot hoi oxy. Ban dau tén phóng vién còn", "points": [[168, 311], [894, 307], [894, 338], [168, 342]], "difficult": false}, {"transcription": "vùng vǎy duoc mot chút, sau dó thì nhur bi xich sát trói lai, cà cánh tay khòng", "points": [[168, 347], [894, 344], [894, 374], [168, 377]], "difficult": false}, {"transcription": "the nhúc nhich nǔra, quay trái co phai deu khòng xong, hèt nhur dang nháy mt", "points": [[168, 382], [893, 381], [893, 411], [168, 412]], "difficult": false}, {"transcription": "bài popping chua bièn het.", "points": [[169, 421], [418, 418], [418, 445], [169, 447]], "difficult": false}, {"transcription": "\"Duong nhièn là quen rǒi, ba nguòi này chuyen di ǎn va, tháng truróc toi da", "points": [[199, 454], [892, 453], [892, 484], [199, 485]], "difficult": false}, {"transcription": "bát bon ho mòt lan ò cōng Bènh vièn Nhàn Dàn. Bon ho chuyen diěn cho máy", "points": [[171, 492], [891, 492], [891, 519], [171, 519]], "difficult": false}, {"transcription": "nhà bì giài tóa hoǎc là máy ké ǎn va de lira tiěn ày...Biet dieu chút di, cái gì", "points": [[171, 528], [890, 528], [890, 555], [171, 555]], "difficult": false}, {"transcription": "mà cháu cúa òng há, nguòi trong di ành xinh dep thě kia, có cǎp mát ti hí nhu", "points": [[170, 564], [892, 561], [892, 588], [170, 591]], "difficult": false}, {"transcription": "ong dàu?\"", "points": [[168, 596], [274, 594], [275, 629], [169, 631]], "difficult": false}, {"transcription": "Giai tòa.. Trác Than cau mày, nghien rǎng kèn ket quay dau sang hòi Cao", "points": [[202, 639], [889, 639], [889, 663], [202, 663]], "difficult": false}, {"transcription": "Vū Senh:\"Thàng khǒn Vuong Cánh Hang dó dang ò bènh vièn nào.\"", "points": [[172, 673], [798, 671], [798, 697], [172, 700]], "difficult": false}, {"transcription": "Tong Giám dǒc Cao:\".", "points": [[201, 705], [426, 708], [426, 738], [201, 736]], "difficult": false}, {"transcription": "1", "points": [[422, 708], [437, 711], [434, 724], [419, 721]], "difficult": false}, {"transcription": "Canh sát di roi, tén phóng vièn vǎn bi túm chǎt la oai oái:\"Bò tòi ra!\"", "points": [[202, 747], [828, 746], [828, 774], [202, 775]], "difficult": false}, {"transcription": "\"Oi chà, quèn mat anh day.\" Trác Than ung dung quay lai nhìn tèn phóng", "points": [[202, 782], [893, 786], [893, 816], [202, 812]], "difficult": false}, {"transcription": "vièn, cuóp dièn thoai trong tay hán dua cho thu ky Hách de anh ta xóa nhūng", "points": [[172, 818], [893, 818], [893, 851], [172, 851]], "difficult": false}, {"transcription": "video lièn quan, sau dó móc dién thoai ra chīa thǎng vào mǎt hán quay video:", "points": [[173, 855], [891, 855], [891, 885], [173, 885]], "difficult": false}, {"transcription": "\"Cuòi mot cái nào,nói di, là ai thué anh tói dày.\"", "points": [[174, 892], [613, 892], [613, 919], [174, 919]], "difficult": false}, {"transcription": "Mǎt tèn phóng vièn trǎng bèch nhu vit bi cát tiět, nhung hán vǎn cúng", "points": [[198, 926], [891, 929], [891, 960], [198, 957]], "difficult": false}, {"transcription": "miēng khòng chiu nói gì.", "points": [[173, 964], [402, 960], [402, 991], [173, 995]], "difficult": false}, {"transcription": "***", "points": [[510, 1000], [543, 1000], [543, 1019], [510, 1019]], "difficult": false}, {"transcription": "Trong doi canh sát hinh su cua Cuc Canh sát thanh pho, Phurong So Durong", "points": [[199, 1035], [893, 1039], [893, 1073], [199, 1069]], "difficult": false}, {"transcription": "vǎn dang xem di xem lai hǒ so ghi chép.", "points": [[176, 1075], [537, 1075], [537, 1102], [176, 1102]], "difficult": false}, {"transcription": "Nguòi chět trong vu án ò thành Nam tèn là Vuong Cuòng bǒn muroi sáu", "points": [[199, 1110], [892, 1113], [892, 1143], [199, 1140]], "difficult": false}, {"transcription": "tuōi， giói tính nam. Vg ong ta nói, hom ay Vurong Cuòng ra ngoài uǒng rurqu", "points": [[173, 1147], [890, 1151], [890, 1178], [173, 1174]], "difficult": false}, {"transcription": "cùng ban den núra dèm vǎn chua vě nēn bà ta òm con ngù mat, ngày hòm sau", "points": [[174, 1182], [890, 1184], [890, 1211], [174, 1209]], "difficult": false}, {"transcription": "khòng thǎy nguòi vě, dién thoai cūng khòng goi duroc, bà ta mói báo cánh sát.", "points": [[173, 1215], [888, 1216], [888, 1246], [173, 1245]], "difficult": false}, {"transcription": "Bo me Vuong Cuòng thi kién quyět cho ràng con minh bi sát hai.", "points": [[174, 1250], [757, 1252], [757, 1278], [174, 1276]], "difficult": false}, {"transcription": "[Vg Vuong Cuòng (Chu Ngoc Phan): Nhà có ng mot khoan vay vói lai suat cao, gǎn", "points": [[201, 1285], [887, 1289], [887, 1316], [201, 1312]], "difficult": false}, {"transcription": "dày tàm trang Vuong Cuòng khong tot, thuòng xuyen ra ngoài uōng rugu suot dèm", "points": [[175, 1319], [890, 1323], [890, 1353], [175, 1349]], "difficult": false}, {"transcription": "48", "points": [[509, 1378], [543, 1378], [543, 1403], [509, 1403]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page47.jpg	[{"transcription": "Luc Da Thien Hac", "points": [[386, 52], [560, 51], [560, 72], [386, 73]], "difficult": false}, {"transcription": "khōng cě. Toi cūng khōng dè y, nhung chǎng ngò anh ay lai tu sát nhu váy, de lgi mg", "points": [[104, 96], [846, 96], [846, 123], [104, 123]], "difficult": false}, {"transcription": "goa con cöi thě này, chúng toi biet phdi làm sao day?l", "points": [[102, 132], [568, 128], [568, 155], [102, 158]], "difficult": false}, {"transcription": "[Bō Vuong Cuòng: Khodn ng dó nó vay nguòi ta dè làm ǎn, bán sō hàng kia di la", "points": [[132, 166], [846, 166], [846, 193], [132, 193]], "difficult": false}, {"transcription": "trà dugc, khōng thē có chuyèn nó tu sát dē'trǒn ng!l", "points": [[103, 203], [559, 201], [559, 228], [103, 230]], "difficult": false}, {"transcription": "[Me Vuong Cuòng: Chác chán là Chu Ngoc Phàn làm, truóc day nó nói con trai", "points": [[131, 241], [848, 237], [848, 265], [131, 269]], "difficult": false}, {"transcription": "tōi ngoai tinh, nǎm ngày ba trān cāi nhau lièn mièn khōng ngót, còn báo muón be hai", "points": [[103, 277], [848, 271], [848, 299], [103, 305]], "difficult": false}, {"transcription": "dira con di nháy sōng nüra.]", "points": [[103, 312], [345, 309], [345, 336], [103, 339]], "difficult": false}, {"transcription": "Trèn nguòi Vuong Cuòng cǔng khòng có dau vět giàng co, mot là ty nháy", "points": [[129, 347], [846, 345], [846, 376], [129, 378]], "difficult": false}, {"transcription": "xuǒng, hai là bi hung thù khǒng chě trong mòt chieu.", "points": [[104, 386], [611, 382], [611, 408], [104, 413]], "difficult": false}, {"transcription": "\"VuVuong Cuòng còn có mòt khà nǎng nūra, dó là bi nguòi mà òng ta quen", "points": [[133, 420], [847, 422], [847, 448], [133, 447]], "difficult": false}, {"transcription": "biet bat ngò day xuong. Nhung vu cúa Ly Dinh thì khòng day dugc, něu muǒn", "points": [[102, 456], [847, 454], [847, 481], [102, 483]], "difficult": false}, {"transcription": "ném xuǒng mà khòng có dǎu vět giàng co, trùr phi nguòi dó phai là mòt lc sī,", "points": [[102, 489], [847, 486], [847, 517], [102, 520]], "difficult": false}, {"transcription": "nàng cò ta lèn quá dàu rǒi ném xuǒng giǒng nhu dòng tác cùr giàt trong bò mòn", "points": [[104, 526], [847, 523], [847, 551], [104, 554]], "difficult": false}, {"transcription": "cùr ta.\" Dǒng nghiep khám xét hien truòng khua tay mò tá do cao cùa cira sǒ.", "points": [[103, 560], [832, 555], [832, 585], [103, 590]], "difficult": false}, {"transcription": "Luc sīà...", "points": [[131, 597], [233, 597], [233, 626], [131, 626]], "difficult": false}, {"transcription": "Tim Phuong So Duong nhu thát lai, theo anh biet, chi có Trác Than hít khí", "points": [[131, 633], [848, 628], [848, 658], [131, 663]], "difficult": false}, {"transcription": "oxy mói có the làm duoc chuyèn này. Dèm ay anh tǎng ca xuyen dem khòng vě", "points": [[103, 670], [847, 667], [847, 694], [103, 698]], "difficult": false}, {"transcription": "nhà, khong the chúrng minh Trác Thǎn khòng có mǎt ò hièn trròng. Anh dang", "points": [[103, 704], [848, 701], [848, 729], [103, 731]], "difficult": false}, {"transcription": "dinh lǎy dièn thoai ra goi cho nguròi anh em khǒn nan cùa minh,dǎn dò anh áy", "points": [[104, 738], [846, 736], [846, 763], [104, 765]], "difficult": false}, {"transcription": "thòi gian này nèn bót bót di, dùrng dě nguòi khác nhìn thay sièu nǎng luc cùa", "points": [[104, 773], [848, 770], [848, 797], [104, 800]], "difficult": false}, {"transcription": "minh, bōng nhin thay tin nhán do Trác Thǎn gii tói, làp túc dua cho các dǒng", "points": [[103, 805], [848, 804], [848, 834], [103, 835]], "difficult": false}, {"transcription": "nghiep khác xem.", "points": [[104, 845], [277, 845], [277, 872], [104, 872]], "difficult": false}, {"transcription": "\"Trong dong di vat cua Ly Dinh có thúr này khong?\" Phurong So Duong chi", "points": [[133, 879], [847, 875], [847, 905], [133, 909]], "difficult": false}, {"transcription": "dòi mát vòng tròn dǒng tàm quy quái trēn ánh.", "points": [[104, 915], [556, 913], [556, 940], [104, 942]], "difficult": false}, {"transcription": "Tran Chieu Huy voi vàng cúi dau kiem tra mot luot:\"Khòng có.\"", "points": [[132, 950], [755, 947], [755, 976], [132, 980]], "difficult": false}, {"transcription": "\"Tieu Trurong, càu di tra xem logo này o dau ra. Tran Tieu Hác, di theo toi.\"", "points": [[134, 990], [847, 984], [847, 1012], [134, 1017]], "difficult": false}, {"transcription": "Phuong So Duong dung day, dǎn theo Tran Chieu Huy di luc soát xe cia Ly", "points": [[103, 1024], [847, 1021], [847, 1048], [103, 1051]], "difficult": false}, {"transcription": "Dinh thèm lan nua. Theo nhur Trác Than nói,lúc ay anh quèn khòng virt tò giay", "points": [[104, 1057], [846, 1057], [846, 1084], [104, 1084]], "difficult": false}, {"transcription": "dó di， khòng biět roi ò dàu, có khi vǎn còn trèn xe.", "points": [[107, 1094], [584, 1094], [584, 1118], [107, 1118]], "difficult": false}, {"transcription": "Hai nguòi doi náng gǎt luc lqi trong chiěc xe dā bi phoi thành lò nuróng", "points": [[133, 1128], [845, 1128], [845, 1158], [133, 1158]], "difficult": false}, {"transcription": "chua tói mòt phút mà quǎn áo dā uót dǎm mǒ hòi.", "points": [[105, 1167], [588, 1164], [588, 1190], [105, 1193]], "difficult": false}, {"transcription": "\"Doi phó, anh ra chǒ bóng ràm mà dúng, dě em tim cho.\"Trǎn Chieu Huy", "points": [[134, 1199], [848, 1200], [848, 1231], [134, 1230]], "difficult": false}, {"transcription": "day Phuong So Duong, còn minh thì trèo vào trong xe tim ky lai mot lurot.", "points": [[104, 1235], [811, 1233], [811, 1263], [104, 1266]], "difficult": false}, {"transcription": "Phurong So Durong mò cira ghe lái, khói dōng dieu hòa trong xe, gió lanh", "points": [[135, 1272], [845, 1272], [845, 1299], [135, 1299]], "difficult": false}, {"transcription": "thoi ra làp túc làm giàm bót hoi nóng khiěn nguòi ta ngòt ngat.", "points": [[107, 1307], [706, 1307], [706, 1334], [107, 1334]], "difficult": false}, {"transcription": "49", "points": [[459, 1363], [492, 1363], [492, 1389], [459, 1389]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page48.jpg	[{"transcription": "ve gī tam thòn", "points": [[449, 36], [578, 33], [578, 58], [449, 61]], "difficult": false}, {"transcription": "\"Hi hi, doi phó thong minh that.\"Trǎn Chieu Huy lau mǒ hoi,ninh not mát", "points": [[203, 83], [872, 79], [872, 109], [203, 113]], "difficult": false}, {"transcription": "cách crc ky guong gao. Phuong So Duong chua kip máng, càu ta da bát cho", "points": [[176, 119], [872, 115], [872, 145], [176, 150]], "difficult": false}, {"transcription": "hòlèn,\"Tim thayröi!\"", "points": [[175, 156], [373, 152], [373, 180], [175, 183]], "difficult": false}, {"transcription": "Giüa khe ghě vói cùra xe có nhét mot tò thuc don do ǎn còn chura kip vúnt,", "points": [[203, 193], [870, 189], [870, 217], [203, 221]], "difficult": false}, {"transcription": "tròng giong het tò Tong Giám dǒc Cao nhan duoc. Dǒng chí Tieu Trǎn den trùi", "points": [[176, 229], [872, 223], [872, 253], [176, 259]], "difficult": false}, {"transcription": "trüi can thàn bò vàt chúng vào túi ni-lòng trong suǒt,dóng chǎt lai. Ngoi hong", "points": [[176, 263], [871, 260], [871, 290], [176, 293]], "difficult": false}, {"transcription": "truóc diěu hòa mòt lát, chò dau óc dang chóng mǎt vì nóng cúa minh tinh táo", "points": [[177, 300], [871, 295], [871, 322], [177, 327]], "difficult": false}, {"transcription": "hon, càu ta mói nói:\"Dòi phó, anh nghī lièu có phài vì dánh giá tháp cho don", "points": [[177, 335], [869, 331], [869, 358], [177, 362]], "difficult": false}, {"transcription": "hàng nèn Ly Dinh mói bi shipper trà thù khòng?\"", "points": [[177, 371], [603, 367], [603, 394], [177, 398]], "difficult": false}, {"transcription": "\"Vay òng chù cùa Bàn do Tièu Dièm cūng dánh giá thap cho don hàng à?", "points": [[206, 406], [867, 404], [867, 431], [206, 433]], "difficult": false}, {"transcription": "Cau ta sě goi loai thit thái sqi xào chi có giá nǎm dǒng mot suat này ur? Dau óc", "points": [[178, 440], [869, 435], [869, 465], [178, 470]], "difficult": false}, {"transcription": "cau dung toàn dau cǒng ha?\" Phurong So Duong dàp mot cái vào sau gáy dong", "points": [[177, 472], [867, 471], [867, 505], [177, 506]], "difficult": false}, {"transcription": "chí Tieu Tran.", "points": [[179, 509], [305, 509], [305, 537], [179, 537]], "difficult": false}, {"transcription": "\"Lan truóc anh nói dau em chúra toàn than.\"Trǎn Tieu Hác xoa gáy, thành", "points": [[206, 546], [864, 545], [864, 573], [206, 574]], "difficult": false}, {"transcription": "thát nói.", "points": [[178, 581], [258, 581], [258, 610], [178, 610]], "difficult": false}, {"transcription": "\"Cút,cút, cút!\" Phuong So Duong day cái dau cuc than ra,thuàn tay an", "points": [[206, 617], [865, 616], [865, 647], [206, 648]], "difficult": false}, {"transcription": "nhàn cuòc goi.", "points": [[181, 655], [311, 655], [311, 683], [181, 683]], "difficult": false}, {"transcription": "\"Dòi phó,dǒn Canh sát khu Dòngbát dugc ba nguòi giá làm nguròi thàn cúa", "points": [[209, 689], [866, 689], [866, 718], [209, 718]], "difficult": false}, {"transcription": "Ly Dinh gay su truóc cira cong ty Ban do Tiéu Diem.\"", "points": [[182, 726], [635, 720], [635, 750], [182, 755]], "difficult": false}, {"transcription": "Dán gay su chuyèn nghiep à...", "points": [[209, 763], [466, 763], [466, 790], [209, 790]], "difficult": false}, {"transcription": "Phuong So Duong sam mǎt, may tèn chuyèn gay su này rǎt quen than vói", "points": [[207, 799], [864, 797], [864, 827], [207, 829]], "difficult": false}, {"transcription": "nhóm còn do trong mǎy thòn bi giài tòa, mà Vuong Cánh Hàng lai chính là tén", "points": [[181, 835], [865, 833], [865, 860], [181, 862]], "difficult": false}, {"transcription": "con do khét tieng ò Thái Trang:\"Cho nguòi theo dōi sát sao thàng nhai Vurong", "points": [[181, 865], [866, 868], [866, 899], [181, 896]], "difficult": false}, {"transcription": "Cánh Hang, kiem tra dien thoai cua ga xem. Còn nura, goi vg cua Vuong Cuòng", "points": [[182, 900], [866, 903], [866, 933], [182, 930]], "difficult": false}, {"transcription": "tói mot chuyěn, tòi có chuyen muǒn hòi bà ta.\"", "points": [[184, 938], [576, 935], [576, 962], [184, 965]], "difficult": false}, {"transcription": "50", "points": [[500, 1369], [530, 1369], [530, 1395], [500, 1395]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page49.jpg	[{"transcription": "Chuong 8", "points": [[414, 98], [540, 98], [540, 126], [414, 126]], "difficult": false}, {"transcription": "Saotren troi (8)", "points": [[316, 143], [635, 143], [635, 184], [316, 184]], "difficult": false}, {"transcription": "Trác Thǎn vǒn dinh hòi Vuong Cánh Hàng o benh vien nào de minh tói", "points": [[130, 264], [851, 263], [851, 290], [130, 291]], "difficult": false}, {"transcription": "\"quan tàm thǎm hòi\", nhung khong hieu Tong Giám dǒc Cao mác chúng gì mà", "points": [[105, 301], [851, 298], [851, 325], [105, 328]], "difficult": false}, {"transcription": "Khòng chju nói vói anh. Càu chù Cao lòi anh di ǎn com trua trong tòa nhà Tai", "points": [[101, 335], [851, 332], [851, 359], [101, 362]], "difficult": false}, {"transcription": "Phú ròi rè rà kéo dài tói tàn chieu muon, sau khi hop nhanh xong mói vui vè", "points": [[100, 368], [851, 367], [851, 394], [100, 395]], "difficult": false}, {"transcription": "dúng dày tò y sē dua anh tói dó.", "points": [[101, 406], [414, 404], [414, 428], [101, 431]], "difficult": false}, {"transcription": "\"Khòng cǎn dàu, càu bàn lám co mà?\" Trác Than nhin doi cánh nhò trén", "points": [[129, 438], [852, 436], [852, 466], [129, 468]], "difficult": false}, {"transcription": "chiec sièu xe cùa Tong Giám dǒc Cao, tiěn xǎng mot chuyěn thoi cūng ngang", "points": [[99, 473], [853, 475], [853, 505], [99, 503]], "difficult": false}, {"transcription": "vói thu nhàp mot ngày cúa giáo vién mǎm non ròi.", "points": [[100, 511], [589, 509], [589, 537], [100, 539]], "difficult": false}, {"transcription": "\"Chieu thú Sáu vǒn tan làm sóm mà, ò bén canh anh tòi tháy an toàn hon.\"", "points": [[129, 547], [850, 545], [850, 573], [129, 575]], "difficult": false}, {"transcription": "Cao Vū Senh dua chia khóa xe cho Trác Than, làng lǎng ding sau lumg anh, cǒ", "points": [[100, 582], [853, 580], [853, 608], [100, 610]], "difficult": false}, {"transcription": "gáng thě hièn dáng vé'Tong Giám dǒc Cao rǎt sg hai',dáng tiěc là diěn xuat", "points": [[100, 618], [853, 612], [853, 642], [100, 648]], "difficult": false}, {"transcription": "quá tè. Dòi mát dep dē mang vè trong trèo chi có ò nguòi tré tuoi duòng nhu", "points": [[100, 654], [852, 649], [852, 679], [100, 684]], "difficult": false}, {"transcription": "dang chúa dung cá mong doi gì dó.", "points": [[101, 689], [445, 688], [445, 714], [101, 715]], "difficult": false}, {"transcription": "Chác là ào giác nhi? Làm gì có ai lai mong gǎp sát thù bao giò?", "points": [[128, 724], [731, 720], [731, 750], [128, 754]], "difficult": false}, {"transcription": "Trác Than khòng hieu duge suy nghī cúa kieu càu chù nhà giàu nhu thě,", "points": [[127, 762], [853, 757], [853, 787], [127, 792]], "difficult": false}, {"transcription": "dành di lèn kiem tra chiěc xe truóc mǎt cho hět trách nhiem, sau dó ngǒi vào", "points": [[97, 796], [854, 793], [854, 823], [97, 826]], "difficult": false}, {"transcription": "ghe lái. Tong Giám dǒc Cao ngǒi vào ghě sau theo thói quen, nhung dang", "points": [[99, 833], [853, 831], [853, 859], [99, 861]], "difficult": false}, {"transcription": "chuan bi xuat phát thì dòt ngòt hò dùrng rǒi chuyen lèn ngǒi ghě phu.", "points": [[99, 868], [766, 866], [766, 893], [99, 895]], "difficult": false}, {"transcription": "\"Tong Giám dǒc Cao, něu nhu nguòi muon giet cau là sát thú thrc sur thì", "points": [[129, 904], [853, 901], [853, 931], [129, 934]], "difficult": false}, {"transcription": "tòi dě nghi càu nèn ngǒi ò ghě sau.\" Trác Than khuyèn khách hàng trèn góc dò", "points": [[97, 939], [853, 938], [853, 968], [97, 969]], "difficult": false}, {"transcription": "chuyēn nghiép. Binh thuòng ong chù děu ngǒi phia sau lái xe, cūng là vi trí an", "points": [[99, 976], [852, 974], [852, 1001], [99, 1003]], "difficult": false}, {"transcription": "toàn nhat trong xe. Khi xay ra sur cǒ giao thòng, thuròng thì lái xe sē dánh tay", "points": [[98, 1010], [851, 1009], [851, 1036], [98, 1037]], "difficult": false}, {"transcription": "lái vě bèn trái theo phàn xa de tránh cho minh bi dàm trúng, cǔng có the khien", "points": [[97, 1043], [852, 1042], [852, 1072], [97, 1073]], "difficult": false}, {"transcription": "nguòi ngǒi sau ghě lái may mán thoát nan.", "points": [[98, 1082], [512, 1078], [512, 1106], [98, 1110]], "difficult": false}, {"transcription": "\"Toi ngǒi sau thì anh có biet duòng khòng?\" Cao Vū Senh cài dày an toàn", "points": [[128, 1117], [852, 1114], [852, 1144], [128, 1147]], "difficult": false}, {"transcription": "xong, quay sang hói anh.", "points": [[97, 1156], [341, 1152], [341, 1179], [97, 1183]], "difficult": false}, {"transcription": "\"ò..\" Là mot nguòi khòng có xe, pham vi hoat dòng trong thành pho rong", "points": [[126, 1187], [852, 1188], [852, 1219], [126, 1218]], "difficult": false}, {"transcription": "lón này cúa Trác Thǎn rǎt nhò. Hau hět thòi gian anh chi di loanh quanh khu", "points": [[98, 1225], [849, 1225], [849, 1252], [98, 1252]], "difficult": false}, {"transcription": "pho cǒ và khu trung tám, thinh thoáng có lái xe cǔng chi tói dia diēm mà khách", "points": [[97, 1260], [849, 1259], [849, 1285], [97, 1286]], "difficult": false}, {"transcription": "hàng chi dinh,\"Có chi dǎn duòng mà.\"", "points": [[96, 1293], [478, 1292], [478, 1320], [96, 1321]], "difficult": false}, {"transcription": "51", "points": [[456, 1359], [488, 1359], [488, 1385], [456, 1385]], "difficult": false}]
vesitamthoi/dataset_vesitamthoi_Page50.jpg	[{"transcription": "ve sī tam thāi", "points": [[459, 40], [594, 38], [594, 63], [459, 65]], "difficult": false}, {"transcription": "\"Ben dó duròng ngán lǎm, rē bày tám lan lièn tuc thì phan měm khòng chi", "points": [[193, 84], [902, 81], [902, 115], [193, 118]], "difficult": false}, {"transcription": "kip dàu.\"Cao Vū Senh cup mi xuǒng che giǎu camxúc noi dáy mát,\"Di thoi.\"", "points": [[163, 122], [901, 112], [901, 146], [163, 156]], "difficult": false}, {"transcription": "Bj òng chù xem thuòng nǎng lue tim duòng, vé sī Trác bam sinh khòng giói", "points": [[191, 158], [900, 156], [900, 186], [191, 188]], "difficult": false}, {"transcription": "nhó duòng chàng phán bác durgc, dành nhǎn ga lái xe khói bai dǒ.", "points": [[164, 195], [779, 190], [779, 217], [164, 222]], "difficult": false}, {"transcription": "\"Cao Vū Sènh, do phu bac! Khong dugc chět tùr tě! Toi và anh cùng xuóng", "points": [[193, 227], [902, 230], [902, 261], [193, 258]], "difficult": false}, {"transcription": "dia nguc di!\" Vùra ra khoi bai dǒ,àm thanh quái quy quen thuoc lai xuyén qua", "points": [[165, 264], [903, 264], [903, 297], [165, 297]], "difficult": false}, {"transcription": "cá lóp kinh chǒng dan cúa chiěc sieu xe.", "points": [[166, 303], [536, 303], [536, 330], [166, 330]], "difficult": false}, {"transcription": "\"Chàc, cǒ chap ghe nhi.\"Trác Than liěc nhìn nguòi phu nǔ vǎn dang khua", "points": [[195, 338], [901, 339], [901, 369], [195, 368]], "difficult": false}, {"transcription": "chàn múa tay bèn ngoài, khòng nhin durgc dùng cùi chò huych nhe vào anh ban", "points": [[165, 373], [901, 374], [901, 404], [165, 403]], "difficult": false}, {"transcription": "Tieu Cao bèn canh,\"Cau và chi ta là sao the?\"", "points": [[165, 410], [590, 408], [590, 434], [165, 436]], "difficult": false}, {"transcription": "Cao Vū Senh nhin tay áo so mi bi anh huych lōm xuǒng cùa minh:\"Các anh", "points": [[193, 447], [900, 448], [900, 475], [193, 474]], "difficult": false}, {"transcription": "khòng có cách xung hò cung kính yói khách hàng à?\"", "points": [[166, 482], [658, 483], [658, 510], [166, 509]], "difficult": false}, {"transcription": "\"Có chú, chúng tòi goi khách hàng làbào bǒi.\" Trác Thǎn nói vói vé mǎt", "points": [[193, 516], [902, 520], [902, 551], [193, 547]], "difficult": false}, {"transcription": "nghiem túc.", "points": [[165, 557], [283, 554], [284, 585], [166, 588]], "difficult": false}, {"transcription": "..\" Long mày Cao Vū Senh khě giat giàt.", "points": [[206, 593], [584, 593], [584, 623], [206, 623]], "difficult": false}, {"transcription": "\"Thàt dǎy,bào vè nhu báu vàt, vò cùng giá tri, khòng phài'bào boi' thì là", "points": [[197, 628], [900, 631], [900, 661], [197, 658]], "difficult": false}, {"transcription": "gi?\"Trác Thǎn cǒ gáng nhin cròi, liěe trom bieu cam cua Tong Giám dǒc Cao.", "points": [[166, 663], [899, 663], [899, 696], [166, 696]], "difficult": false}, {"transcription": "Ten nhóc con lai còn dòi xung hò cung kính nüra, xem nhieu phim Hàn Quǒc", "points": [[168, 700], [899, 702], [899, 728], [168, 727]], "difficult": false}, {"transcription": "quáà?", "points": [[162, 736], [236, 730], [239, 763], [165, 770]], "difficult": false}, {"transcription": "\"Anh cūng goi Ly Dinh nhu vày sao?\" Duòng nhu Tong Giám dǒc Cao bi", "points": [[197, 772], [900, 772], [900, 802], [197, 802]], "difficult": false}, {"transcription": "choc túc děn bàt cuòi.", "points": [[168, 808], [374, 806], [374, 834], [168, 836]], "difficult": false}, {"transcription": "\"Goi con gái nhur the sě dě dǎn tói hieu lam, chi goi khách hàng nam nhu", "points": [[197, 842], [900, 847], [900, 877], [197, 872]], "difficult": false}, {"transcription": "vày thòi.\" Trác Thǎn nháy mát vói hǎn,\"Càu muǒn xung hò cung kính cūng", "points": [[167, 875], [901, 881], [901, 915], [167, 909]], "difficult": false}, {"transcription": "hoàn toàn khóng thành vǎn dě, bào bǒi a!\"", "points": [[168, 914], [559, 913], [559, 943], [168, 944]], "difficult": false}, {"transcription": "Anh goi vày khiěn Cao Vū Sènh nǒi cà da gà, dua tay vuǒt phàng chǒ áo so", "points": [[197, 949], [902, 952], [902, 986], [197, 982]], "difficult": false}, {"transcription": "mi bi lōm. Dě ngǎn ngùa anh tiěp tuc nói linh tinh, hán chù dòng nói vě nguròi", "points": [[168, 986], [901, 990], [901, 1019], [168, 1016]], "difficult": false}, {"transcription": "dúrng truóc cùra kia:\"Truóc dày chi ta là nhàn vièn cùa Tieu Diem.\"", "points": [[169, 1020], [790, 1022], [790, 1052], [169, 1050]], "difficult": false}, {"transcription": "\"Ha?\" The mà lai quen that, Trác Than bat giác venh tai lèn láng nghe,", "points": [[197, 1055], [898, 1062], [898, 1092], [197, 1085]], "difficult": false}, {"transcription": "\"Chàng lē cáu vút bò nguòi ta thàt à?\"", "points": [[169, 1090], [524, 1093], [524, 1123], [169, 1120]], "difficult": false}, {"transcription": "\"Tù khi chi ta vào làm viéc dēn khi ròi khòi còng ty, tòi nói vói chi ta khòng", "points": [[201, 1128], [901, 1134], [901, 1164], [201, 1158]], "difficult": false}, {"transcription": "quá muòi cáu.\" Chuyen này khiěn Cao Vū Senh buǒn buc rat làu rǒi, hán thuc", "points": [[170, 1165], [900, 1166], [900, 1197], [170, 1196]], "difficult": false}, {"transcription": "sur khòng biět bàn thàn minh\"quyěn rǔ\"bà chi kia bao giò nūa.", "points": [[170, 1198], [756, 1202], [756, 1232], [170, 1228]], "difficult": false}, {"transcription": "Bà chi dó tèn Vien Tieu Ai, làm viec o Tièu Diem vào ba nǎm truróc, lúc cong", "points": [[200, 1234], [900, 1241], [900, 1269], [200, 1261]], "difficult": false}, {"transcription": "ty mói dugc sáng làp. Vi là nhàn vièn có kinh nghiém nén khi mói vào còng ty,", "points": [[173, 1268], [896, 1274], [896, 1303], [173, 1298]], "difficult": false}, {"transcription": "nhin chi ta có vé rǎt chín chán. Làm viec ò còng ty hon mot nǎm, ròi vào mōt", "points": [[172, 1300], [900, 1306], [900, 1339], [172, 1333]], "difficult": false}, {"transcription": "62", "points": [[510, 1384], [545, 1384], [545, 1403], [510, 1403]], "difficult": false}]
